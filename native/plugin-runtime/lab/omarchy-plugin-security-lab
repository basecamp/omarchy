#!/bin/bash

set -euo pipefail

usage() {
  echo "Usage: $0 prepare BUILD_DIR STAGE_PARENT"
  echo "       $0 verify LAB_ROOT"
  echo "       $0 launch LAB_ROOT PLUGIN_ROOT TREE_SHA256 GRANT_STORE PRIVATE_STATE AUDIT_STORE"
  echo "       $0 cleanup-command LAB_ROOT"
}

require_absolute() {
  [[ $1 == /* && $1 != *'/../'* && $1 != */.. ]] || {
    echo "Path must be absolute and normalized: $1" >&2
    exit 64
  }
}

write_artifact_manifest() {
  local root=$1 output=$2 relative mode digest
  : >"$output"
  while IFS= read -r -d '' relative; do
    if [[ $relative == "ARTIFACTS.sha256" ]]; then
      continue
    fi
    [[ $relative != *$'\n'* && $relative != *$'\t'* ]] || {
      echo "Installed artifact path cannot contain a tab or newline" >&2
      exit 65
    }
    mode=$(stat -c '%a' "$root/$relative")
    digest=$(sha256sum "$root/$relative" | cut -d' ' -f1)
    printf '%s\t%s\t%s\n' "$mode" "$digest" "$relative" >>"$output"
  done < <(find "$root" -type f -printf '%P\0' | sort -z)
}

prepare() {
  local build_dir=$1 stage_parent=$2 worker worker_digest bundle_digest stage host pending installed_worker
  require_absolute "$build_dir"
  require_absolute "$stage_parent"
  worker="$build_dir/worker/omarchy-plugin-qml-worker"
  host="$build_dir/host/omarchy-plugin-host"
  [[ -x $worker && -x $host ]] || {
    echo "Build omarchy-plugin-host and omarchy-plugin-qml-worker first" >&2
    exit 66
  }
  mkdir -p "$stage_parent"
  pending=$(mktemp -d "$stage_parent/.pending.XXXXXXXX")
  trap 'rm -rf -- "$pending"' RETURN
  DESTDIR="$pending" cmake --install "$build_dir" --prefix /usr >&2
  installed_worker="$pending/usr/lib/omarchy/plugin-runtime/omarchy-plugin-qml-worker"
  worker_digest=$(sha256sum "$installed_worker" | cut -d' ' -f1)
  chmod -R go-w "$pending"
  chmod 0755 "$pending"
  {
    echo "schema=omarchy-plugin-security-lab-v2"
    echo "source_commit=$(git rev-parse HEAD)"
    echo "source_dirty=$(git status --porcelain | sha256sum | cut -d' ' -f1)"
    echo "worker_sha256=$worker_digest"
    echo "host_sha256=$(sha256sum "$pending/usr/bin/omarchy-plugin-host" | cut -d' ' -f1)"
    echo "cmake_cache_sha256=$(sha256sum "$build_dir/CMakeCache.txt" | cut -d' ' -f1)"
    echo "host_omarchy=$(pacman -Q omarchy 2>/dev/null || echo unavailable)"
  } >"$pending/PROVENANCE"
  chmod 0644 "$pending/PROVENANCE"
  write_artifact_manifest "$pending" "$pending/ARTIFACTS.sha256"
  chmod 0644 "$pending/ARTIFACTS.sha256"
  bundle_digest=$(sha256sum "$pending/ARTIFACTS.sha256" | cut -d' ' -f1)
  stage="$stage_parent/$bundle_digest"
  [[ ! -e $stage ]] || {
    echo "Refusing to replace existing stage: $stage" >&2
    exit 73
  }
  mv "$pending" "$stage"
  trap - RETURN
  echo "$stage"
}

verify() {
  local root=$1 bundle_digest worker host recorded_worker recorded_host actual_manifest
  require_absolute "$root"
  bundle_digest=$(basename "$root")
  [[ $bundle_digest =~ ^[0-9a-f]{64}$ ]] || {
    echo "Lab root is not named by a SHA-256 digest" >&2
    exit 65
  }
  worker="$root/usr/lib/omarchy/plugin-runtime/omarchy-plugin-qml-worker"
  host="$root/usr/bin/omarchy-plugin-host"
  [[ -x $worker && -x $host && -f $root/PROVENANCE && -f $root/ARTIFACTS.sha256 ]] || {
    echo "Lab root is incomplete" >&2
    exit 66
  }
  [[ $(sed -n 's/^schema=//p' "$root/PROVENANCE") == "omarchy-plugin-security-lab-v2" ]] || {
    echo "Unsupported lab provenance schema" >&2
    exit 65
  }
  recorded_worker=$(sed -n 's/^worker_sha256=//p' "$root/PROVENANCE")
  recorded_host=$(sed -n 's/^host_sha256=//p' "$root/PROVENANCE")
  [[ $(sha256sum "$root/ARTIFACTS.sha256" | cut -d' ' -f1) == "$bundle_digest" ]] || {
    echo "Lab bundle identity mismatch" >&2
    exit 65
  }
  actual_manifest=$(mktemp)
  trap 'rm -f -- "$actual_manifest"' RETURN
  write_artifact_manifest "$root" "$actual_manifest"
  cmp -s "$root/ARTIFACTS.sha256" "$actual_manifest" || {
    echo "Lab artifact integrity mismatch" >&2
    exit 65
  }
  [[ $recorded_worker =~ ^[0-9a-f]{64}$ &&
     $(sha256sum "$worker" | cut -d' ' -f1) == "$recorded_worker" &&
     $recorded_host =~ ^[0-9a-f]{64}$ &&
     $(sha256sum "$host" | cut -d' ' -f1) == "$recorded_host" ]] || {
    echo "Lab executable provenance mismatch" >&2
    exit 65
  }
  find "$root" -type l -print -quit | grep -q . && {
    echo "Lab root contains symbolic links" >&2
    exit 65
  }
  find "$root" ! -type d ! -type f -print -quit | grep -q . && {
    echo "Lab root contains unsupported filesystem objects" >&2
    exit 65
  }
  find "$root" -perm /022 -print -quit | grep -q . && {
    echo "Lab root contains group- or world-writable entries" >&2
    exit 65
  }
  echo "verified $root"
}

launch() {
  local root=$1 plugin=$2 tree=$3 grants=$4 state=$5 audit=$6 bundle_digest worker_digest host worker
  verify "$root" >/dev/null
  [[ $root == /opt/omarchy-plugin-security-lab/* ]] || {
    echo "Launch requires a separately reviewed root-owned /opt stage" >&2
    exit 77
  }
  bundle_digest=$(basename "$root")
  worker_digest=$(sed -n 's/^worker_sha256=//p' "$root/PROVENANCE")
  host="$root/usr/bin/omarchy-plugin-host"
  worker="$root/usr/lib/omarchy/plugin-runtime/omarchy-plugin-qml-worker"
  exec env OMARCHY_PLUGIN_SCHEMA_V2_ENABLED=1 \
    OMARCHY_PLUGIN_LIVE_LAB_ENABLED=I_ACCEPT_LAB_RISK \
    "$host" --preview-plugin-live-lab "$plugin" "$tree" "$grants" \
    "$state" "$audit" "$worker" "$worker_digest" "$bundle_digest"
}

cleanup_command() {
  local root=$1 digest
  require_absolute "$root"
  digest=$(basename "$root")
  [[ $(dirname "$root") == "/opt/omarchy-plugin-security-lab" &&
     $digest =~ ^[0-9a-f]{64}$ ]] || {
    echo "Refusing cleanup outside one digest-named lab root" >&2
    exit 64
  }
  printf 'sudo rm -r -- %q\n' "$root"
}

case ${1:-} in
  prepare) (($# == 3)) || { usage; exit 64; }; prepare "$2" "$3" ;;
  verify) (($# == 2)) || { usage; exit 64; }; verify "$2" ;;
  launch) (($# == 7)) || { usage; exit 64; }; launch "$2" "$3" "$4" "$5" "$6" "$7" ;;
  cleanup-command) (($# == 2)) || { usage; exit 64; }; cleanup_command "$2" ;;
  *) usage; exit 64 ;;
esac
