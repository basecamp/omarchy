{
  "schemaVersion": 2,
  "id": "org.omarchy.fixture.lab-authorized",
  "name": "Live Broker Authorized Proof",
  "version": "2.0.0",
  "runtime": {
    "apiVersion": 1,
    "qml": "ui/Authorized.qml"
  },
  "surfaces": {
    "proof": {
      "role": "panel",
      "maximumWidth": 520,
      "maximumHeight": 260,
      "maximumFramesPerSecond": 15,
      "keyboardFocus": false,
      "lockScreenVisible": false,
      "inputRegions": "none"
    }
  },
  "permissions": {
    "required": [
      {
        "capability": "storage.private",
        "quotaBytes": 65536,
        "reason": "Write and read an isolated proof value"
      }
    ],
    "optional": []
  }
}
