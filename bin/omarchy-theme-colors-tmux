#!/bin/bash

# omarchy:summary=Serialize a theme's colors-tmux.toml into a data-only tmux-theme.conf
# omarchy:args=--file <colors-tmux.toml> --out <tmux-theme.conf>
# omarchy:hidden=true

set -euo pipefail

usage() {
  echo "Usage: omarchy-theme-colors-tmux --file <colors-tmux.toml> --out <tmux-theme.conf>"
}

INPUT=""
OUTPUT=""

while (( $# > 0 )); do
  case "$1" in
    --file)
      [[ -n ${2:-} ]] || { usage >&2; exit 1; }
      INPUT="$2"
      shift 2
      ;;
    --out)
      [[ -n ${2:-} ]] || { usage >&2; exit 1; }
      OUTPUT="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z $INPUT || -z $OUTPUT || -n ${1:-} ]]; then
  usage >&2
  exit 1
fi

if [[ ! -f $INPUT ]]; then
  echo "omarchy-theme-colors-tmux: no such file: $INPUT" >&2
  exit 1
fi

if ! omarchy-cmd-present python3; then
  echo "omarchy-theme-colors-tmux: python3 is required to read colors-tmux.toml" >&2
  exit 1
fi

python3 - "$INPUT" "$OUTPUT" <<'PY'
import os
import re
import sys
import tempfile

try:
    import tomllib
except ModuleNotFoundError:
    print("omarchy-theme-colors-tmux: python3 is too old for tomllib (3.11+ needed)", file=sys.stderr)
    sys.exit(1)

from datetime import date as _date
from datetime import datetime as _datetime
from datetime import time as _time

HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")


def fail(message):
    print(f"omarchy-theme-colors-tmux: {message}", file=sys.stderr)
    sys.exit(1)


def hex_to_tmux(hex_color):
    """Return the hex color for use in tmux styles and format strings."""
    return hex_color


def check_value(value):
    if isinstance(value, bool) or isinstance(value, str) or isinstance(value, int) or isinstance(value, float):
        return
    if isinstance(value, (_date, _time, _datetime)):
        fail("colors-tmux.toml values may not be dates or times")
    if isinstance(value, list):
        for item in value:
            check_value(item)
        return
    if isinstance(value, dict):
        for item in value.values():
            check_value(item)
        return
    fail("colors-tmux.toml values may only be strings, numbers, booleans, arrays, and tables")


input_path, output_path = sys.argv[1], sys.argv[2]

try:
    with open(input_path, "rb") as handle:
        data = tomllib.load(handle)
except tomllib.TOMLDecodeError as error:
    fail(f"invalid TOML in {os.path.basename(input_path)}: {error}")
except UnicodeDecodeError:
    fail(f"{os.path.basename(input_path)} is not valid UTF-8")

for key in data:
    if key not in ("schema", "theme"):
        fail(f"colors-tmux.toml does not support the top-level key '{key}'")

schema = data.get("schema", 1)
if not isinstance(schema, int) or isinstance(schema, bool) or schema != 1:
    fail(f"unsupported schema version: {schema!r}")

theme = data.get("theme")
if not isinstance(theme, dict) or not theme:
    fail("colors-tmux.toml defines no [theme] entries")

for key, value in theme.items():
    if not isinstance(value, str):
        fail(f"[theme] value for '{key}' must be a string")
    if not HEX_COLOR.match(value):
        fail(f"[theme] value for '{key}' is not a valid hex color: {value!r}")

check_value(theme)

t = {k: hex_to_tmux(v) for k, v in theme.items()}

lines = [
    "# Tmux theme generated by Omarchy from this theme's colors-tmux.toml.",
    "# Everything below is data serialized from that TOML; edit the theme's TOML,",
    "# not this file.",
    "",
    'set -g status-style "bg=default,fg=default"',
    f'set -g status-left "#[fg={t["status_bg"]},bg={t["session_bg"]},bold] #S #[bg=default] "',
    f'set -g status-right "#[fg={t["session_bg"]}]#{{?pane_in_mode,COPY ,}}#{{?client_prefix,PREFIX ,}}#{{?window_zoomed_flag,ZOOM ,}}#[fg={t["window_inactive_fg"]}]#h "',
    f'set -g window-status-format "#[fg={t["window_inactive_fg"]}] #I:#W "',
    f'set -g window-status-current-format "#[fg={t["window_active_fg"]},bold] #I:#W "',
    f'set -g pane-border-style "fg={t["pane_border"]}"',
    f'set -g pane-active-border-style "fg={t["pane_active_border"]}"',
    f'set -g message-style "bg=default,fg={t["message_fg"]}"',
    f'set -g message-command-style "bg=default,fg={t["message_fg"]}"',
    f'set -g mode-style "bg={t["mode_bg"]},fg={t["mode_fg"]}"',
    f'setw -g clock-mode-colour "{t["clock_color"]}"',
]

rendered = "\n".join(lines) + "\n"

directory = os.path.dirname(os.path.abspath(output_path))
try:
    handle = tempfile.NamedTemporaryFile(
        mode="w", dir=directory, prefix=".tmux-theme.conf.", delete=False
    )
except OSError as error:
    fail(f"cannot write next to {output_path}: {error}")

try:
    try:
        handle.write(rendered)
        handle.flush()
        os.fsync(handle.fileno())
    except OSError as error:
        handle.close()
        os.unlink(handle.name)
        fail(f"cannot write {output_path}: {error}")
    handle.close()
    os.chmod(handle.name, 0o644)
    os.replace(handle.name, output_path)
except OSError as error:
    if os.path.exists(handle.name):
        os.unlink(handle.name)
    fail(f"cannot replace {output_path}: {error}")
PY
