#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults.
# omarchy:args=[--inline] <path>

default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

if [[ $editor == "doom" ]]; then
  if ! omarchy-cmd-present doom && [[ -x $HOME/.config/emacs/bin/doom ]]; then
    export PATH="$HOME/.config/emacs/bin:$PATH"
  fi
  if ! omarchy-cmd-present emacs && ! omarchy-cmd-present doom; then
    editor="nvim"
  fi
else
  omarchy-cmd-present "$editor" || editor="nvim"
fi

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec omarchy-launch-tui "$editor" "$@"
  fi
  ;;
doom | emacs)
  if [[ $inline == "true" ]]; then
    exec emacs -nw "$@"
  else
    exec setsid uwsm-app -- emacsclient -c -a '' "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
