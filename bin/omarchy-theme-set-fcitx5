#!/bin/bash
# omarchy:summary=Apply current Omarchy theme colors to fcitx5
# omarchy:hidden=true

# This helper mirrors the behavior of the original omarchy-fcitx5-theme-match
# hook, but follows Omarchy's built-in theme-sync conventions:
#   - Uses omarchy-theme-color for canonical palette resolution and fallbacks
#   - Exits silently when fcitx5 is not installed or not running
#   - Honors the skip-fcitx5-theme-changes toggle
#   - Is invoked by omarchy-theme-set via post_theme_commands

# Respect per-app theme-sync opt-out, consistent with omarchy-theme-set-vscode.
! omarchy-toggle-enabled skip-fcitx5-theme-changes || exit 0

# fcitx5 not installed -> nothing to do
omarchy-cmd-present fcitx5 || exit 0

# Omarchy manages fcitx5 via a user service. If it is not active, skip so we
# do not start an input method unexpectedly.
systemctl --user is-active omarchy-fcitx5.service >/dev/null 2>&1 || exit 0

CURRENT_THEME_PATH="$HOME/.local/state/omarchy/current/theme"
COLORS_TOML="$CURRENT_THEME_PATH/colors.toml"

# No theme colors available -> skip
[[ -f $COLORS_TOML ]] || exit 0

theme_color() {
  omarchy-theme-color --file "$COLORS_TOML" "$@"
}

background=$(theme_color background)
foreground=$(theme_color foreground)
muted=$(theme_color muted foreground)
selection=$(theme_color selection muted)
mode=$(theme_color mode)

# We need at least a background and foreground to produce a usable theme.
[[ -n $background && -n $foreground ]] || exit 0

# Choose the stock fcitx5 image set that contrasts with the theme background.
if [[ $mode == "light" ]]; then
  image_src="/usr/share/fcitx5/themes/default"
else
  image_src="/usr/share/fcitx5/themes/default-dark"
fi

# Keep the original hook's theme directory name so existing fcitx5 state and
# user expectations remain consistent.
out="$HOME/.local/share/fcitx5/themes/omarchy-auto"
mkdir -p "$out"
rm -f "$out"/*.png
cp "$image_src"/*.png "$out/"

cat > "$out/theme.conf" <<EOF
[Metadata]
Name=Omarchy Auto
Version=1
Author=Omarchy
Description=fcitx5 theme generated from the current Omarchy theme
ScaleWithDPI=True

[InputPanel]
NormalColor=$foreground
HighlightCandidateColor=$foreground
HighlightColor=$foreground
HighlightBackgroundColor=$selection
PageButtonAlignment=Last Candidate

[InputPanel/TextMargin]
Left=5
Right=5
Top=5
Bottom=5

[InputPanel/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/Background]
Color=$background
BorderColor=$muted
BorderWidth=2

[InputPanel/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/Highlight]
Color=$selection

[InputPanel/Highlight/Margin]
Left=5
Right=5
Top=5
Bottom=5

[InputPanel/PrevPage]
Image=prev.png

[InputPanel/PrevPage/ClickMargin]
Left=5
Right=5
Top=4
Bottom=4

[InputPanel/NextPage]
Image=next.png

[InputPanel/NextPage/ClickMargin]
Left=5
Right=5
Top=4
Bottom=4

[Menu]
NormalColor=$foreground
HighlightCandidateColor=$foreground

[Menu/Background]
Color=$background
BorderColor=$muted
BorderWidth=2

[Menu/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/CheckBox]
Image=radio.png

[Menu/SubMenu]
Image=arrow.png

[Menu/Highlight]
Color=$selection

[Menu/Highlight/Margin]
Left=5
Right=5
Top=5
Bottom=5

[Menu/Separator]
Color=$muted

[Menu/CheckBox]
Image=radio.png

[Menu/SubMenu]
Image=arrow.png

[Menu/TextMargin]
Left=5
Right=5
Top=5
Bottom=5
EOF

mkdir -p "$HOME/.config/fcitx5/conf"

# The original hook wrote these as top-level keys, not inside a [ClassicUI]
# section. Match that exact format because fcitx5 loads it reliably.
cat > "$HOME/.config/fcitx5/conf/classicui.conf" <<EOF
# Generated by omarchy-theme-set-fcitx5
Theme=omarchy-auto
DarkTheme=omarchy-auto
EOF

# Restart fcitx5 if it is running under the user service, matching the
# original hook's restart behavior.
if systemctl --user is-active omarchy-fcitx5.service >/dev/null 2>&1; then
  systemctl --user restart omarchy-fcitx5.service
elif pgrep -x fcitx5 >/dev/null 2>&1; then
  # Fallback for manually-started fcitx5
  pkill -x fcitx5
fi
