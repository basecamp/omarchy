#!/bin/bash

# omarchy:summary=Detect the Framework Laptop 13 AMD Ryzen AI 300 Series.

sys_vendor="${OMARCHY_DMI_SYS_VENDOR:-/sys/class/dmi/id/sys_vendor}"
product_name="${OMARCHY_DMI_PRODUCT_NAME:-/sys/class/dmi/id/product_name}"

[[ $(cat "$sys_vendor" 2>/dev/null) == "Framework" ]] &&
  [[ $(cat "$product_name" 2>/dev/null) == "Laptop 13 (AMD Ryzen AI 300 Series)" ]]
