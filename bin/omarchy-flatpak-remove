#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking installed Flatpak apps to be removed.
# omarchy:requires-sudo=true

fzf_args=(
  --multi
  --preview 'flatpak info {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:red,marker:red'
)

app_ids=$(flatpak list --app --columns=application | fzf "${fzf_args[@]}")

if [[ -n $app_ids ]]; then
  # omarchy-flatpak-drop only needs sudo for apps in the system installation,
  # but the picker can hand it a mix, and asking mid-removal would interrupt a
  # run already underway.
  source omarchy-sudo-keepalive

  echo "$app_ids" | tr '\n' ' ' | xargs omarchy-flatpak-drop
  omarchy-show-done
fi
