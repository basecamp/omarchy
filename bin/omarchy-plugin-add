#!/bin/bash

# omarchy:summary=Add a shell plugin from the registry
# omarchy:group=plugin
# omarchy:args=[publisher/name[@version] | git-url --unsafe] [--enable] [--yes]
# omarchy:examples=omarchy plugin add acme/weather | omarchy plugin add acme/weather@1.2.0 | omarchy plugin add https://github.com/acme/omarchy-weather.git --unsafe
# omarchy:alias=omarchy plugin install

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
UNSAFE=0

fail() {
  echo "omarchy-plugin-add: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

registry_ref() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*(@[A-Za-z0-9.+-]+)?$ && $1 != *..* ]]
}

ENABLE_PLACEMENT=()

select_bar_widget_placement() {
  local id="$1"
  local section
  local default_section
  interactive || return 0
  (( ASSUME_YES )) && return 0

  jq -e '(.kinds // []) | (index("bar") | not) and (index("bar-widget") != null)' \
    "$PLUGINS_DIR/$id/manifest.json" >/dev/null 2>&1 || return 0

  default_section=$(jq -r '.barWidget.defaultSection // "center"' "$PLUGINS_DIR/$id/manifest.json")
  section=$(printf '%s\n' left center right |
    gum choose --header="Place $id in which bar section?" --selected "$default_section") || return 0
  [[ -n $section ]] || return 0
  ENABLE_PLACEMENT=(--section "$section")
}

plugin_id_manifest() {
  omarchy-plugin-catalog | jq -r --arg id "$1" '
    map(select(.id == $id))[0].manifestPath // empty
  '
}

source_arg=""
enable_after=""

while (( $# > 0 )); do
  case "$1" in
  --enable)
    enable_after=true
    shift
    ;;
  --unsafe)
    UNSAFE=1
    shift
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin add [publisher/name[@version] | git-url --unsafe] [--enable] [--yes]"
    exit 0
    ;;
  -*)
    fail "unknown add option: $1"
    ;;
  *)
    [[ -z $source_arg ]] || fail "unexpected argument: $1"
    source_arg="$1"
    shift
    ;;
  esac
done

if [[ -z $source_arg ]]; then
  interactive ||
    fail "a plugin is required (e.g. omarchy plugin add acme/weather)"
  source_arg=$(gum input --prompt "Plugin (publisher/name): ") || fail "cancelled"
  [[ -n $source_arg ]] || fail "a plugin is required"
fi

stage_install() {
  # $1 = staged plugin folder; validates, checks id collisions, moves into
  # place. Prints the installed id.
  local stage="$1"
  local id existing_manifest target

  if ! omarchy-plugin-validate "$stage" >&2; then
    rm -rf "$stage"
    fail "refusing to add: validation failed"
  fi

  id=$(jq -r '.id' "$stage/manifest.json")
  existing_manifest=$(plugin_id_manifest "$id") || {
    rm -rf "$stage"
    fail "could not inspect installed plugin ids"
  }
  if [[ -n $existing_manifest ]]; then
    rm -rf "$stage"
    fail "plugin id '$id' is already used by $existing_manifest"
  fi

  target="$PLUGINS_DIR/$id"
  if [[ -e $target || -L $target ]]; then
    rm -rf "$stage"
    fail "plugin '$id' is already installed; update it with: omarchy plugin update $id"
  fi

  mv "$stage" "$target"
  echo "$id"
}

mkdir -p "$PLUGINS_DIR"
stage="$PLUGINS_DIR/.add.tmp.$$"
rm -rf "$stage"

if registry_ref "$source_arg"; then
  ref="${source_arg%%@*}"
  want_version=""
  [[ $source_arg == *@* ]] && want_version="${source_arg##*@}"

  record=$(omarchy-plugin-registry resolve "$ref" ${want_version:+"$want_version"}) ||
    fail "could not resolve $source_arg"
  version=$(jq -r '.vers' <<<"$record")
  caps=$(jq -r '
    (.caps // {})
    | [to_entries[] | select((.value | type == "array" and length > 0) or .value == true) | .key]
    | if length == 0 then "none declared" else join(", ") end
  ' <<<"$record")
  license=$(jq -r '.license // "unknown"' <<<"$record")

  if (( ! ASSUME_YES )); then
    cat >&2 <<INFO

  Plugin:       $ref
  Version:      $version
  License:      $license
  Capabilities: $caps

  Plugins run inside your omarchy-shell process. This one passed the
  registry's automated review; it lands DISABLED until you enable it.

INFO
    confirm "Install $ref $version?" || fail "aborted"
  fi

  tarball="$PLUGINS_DIR/.add.dl.$$.tar.gz"
  rm -f "$tarball"
  record=$(omarchy-plugin-registry download "$ref" "$version" "$tarball") || {
    rm -f "$tarball"
    fail "download failed for $ref@$version"
  }

  mkdir -p "$stage"
  if ! tar -xzf "$tarball" -C "$stage" --no-same-owner; then
    rm -rf "$stage" "$tarball"
    fail "could not unpack $ref@$version"
  fi
  rm -f "$tarball"

  id=$(stage_install "$stage")

  jq -n --arg publisher "${ref%%/*}" --arg name "${ref##*/}" \
    --arg version "$version" --arg sha256 "$(jq -r '.sha256' <<<"$record")" \
    --arg registry "$(omarchy-plugin-registry base-url)" \
    --arg installed_at "$(date -u +%FT%TZ)" '
    {source: "registry", publisher: $publisher, name: $name, version: $version,
     sha256: $sha256, registry: $registry, installed_at: $installed_at}
  ' >"$PLUGINS_DIR/$id/.registry-receipt.json"

  echo "Added $id ($ref $version) into $PLUGINS_DIR/$id"
else
  (( UNSAFE )) ||
    fail "git URLs are the unreviewed escape hatch; pass --unsafe to accept the risk (registry installs: omarchy plugin add publisher/name)"

  if (( ! ASSUME_YES )); then
    cat >&2 <<WARN

⚠️  Plugins run as arbitrary, unsandboxed code inside your long-lived
  omarchy-shell process. This git install bypasses the plugin registry's
  review, signatures, checksums, and kill list entirely. Only add repos
  you trust, and review the code before you enable it.

      URL: $source_arg

WARN
    confirm "Clone and add this plugin?" || fail "aborted"
  fi

  if ! git clone -- "$source_arg" "$stage"; then
    rm -rf "$stage"
    fail "failed to clone $source_arg"
  fi

  id=$(stage_install "$stage")
  echo "Added $id into $PLUGINS_DIR/$id"
fi

omarchy-shell shell rescanPlugins >/dev/null

if [[ -z $enable_after ]]; then
  if (( ASSUME_YES )) || ! interactive; then
    enable_after=false
  elif confirm "Enable '$id' now?"; then
    enable_after=true
  else
    enable_after=false
  fi
fi

if [[ $enable_after == true ]]; then
  select_bar_widget_placement "$id"
  discovered=0
  for (( attempt = 0; attempt < 40; attempt++ )); do
    if omarchy-plugin-list --json | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null; then
      discovered=1
      break
    fi
    sleep 0.05
  done
  (( discovered )) || fail "plugin '$id' is not known"
  omarchy-plugin-enable "$id" "${ENABLE_PLACEMENT[@]}"
else
  echo "Enable it later with: omarchy plugin enable $id"
fi
