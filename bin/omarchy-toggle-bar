#!/bin/bash

# omarchy:summary=Toggle bar visibility without killing the Omarchy shell
# omarchy:args=[toggle|on|off]
# omarchy:examples=omarchy toggle bar | omarchy toggle bar off | omarchy toggle bar on

# The underlying flag is bar-off (flag present = bar hidden), so the public
# on/off arguments are inverted before being forwarded: `bar on` shows the
# bar by clearing the flag, `bar off` hides it by setting the flag.
ACTION="${1:-toggle}"

if [[ $ACTION == "on" ]]; then
  omarchy-toggle bar-off off
elif [[ $ACTION == "off" ]]; then
  omarchy-toggle bar-off on
else
  omarchy-toggle bar-off "$ACTION"
fi
