#!/bin/bash

# omarchy:summary=Collapse occupied workspaces down to the lowest numbers (3,4,7 -> 1,2,3).
# omarchy:args=[--dry-run]

# Hyprland can't renumber a workspace from the keyboard, so walk the occupied
# workspaces ascending and give each the lowest free number. Prefer
# hl.dsp.workspace.change_id (keeps monitor, windows and tiling layout); when
# the target id is already taken by an empty persistent workspace, or the Lua
# dispatcher is unavailable, fall back to moving the windows. Special
# workspaces (id < 1) and named workspaces are left alone; focus follows the
# active workspace to its new number.

dry_run=false
case ${1:-} in
  "") ;;
  -n|--dry-run) dry_run=true ;;
  -h|--help)
    echo "Usage: omarchy-hyprland-workspace-compact [--dry-run]"
    exit 0
    ;;
  *)
    echo "Usage: omarchy-hyprland-workspace-compact [--dry-run]" >&2
    exit 2
    ;;
esac
if (($# > 1)); then
  echo "Usage: omarchy-hyprland-workspace-compact [--dry-run]" >&2
  exit 2
fi

hypr_dispatch() {
  local lua="$1"
  shift

  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

active=$(hyprctl activeworkspace -j | jq -r '.id')
[[ $active =~ ^-?[0-9]+$ ]] || exit 1
clients=$(hyprctl clients -j)
workspaces=$(hyprctl workspaces -j)
new_active=$active

declare -A taken=() blocked=()
while IFS= read -r id; do
  [[ $id =~ ^[0-9]+$ ]] && taken[$id]=1
done < <(jq -r '.[] | select(.id > 0) | .id' <<<"$workspaces")
# Named workspaces keep a numeric id. Never land on those — change_id would
# fail (id taken, rc=0) and the window-move fallback would merge into them.
while IFS= read -r id; do
  [[ $id =~ ^[0-9]+$ ]] && blocked[$id]=1
done < <(jq -r '.[] | select(.id > 0 and ((.name // "") | test("^[0-9]+$") | not)) | .id' <<<"$workspaces")

move_windows() { # src dst
  while IFS= read -r addr; do
    [[ -n $addr && $addr != null ]] || continue
    hypr_dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$2\", follow = false })" \
      movetoworkspacesilent "$2,address:$addr"
  done < <(jq -r --argjson w "$1" '.[] | select(.workspace.id == $w) | .address' <<<"$clients")
}

renumber() { # src dst monitor
  if [[ -z ${taken[$2]+x} ]] &&
    hyprctl dispatch "hl.dsp.workspace.change_id({ workspace = \"$1\", id = $2 })" >/dev/null 2>&1; then
    unset "taken[$1]"
    taken[$2]=1
    return 0
  fi
  move_windows "$1" "$2"
  hypr_dispatch "hl.dsp.workspace.move({ workspace = \"$2\", monitor = \"$3\" })" moveworkspacetomonitor "$2" "$3"
  taken[$2]=1
}

target=1
while IFS=$'\t' read -r ws monitor; do
  [[ $ws =~ ^[0-9]+$ ]] || continue
  while [[ -n ${blocked[$target]+x} ]]; do
    target=$((target + 1))
  done
  if ((ws != target)); then
    if $dry_run; then
      echo "workspace $ws -> $target ($monitor)"
    else
      renumber "$ws" "$target" "$monitor"
    fi
    ((ws == active)) && new_active=$target
  fi
  target=$((target + 1))
done < <(jq -r '.[] | select(.id > 0 and .windows > 0 and ((.name // "") | test("^[0-9]+$"))) | "\(.id)\t\(.monitor)"' <<<"$workspaces" | sort -n)

if ! $dry_run && ((new_active != active)); then
  hypr_dispatch "hl.dsp.focus({ workspace = \"$new_active\" })" workspace "$new_active"
fi
