#!/usr/bin/python3

# omarchy:summary=Print the GitHub Copilot usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true

"""Collect GitHub Copilot premium-request usage into one display-ready JSON record.

Copilot has no local session files to read the way Claude Code and Codex do —
there is nothing to count prompts or tokens from — so this collector only ever
reports the account's metered quota, the same "AI credits" usage shown at
github.com/settings/billing/usage and github.com/settings/copilot/features.

The quota comes from api.github.com/copilot_internal/user, authenticated with
the OAuth token the official Copilot editor/CLI plugins already keep under
~/.config/github-copilot/. VS Code, JetBrains, Neovim, and the Copilot CLI
all delegate to the same copilot-language-server, so on a modern install they
share one token file regardless of which client signed in; older copilot.vim
installs used a differently-named file, which is why three names are tried.
This covers Business and Enterprise/EMU seats where the public billing API
400s a personal access token.

Set githubToken in ~/.config/omarchy/agents/copilot.json (or GITHUB_TOKEN in
the environment) to a fine-grained PAT with "Plan (read)" to read the public
billing API instead, for a personal account with no editor signed in; quota
in that same file (or COPILOT_QUOTA) turns its raw request count into a
percentage, since that API reports no entitlement to divide by. The agents
panel only ever reads the JSON this prints.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

AGENT_ID = "copilot"
AGENT_NAME = "Copilot"
AUTH_HELP = (
  "Sign in to Copilot from an editor (VS Code, JetBrains) or the Copilot CLI, "
  "or set githubToken in ~/.config/omarchy/agents/copilot.json to a "
  "fine-grained PAT with 'Plan (read)'."
)

GITHUB_API_BASE = "https://api.github.com"
COPILOT_INTERNAL_URL = f"{GITHUB_API_BASE}/copilot_internal/user"

# Local Copilot editor/CLI credentials, written by the official plugins.
COPILOT_CONFIG_DIR = Path(os.environ.get("GITHUB_COPILOT_CONFIG_DIR", "~/.config/github-copilot")).expanduser()
COPILOT_TOKEN_FILES = ("apps.json", "hosts.json", "oauth.json")

# Preference order when an account reports more than one metered quota.
QUOTA_SNAPSHOT_PRIORITY = ("premium_interactions", "premium_requests", "chat", "completions")

# Friendly names for the quota_snapshots keys GitHub's API uses internally.
QUOTA_DISPLAY_NAME = {
  "premium_interactions": "AI Credits",
  "premium_requests": "Premium Requests",
  "chat": "Chat",
  "completions": "Completions",
}


def config_path():
  config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
  return config_home / "omarchy" / "agents" / "copilot.json"


def read_config():
  try:
    parsed = json.loads(config_path().read_text())
    return parsed if isinstance(parsed, dict) else {}
  except (OSError, json.JSONDecodeError):
    return {}


def format_count(value):
  return f"{round(value):,}"


class CopilotError(Exception):
  pass


def base_record(**overrides):
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": False,
    "scope": "account",
    "hasPromptStats": False,
    "tierLabel": "",
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
    "limits": [],
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }
  record.update(overrides)
  return record


def normalize_reset_at(value):
  if value is None:
    return ""
  raw = str(value).strip()
  if raw == "":
    return ""
  try:
    if raw.isdigit():
      return datetime.fromtimestamp(int(raw), timezone.utc).isoformat()
    return datetime.fromisoformat(raw.replace("Z", "+00:00")).isoformat()
  except Exception:
    return raw


def local_oauth_token():
  """Read the token the official Copilot editor/CLI plugins store locally.

  apps.json, hosts.json, and oauth.json all map a host key (e.g.
  "github.com:Ov23li..." or plain "github.com") to an object holding
  ``oauth_token``. Any github.com entry works for copilot_internal/user.
  """
  for name in COPILOT_TOKEN_FILES:
    path = COPILOT_CONFIG_DIR / name
    if not path.exists():
      continue
    try:
      data = json.loads(path.read_text())
    except Exception:
      continue
    if not isinstance(data, dict):
      continue
    for key, entry in data.items():
      if not str(key).startswith("github.com"):
        continue
      token = entry.get("oauth_token") if isinstance(entry, dict) else None
      if token:
        return token
  return None


def api_get(url, headers):
  request = urllib.request.Request(url, headers=headers)
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      return json.loads(response.read().decode())
  except urllib.error.HTTPError as error:
    raise CopilotError(f"GitHub returned HTTP {error.code}") from error
  except urllib.error.URLError as error:
    raise CopilotError(f"Could not reach GitHub: {error.reason}") from error


def pick_quota_snapshot(snapshots):
  if not isinstance(snapshots, dict):
    return None

  def usable(snap):
    return isinstance(snap, dict) and snap.get("has_quota") and not snap.get("unlimited")

  for name in QUOTA_SNAPSHOT_PRIORITY:
    if usable(snapshots.get(name)):
      return name, snapshots[name]
  for name, snap in snapshots.items():
    if usable(snap):
      return name, snap
  return None


def quota_counts(snap):
  """Return (used, entitlement) for a quota snapshot, or None if it can't be counted.

  ``credits_used`` is the exact figure GitHub's own billing-usage page shows
  next to the entitlement, so it is preferred over deriving a count from
  ``remaining`` (which some snapshots round to a whole number).
  """
  entitlement = float(snap.get("entitlement") or 0)
  if entitlement <= 0:
    return None
  used = snap.get("credits_used")
  if used is None:
    remaining = snap.get("remaining")
    if remaining is None:
      remaining = snap.get("quota_remaining")
    if remaining is None:
      return None
    used = entitlement - float(remaining)
  return float(used), entitlement


def quota_percent(snap):
  counts = quota_counts(snap)
  if counts is not None:
    used, entitlement = counts
    return max(0.0, min(1.0, used / entitlement))
  percent_remaining = snap.get("percent_remaining")
  if percent_remaining is not None:
    return max(0.0, min(1.0, 1.0 - float(percent_remaining) / 100.0))
  return -1.0


def scan_internal(token):
  data = api_get(COPILOT_INTERNAL_URL, {
    "Authorization": f"token {token}",
    "Accept": "application/json",
    "Editor-Version": "vscode/1.99.0",
    "Editor-Plugin-Version": "copilot-chat/0.26.7",
    "User-Agent": "GitHubCopilotChat/0.26.7",
  })

  limits = []
  picked = pick_quota_snapshot(data.get("quota_snapshots"))
  if picked is not None:
    quota_id, snap = picked
    percent = quota_percent(snap)
    if percent >= 0:
      name = QUOTA_DISPLAY_NAME.get(quota_id, quota_id.replace("_", " ").title())
      counts = quota_counts(snap)
      title = f"{name} ({format_count(counts[0])} / {format_count(counts[1])})" if counts else name
      limits.append({
        "label": name + " (monthly)",
        "title": title,
        "percent": percent,
        "resetsAt": normalize_reset_at(data.get("quota_reset_date_utc") or data.get("quota_reset_date")),
      })

  plan = data.get("copilot_plan")
  return base_record(
    ready=True,
    tierLabel=str(plan).replace("_", " ").title() if plan else "",
    limits=limits,
    usageStatusText="" if limits else "This Copilot plan has no metered quota to report",
  )


def scan_billing_api(pat, quota):
  user = api_get(f"{GITHUB_API_BASE}/user", {
    "Authorization": f"Bearer {pat}",
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28",
  })
  username = user.get("login")
  if not username:
    raise CopilotError("Could not determine the GitHub username for this token")

  url = f"{GITHUB_API_BASE}/users/{username}/settings/billing/premium_request/usage"
  usage = api_get(url, {
    "Authorization": f"Bearer {pat}",
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28",
  })
  items = usage if isinstance(usage, list) else usage.get("usageItems", [])
  used = sum(float(item.get("grossQuantity") or 0) for item in items)

  limits = []
  if quota > 0:
    limits.append({
      "label": "Premium Requests (monthly)",
      "title": f"Premium Requests ({format_count(used)} / {format_count(quota)})",
      "percent": max(0.0, min(1.0, used / quota)),
      "resetsAt": "",
    })

  return base_record(
    ready=True,
    tierLabel="",
    limits=limits,
    usageStatusText="" if limits else (
      f"{format_count(used)} premium requests this month "
      f"(set quota in {config_path()} for a percentage)"
    ),
  )


def scan():
  config = read_config()
  pat = str(os.environ.get("GITHUB_TOKEN") or config.get("githubToken") or "").strip()
  if pat:
    try:
      quota = float(os.environ.get("COPILOT_QUOTA") or config.get("quota") or 0)
      return scan_billing_api(pat, quota)
    except CopilotError:
      pass  # Fall through to the local editor/CLI token below.

  token = local_oauth_token()
  if not token:
    return base_record(usageStatusText="Copilot unavailable")
  return scan_internal(token)


def main():
  parser = argparse.ArgumentParser(description="Print the GitHub Copilot usage record as JSON")
  # Every quota check is one live request with nothing worth caching between
  # collector runs, so --force and --limits-only are accepted but change
  # nothing; every collector takes the same invocation.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  try:
    record = scan()
  except CopilotError as error:
    record = base_record(usageStatusText="Copilot unavailable", authHelpText=str(error))
  except Exception as error:
    record = base_record(usageStatusText="Copilot unavailable")
    print(f"omarchy-agent-usage-copilot: {type(error).__name__}", file=sys.stderr)

  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
