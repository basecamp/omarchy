#!/bin/bash

# omarchy:summary=Apply Omarchy system setup in the installed target
# omarchy:group=apply
# omarchy:requires-sudo=true
# omarchy:examples=omarchy apply system --install-user dhh --first-install | omarchy apply system --install-user kid --first-install --profile child
# omarchy:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omarchy apply system --install-user USER [--first-install|--upgrade] [--profile PROFILE]
       omarchy apply system --defer-provisioning --first-install [--profile PROFILE]

Runs root-owned Omarchy system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
omarchy-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/omarchy/provisioning/groups instead of calling usermod.

--profile records the install profile, default or child, as one word in
/etc/omarchy/profile, which omarchy-profile-child reads at runtime, and exports
it as OMARCHY_INSTALL_PROFILE for the setup leaves. Child is Omarchy's kids
mode, picked by the installer's "Who is this computer for?" question.
USAGE
}

install_user="${OMARCHY_INSTALL_USER:-}"
profile="${OMARCHY_INSTALL_PROFILE:-default}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --profile)
      profile="${2:-}"
      shift 2
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

case $profile in
  default|child) ;;
  *)
    echo "Error: --profile must be default or child" >&2
    exit 1
    ;;
esac

if (( EUID != 0 )); then
  echo "Error: omarchy-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export OMARCHY_INSTALL_USER="$install_user"
export OMARCHY_INSTALL_PROFILE="$profile"
export OMARCHY_FIRST_INSTALL="$first_install"
export OMARCHY_UPGRADE="$upgrade"

# The marker outlives this run: omarchy-profile-child reads it whenever a menu
# guard, a script, or first-boot provisioning needs to know, and it sits in
# /etc, so a factory reset's @factory clone keeps a child machine a child
# machine. Written even for the default profile, so "no marker" only ever
# means an install that predates profiles.
profile_file="${OMARCHY_PROFILE_FILE:-/etc/omarchy/profile}"
install -Dm644 /dev/null "$profile_file"
printf '%s\n' "$profile" >"$profile_file"

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
export OMARCHY_INSTALL_LOG_FILE="${OMARCHY_INSTALL_LOG_FILE:-/var/log/omarchy-install.log}"
export PATH="$OMARCHY_PATH/bin:$PATH"

source "$OMARCHY_INSTALL/helpers/logging.sh"
start_install_log

source "$OMARCHY_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  omarchy-apply-hardware --defer-provisioning
else
  omarchy-apply-hardware --install-user "$install_user"
fi

source "$OMARCHY_INSTALL/login/all.sh"
source "$OMARCHY_INSTALL/post-install/all.sh"

stop_install_log
