#!/bin/bash

# omarchy:summary=Shared helpers for plugin commands
# omarchy:group=plugin
# omarchy:hidden=true

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
    return
  fi
  fail "refusing to continue without confirmation; pass --yes"
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

installed_plugin_ids() {
  find "$PLUGINS_DIR" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) ! -name '.*' -printf '%f\n' 2>/dev/null | sort
}

is_bar_option() {
  omarchy-plugin-catalog | jq -e --arg id "$1" '
    any(.[]; .id == $id and (.kinds | index("bar")))
  ' >/dev/null
}

enabled_message() {
  local id="$1"
  if is_bar_option "$id"; then
    echo "Now using $id as the bar"
  else
    echo "Enabled $id"
  fi
}

plugin_discovered() {
  local id="$1"
  local plugins
  plugins=$(omarchy-shell shell listPlugins)
  jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$plugins" >/dev/null 2>&1
}

wait_for_plugin_discovery() {
  local id="$1"
  local attempt
  for (( attempt = 0; attempt < 40; attempt++ )); do
    plugin_discovered "$id" && return 0
    sleep 0.05
  done
  return 1
}
