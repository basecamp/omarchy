#!/bin/bash

# omarchy:summary=Select and set the system timezone
# omarchy:group=menu
# omarchy:name=timezone

set -e

timezone=$(timedatectl list-timezones | omarchy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1

# Hand the timezone to systemd-timedated over the bus instead of running
# timedatectl under sudo. timedated is already privileged, bus-activated so it
# exits once idle, and confined to CAP_SYS_TIME with IPAddressDeny=any. The
# timezone arrives as a typed D-Bus string that timedated validates against
# tzdata itself, so there is no argv for a second option to ride along in --
# which is the thing the sudoers rule this replaces had to be narrowed twice to
# stop. The trailing true lets timedated ask polkit for interactive
# authentication, so a caller not covered by
# default/polkit-1/rules.d/49-omarchy-timezone.rules gets a prompt from the
# session's agent rather than a bare failure.
busctl -- call org.freedesktop.timedate1 /org/freedesktop/timedate1 \
  org.freedesktop.timedate1 SetTimezone sb "$timezone" true

omarchy-shell -q omarchy.clock refresh
omarchy-notification-send "Timezone is now set to $timezone"
