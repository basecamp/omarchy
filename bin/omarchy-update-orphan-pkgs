#!/bin/bash

# omarchy:summary=Review and optionally remove orphaned system packages after updates
# omarchy:requires-sudo=true

set -e
source "$OMARCHY_PATH/default/bash/i18n"
omarchy_i18n_load

mapfile -t orphans < <(pacman -Qtdq 2>/dev/null || true)
(( ${#orphans[@]} )) || exit 0

echo -e "\e[32m\n$(omarchy_t "Orphan system packages")\e[0m"
printf '  %s\n' "${orphans[@]}"
echo

if [[ ! -t 0 || ! -t 1 ]]; then
  omarchy_t "%1 orphaned package(s) found. Re-run omarchy-update-orphan-pkgs in a terminal to review/remove them." "${#orphans[@]}"
  echo
  echo
  exit 0
fi

if ! gum confirm --default=false "$(omarchy_t "Remove %1 orphaned package(s)?" "${#orphans[@]}")"; then
  echo "$(omarchy_t "Keeping orphaned packages.")"
  echo
  exit 0
fi

echo -e "\e[32m\n$(omarchy_t "Removing orphan system packages")\e[0m"
sudo pacman -Rns "${orphans[@]}"
echo
