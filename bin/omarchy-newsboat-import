#!/bin/bash

# omarchy:summary=Import Newsboat subscriptions from an OPML file
# omarchy:args=<opml-file>
# omarchy:examples=omarchy newsboat import ~/Downloads/subscriptions.opml

set -euo pipefail

if (( $# != 1 )) || [[ ! -r $1 || ! -f $1 ]]; then
  echo "Usage: omarchy newsboat import <readable-opml-file>" >&2
  exit 1
fi

if omarchy-pkg-missing newsboat; then
  echo "Install Newsboat first with: omarchy install newsboat" >&2
  exit 1
fi

opml_file="$1"
newsboat_config_dir="$HOME/.config/newsboat"
newsboat_urls="$newsboat_config_dir/urls"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/omarchy-newsboat-$UID-urls.lock"
staged_urls=""

mkdir -p "$newsboat_config_dir"
cleanup() {
  [[ -z $staged_urls ]] || rm -f -- "$staged_urls"
}
trap cleanup EXIT

{
  flock 9
  staged_urls=$(mktemp "$newsboat_config_dir/urls.import.XXXXXX")
  if [[ -f $newsboat_urls ]]; then
    cp -- "$newsboat_urls" "$staged_urls"
  fi
  chmod 600 "$staged_urls"

  newsboat -u "$staged_urls" -i "$opml_file"
  mv -f -- "$staged_urls" "$newsboat_urls"
  staged_urls=""
} 9>"$lock_file"

echo "Imported subscriptions from: $opml_file"
