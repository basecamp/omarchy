#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

# Same Copy URL repair as omarchy-launch-browser: web apps start Chromium
# without going through that wrapper, and the migration is stamped complete
# on fresh installs.
if [[ -x ${OMARCHY_PATH:-}/bin/omarchy-cmd-repair-chromium-copy-url ]]; then
  "$OMARCHY_PATH/bin/omarchy-cmd-repair-chromium-copy-url" || true
fi

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

exec setsid uwsm-app -- $(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1) --app="$1" "${@:2}"
