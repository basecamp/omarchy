#!/bin/bash

# omarchy:summary=Safely update packages and recover Omarchy file conflicts
# omarchy:hidden=true
# omarchy:requires-sudo=true

set -euo pipefail
umask 077

if ((EUID != 0)); then
  echo "omarchy-update-file-conflicts must run as root" >&2
  exit 1
fi

# This helper acts on root files after parsing attacker-modifiable text. Resolve
# every command from system directories, never from an active dev checkout.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
export LC_ALL=C

readonly ROOT_UID=0
readonly ROOT_GID=0
readonly ARCHIVE_BOUNDARY=/var
readonly ARCHIVE_PARENT=/var/lib/omarchy
readonly ARCHIVE_ROOT=/var/lib/omarchy/replaced
readonly PACKAGE_CACHE_BOUNDARY=/
readonly MAX_REPORT_BYTES=1048576
readonly PACKAGE_CONFLICT_STATUS=75
readonly REPORT_PARENT=/run

allowed_packages=(omarchy omarchy-dev omarchy-settings omarchy-settings-dev)
allowed_roots=(/etc /usr)

declare -a conflict_packages=() conflict_paths=() moved_paths=() moved_slots=() package_caches=()
declare -A archive_for_package=() stage_for_root=()
report=""
report_dir=""
report_file=""
retry_succeeded=0

valid_package() {
  local package="$1" allowed
  for allowed in "${allowed_packages[@]}"; do
    [[ $package == "$allowed" ]] && return 0
  done
  return 1
}

root_for_path() {
  local path="$1" root
  for root in "${allowed_roots[@]}"; do
    [[ $path == "$root/"* ]] && { printf '%s\n' "$root"; return 0; }
  done
  return 1
}

valid_absolute_path_syntax() {
  local path="$1"
  [[ $path == /* && $path != / && $path != *$'\n'* && $path != *$'\r'* && $path != *$'\t'* ]] || return 1
  case "$path" in
  *//* | */./* | */../* | */. | */..) return 1 ;;
  esac
}

valid_canonical_path() {
  local path="$1"
  valid_absolute_path_syntax "$path" || return 1
  root_for_path "$path" >/dev/null
}

assert_root_directory() {
  local directory="$1" owner mode canonical
  [[ -d $directory && ! -L $directory ]] || return 1
  canonical=$(realpath -e -- "$directory" 2>/dev/null) || return 1
  [[ $canonical == "$directory" ]] || return 1
  owner=$(stat -Lc '%u' "$directory") || return 1
  mode=$(stat -Lc '%a' "$directory") || return 1
  [[ $owner == "$ROOT_UID" ]] && ! ((8#$mode & 022))
}

path_within_root() {
  local path="$1" root="$2"
  if [[ $root == / ]]; then
    [[ $path == /* ]]
  else
    [[ $path == "$root" || $path == "$root/"* ]]
  fi
}

assert_safe_parent_chain() {
  local path="$1" root="$2" directory next
  directory=$(dirname -- "$path")
  path_within_root "$directory" "$root" || return 1

  while :; do
    # The process root has no parent component that pathname traversal can
    # replace. Every directory below it, including the configured cache itself,
    # still has to be root-owned and non-writable.
    [[ $directory == / && $root == / ]] && return 0
    assert_root_directory "$directory" || return 1
    [[ $directory == "$root" ]] && return 0
    next=$(dirname -- "$directory")
    path_within_root "$next" "$root" || return 1
    directory=$next
  done
}

load_package_caches() {
  local configured cache canonical existing duplicate
  configured=$(pacman-conf CacheDir 2>/dev/null) || return 1

  while IFS= read -r cache; do
    [[ -n $cache ]] || continue
    [[ $cache != / ]] || return 1
    cache=${cache%/}
    valid_absolute_path_syntax "$cache" || return 1
    canonical=$(realpath -e -- "$cache" 2>/dev/null) || return 1
    [[ $canonical == "$cache" ]] || return 1
    assert_safe_parent_chain "$cache/.cache-probe" "$PACKAGE_CACHE_BOUNDARY" || return 1

    duplicate=0
    for existing in "${package_caches[@]}"; do
      if [[ $existing == "$cache" ]]; then
        duplicate=1
      fi
    done
    ((duplicate)) || package_caches+=("$cache")
  done <<<"$configured"

  ((${#package_caches[@]} > 0))
}

load_upgrade_archives() {
  local plan listed_package location filename cache candidate owner mode previous
  load_package_caches || return 1

  # Ask pacman for the exact pending sysupgrade, not for an explicitly named
  # package. `pacman -Sp package` also prints inactive and already-current
  # packages, so a stale cached archive must not authorize a root move.
  plan=$(pacman -Sup --print-format $'%n\t%l' 2>/dev/null) || return 1
  while IFS=$'\t' read -r listed_package location; do
    valid_package "$listed_package" && [[ -n $location ]] || continue
    location=${location%%\?*}
    filename=${location##*/}
    [[ -n $filename && $filename != "$location" ]] || continue
    candidate=""
    for cache in "${package_caches[@]}"; do
      if [[ ! -e $cache/$filename && ! -L $cache/$filename ]]; then
        continue
      fi
      candidate=$cache/$filename
      [[ -f $candidate && ! -L $candidate ]] || return 1
      owner=$(stat -Lc '%u' "$candidate") || return 1
      mode=$(stat -Lc '%a' "$candidate") || return 1
      [[ $owner == "$ROOT_UID" ]] && ! ((8#$mode & 022)) || return 1
      break
    done
    [[ -n $candidate ]] || continue
    previous=${archive_for_package[$listed_package]:-}
    [[ -z $previous || $previous == "$candidate" ]] || return 1
    archive_for_package[$listed_package]=$candidate
  done <<<"$plan"
}

package_archive_for() {
  local package="$1" archive=${archive_for_package[$package]:-}
  [[ -n $archive ]] || return 1
  printf '%s\n' "$archive"
}

package_contains_path() {
  local package="$1" expected="$2" archive listed_package listed_path
  archive=$(package_archive_for "$package") || return 1
  while read -r listed_package listed_path; do
    [[ $listed_package == "$package" && -n $listed_path ]] || continue
    listed_path=${listed_path%/}
    [[ $listed_path == "$expected" ]] && return 0
  done < <(pacman -Qlp -- "$archive" 2>/dev/null)
  return 1
}

parse_report() {
  local line clean package path conflict_count=0
  local conflict_pattern='^(omarchy|omarchy-dev|omarchy-settings|omarchy-settings-dev): (.+) exists in filesystem$'
  declare -A seen=()

  while IFS= read -r line; do
    # Pacman may color its "error:" prefix when a caller forces color. Strip
    # CSI sequences before matching, while still treating all text as data.
    clean=$(printf '%s' "$line" | sed $'s/\033\[[0-9;]*[[:alpha:]]//g')
    [[ $clean == *" exists in filesystem"* ]] && ((conflict_count += 1))
    if [[ $clean =~ $conflict_pattern ]]; then
      package=${BASH_REMATCH[1]}
      path=${BASH_REMATCH[2]}
      valid_package "$package" || return 1
      valid_canonical_path "$path" || return 1
      [[ -z ${seen[$path]:-} ]] || return 1
      seen[$path]=1
      conflict_packages+=("$package")
      conflict_paths+=("$path")
    fi
  done <<<"$report"

  ((${#conflict_paths[@]} > 0 && ${#conflict_paths[@]} == conflict_count))
}

validate_conflicts() {
  local index package path root other
  for index in "${!conflict_paths[@]}"; do
    package=${conflict_packages[$index]}
    path=${conflict_paths[$index]}
    root=$(root_for_path "$path") || return 1

    package_contains_path "$package" "$path" || {
      echo "Refusing conflict path not shipped by $package: $path" >&2
      return 1
    }
    if pacman -Qo -- "$path" &>/dev/null; then
      echo "Refusing package-owned conflict path: $path" >&2
      return 1
    fi
    [[ -e $path || -L $path ]] || {
      echo "Conflict path disappeared before it could be secured: $path" >&2
      return 1
    }
    assert_safe_parent_chain "$path" "$root" || {
      echo "Refusing conflict below an unsafe parent: $path" >&2
      return 1
    }

    # Reject overlapping candidates. Moving one must never turn another path
    # into a traversal through attacker-owned content.
    for other in "${conflict_paths[@]}"; do
      [[ $other == "$path" ]] && continue
      [[ $other != "$path/"* && $path != "$other/"* ]] || {
        echo "Refusing overlapping conflict paths: $path and $other" >&2
        return 1
      }
    done
  done
}

stage_for() {
  local root="$1" stage manifest
  if [[ -n ${stage_for_root[$root]:-} ]]; then
    STAGE_RESULT=${stage_for_root[$root]}
    return 0
  fi
  stage=$(mktemp -d "$root/.omarchy-update-conflicts.XXXXXX")
  stage_for_root[$root]=$stage
  chown "$ROOT_UID:$ROOT_GID" "$stage"
  chmod 0700 "$stage"
  manifest=$stage/manifest
  : >"$manifest"
  chown "$ROOT_UID:$ROOT_GID" "$manifest"
  chmod 0600 "$manifest"
  sync -f "$manifest"
  STAGE_RESULT=$stage
}

stage_has_items() {
  local stage="$1" item
  for item in "$stage"/item-*; do
    [[ -e $item || -L $item ]] && return 0
  done
  return 1
}

move_conflicts() {
  local index path root stage slot
  echo -e "\e[33m\nTaking over files pacman doesn't own yet:\e[0m"
  for index in "${!conflict_paths[@]}"; do
    path=${conflict_paths[$index]}
    root=$(root_for_path "$path")
    stage_for "$root"
    stage=$STAGE_RESULT
    slot="$stage/item-$index"
    # Persist the opaque-name mapping before the destructive rename. If the
    # process or machine dies after mv(1), the original path remains recoverable
    # from the root-only same-filesystem stage.
    moved_paths+=("$path")
    moved_slots+=("$slot")
    printf 'item-%s\t%s\n' "$index" "$path" >>"$stage/manifest"
    sync -f "$stage/manifest"
    mv --no-copy -T -- "$path" "$slot"
    sync -f "$stage"
    printf '  %s -> protected item %d\n' "$path" "$index"
  done
  echo
}

restore_moved() {
  local index path slot root
  local announced=0
  for index in "${!moved_paths[@]}"; do
    path=${moved_paths[$index]}
    slot=${moved_slots[$index]}
    [[ -e $slot || -L $slot ]] || continue
    [[ ! -e $path && ! -L $path ]] || continue
    root=$(root_for_path "$path") || continue
    assert_safe_parent_chain "$path" "$root" || {
      echo "Refusing to restore below a changed parent: $path" >&2
      continue
    }
    if ((announced == 0)); then
      echo -e "\e[33m\nPutting back what the upgrade didn't take:\e[0m"
      announced=1
    fi
    if mv --no-copy -T -- "$slot" "$path"; then
      printf '  %s\n' "$path"
    else
      echo "Could not safely restore $path; retaining it in protected quarantine." >&2
    fi
  done
}

archive_remaining() {
  # cleanup() invokes this function as the left side of `||`, which suppresses
  # Bash's errexit behavior throughout the call. Every operation that protects
  # or publishes archive state must therefore propagate failure explicitly.
  local root stage transaction label locations archive_device stage_device has_items=0 retained_in_place=0
  for stage in "${stage_for_root[@]}"; do
    [[ -d $stage ]] || continue
    if stage_has_items "$stage"; then has_items=1; break; fi
  done
  ((has_items)) || {
    for stage in "${stage_for_root[@]}"; do
      rm -f -- "$stage/manifest" || return 1
      rmdir -- "$stage" 2>/dev/null || return 1
    done
    return 0
  }

  if [[ ! -e $ARCHIVE_PARENT && ! -L $ARCHIVE_PARENT ]]; then
    assert_safe_parent_chain "$ARCHIVE_PARENT" "$ARCHIVE_BOUNDARY" || return 1
    install -d -o "$ROOT_UID" -g "$ROOT_GID" -m 0755 "$ARCHIVE_PARENT" || return 1
  fi
  assert_root_directory "$ARCHIVE_PARENT" || return 1
  assert_safe_parent_chain "$ARCHIVE_ROOT" "$ARCHIVE_BOUNDARY" || return 1
  if [[ -e $ARCHIVE_ROOT || -L $ARCHIVE_ROOT ]]; then
    assert_root_directory "$ARCHIVE_ROOT" || return 1
    chmod 0700 "$ARCHIVE_ROOT" || return 1
  else
    install -d -o "$ROOT_UID" -g "$ROOT_GID" -m 0700 "$ARCHIVE_ROOT" || return 1
  fi
  assert_root_directory "$ARCHIVE_ROOT" || return 1
  transaction=$(mktemp -d "$ARCHIVE_ROOT/transaction.XXXXXX") || return 1
  chown "$ROOT_UID:$ROOT_GID" "$transaction" || return 1
  chmod 0700 "$transaction" || return 1
  assert_root_directory "$transaction" || return 1
  locations=$transaction/locations
  : >"$locations" || return 1
  chmod 0600 "$locations" || return 1
  archive_device=$(stat -Lc '%d' "$transaction") || return 1

  for root in "${!stage_for_root[@]}"; do
    stage=${stage_for_root[$root]}
    [[ -d $stage ]] || continue
    label=$(basename -- "$root") || return 1
    if stage_has_items "$stage"; then
      # Never let mv(1) fall back to recursively copying a directory that may
      # still be mutable through a descriptor opened before quarantine. When
      # /var is separate, retain the complete root-only stage in place.
      stage_device=$(stat -Lc '%d' "$stage") || return 1
      if [[ $stage_device == "$archive_device" ]] && mv --no-copy -T -- "$stage" "$transaction/$label"; then
        printf '%s\t%s\n' "$label" "$transaction/$label" >>"$locations" || return 1
      else
        printf '%s\t%s\n' "$label" "$stage" >>"$locations" || return 1
        retained_in_place=1
      fi
    else
      rm -f -- "$stage/manifest" || return 1
      rmdir -- "$stage" || return 1
    fi
  done

  sync -f "$locations" || return 1
  printf 'Replaced files retained in %s\n' "$transaction" || return 1
  if ((retained_in_place)); then
    echo "Some replaced files remain in their root-only same-filesystem stages; see $locations" >&2 || return 1
  fi
}

cleanup_report() {
  [[ -n $report_file ]] && rm -f -- "$report_file"
  [[ -n $report_dir ]] && rmdir -- "$report_dir" 2>/dev/null || true
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  ((retry_succeeded)) || restore_moved
  archive_remaining || echo "Warning: protected conflict staging could not be archived." >&2
  cleanup_report
  exit "$status"
}
trap cleanup EXIT
trap 'exit 1' INT TERM

# Capture the transaction that can authorize root moves inside this privileged
# process. A same-UID caller can rewrite any report created by the public
# wrapper, even when the path and archive membership look otherwise valid.
assert_root_directory "$REPORT_PARENT" || {
  echo "Could not establish a trusted pacman report directory" >&2
  exit 1
}
report_dir=$(mktemp -d "$REPORT_PARENT/omarchy-update-pacman.XXXXXX")
report_file=$report_dir/errors
: >"$report_file"

if env OMARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm \
  --overwrite '/usr/share/omarchy/*' 2>"$report_file"; then
  cat "$report_file" >&2
  cleanup_report
  trap - EXIT INT TERM
  exit 0
fi
cat "$report_file" >&2

if grep -q 'unresolvable package conflicts detected' "$report_file"; then
  exit "$PACKAGE_CONFLICT_STATUS"
fi

grep -q 'failed to commit transaction (conflicting files)' "$report_file" || exit 1

report_size=$(stat -Lc '%s' "$report_file") || exit 1
((report_size <= MAX_REPORT_BYTES)) || {
  echo "Refusing an oversized pacman error report" >&2
  exit 1
}
report=$(<"$report_file")

parse_report || {
  echo "Pacman report contains unsupported or incomplete file conflicts" >&2
  exit 1
}
load_upgrade_archives || {
  echo "Could not establish the pending package transaction" >&2
  exit 1
}
validate_conflicts
move_conflicts

echo -e "\e[32m\nUpdate system packages\e[0m"
if env OMARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm --overwrite '/usr/share/omarchy/*'; then
  retry_succeeded=1
  archive_remaining
  stage_for_root=()
  trap - EXIT INT TERM
  exit 0
fi
exit 1
