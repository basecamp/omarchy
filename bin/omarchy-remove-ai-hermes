#!/bin/bash

# omarchy:summary=Remove the Hermes desktop app and the Hermes runtime it installed
# omarchy:requires-sudo=true

set -e

omarchy-pkg-drop hermes-desktop

# The app installs a Hermes of its own under ~/.hermes and puts its command on
# PATH, and neither is any use once the app is gone. What stays is everything
# in ~/.hermes that is yours -- chats, memories, the skills Hermes wrote for
# itself -- which is small and worth surviving a reinstall.
rm -rf "$HOME/.hermes/hermes-agent" "$HOME/.hermes/bootstrap-cache" "$HOME/.config/Hermes"
rm -f "$HOME/.local/bin/hermes" "$HOME/.local/bin/hermes-agent" "$HOME/.local/bin/hermes-acp"

echo ""
echo "Hermes Desktop has been removed."
echo "Your chats, memories, and skills are still in ~/.hermes."
