#!/bin/bash

# omarchy:summary=Update installed git-managed plugins
# omarchy:group=plugin
# omarchy:args=[id] [--verify-with-agent|--no-verify-with-agent] [--skill <file>] [--yes]

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
UPDATED_ANY=0

fail() {
  echo "omarchy-plugin-update: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

unattended() {
  (( ASSUME_YES )) || ! interactive
}

resolve_verification() {
  [[ -n $verify ]] && return 0

  agent=$(omarchy-default-agent)
  if [[ -n $agent ]] && omarchy-toggle-enabled agent-security-scan; then
    verify=true
  else
    verify=false
  fi
}

verify_update() {
  local dir="$1"
  local revision="$2"
  local outcome choice
  local -a review=(omarchy-plugin-verify "$dir" --revision "$revision")

  [[ -n $verify_skill ]] && review+=(--skill "$verify_skill")
  while :; do
    outcome=0
    "${review[@]}" || outcome=$?
    (( outcome == 0 )) && return 0

    if (( outcome == 1 )); then
      unattended && return 1
      gum confirm "Update it anyway?" || return 1
      return 0
    fi

    unattended && return 1
    choice=$(gum choose --header="The review did not finish. What now?" \
      "Run the review again" \
      "Skip the review and update it" \
      "Keep the installed version") || return 1
    case "$choice" in
    "Run the review again") continue ;;
    "Skip the review and update it") return 0 ;;
    *) return 1 ;;
    esac
  done
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

update_one() {
  local id="$1"
  local dir="$PLUGINS_DIR/$id"
  local candidate candidate_revision installed_revision

  if [[ -n $(git -C "$dir" status --porcelain --untracked-files=all) ]]; then
    echo "omarchy-plugin-update: '$id' has local changes; refusing to replace unreviewed source" >&2
    return 1
  fi
  installed_revision=$(git -C "$dir" rev-parse HEAD)

  if ! git -C "$dir" fetch --quiet origin HEAD; then
    echo "omarchy-plugin-update: fetch failed for '$id'" >&2
    return 1
  fi

  candidate_revision=$(git -C "$dir" rev-parse FETCH_HEAD^{commit}) || {
    echo "omarchy-plugin-update: fetched revision for '$id' is not a commit" >&2
    return 1
  }

  if [[ $installed_revision == $candidate_revision ]]; then
    echo "$id is up to date."
    return 0
  fi

  if (( ! ASSUME_YES )); then
    echo "Changes for $id:"
    if omarchy-cmd-present delta; then
      git -C "$dir" diff "$installed_revision" "$candidate_revision" | delta --paging=never
    else
      git -C "$dir" diff "$installed_revision" "$candidate_revision"
    fi
    echo
    confirm "Update $id?" || {
      echo "Skipped $id."
      return 0
    }
  fi

  if [[ $verify == true ]]; then
    candidate=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-plugin-update-XXXXXXXXXXXX") || {
      echo "omarchy-plugin-update: could not stage '$id' for validation" >&2
      return 1
    }
    if ! git -C "$dir" archive "$candidate_revision" | tar -x -C "$candidate" ||
      ! omarchy-plugin-validate "$candidate"; then
      rm -rf "$candidate"
      echo "omarchy-plugin-update: candidate update of '$id' failed validation" >&2
      return 1
    fi
    rm -rf "$candidate"

    if ! verify_update "$dir" "$candidate_revision"; then
      echo "Held $id at its installed version because the security review did not clear the update." >&2
      return 1
    fi
  fi

  if [[ $(git -C "$dir" rev-parse HEAD) != $installed_revision ||
    -n $(git -C "$dir" status --porcelain --untracked-files=all) ]]; then
    echo "omarchy-plugin-update: '$id' changed while its update was being reviewed" >&2
    return 1
  fi

  if ! git -C "$dir" merge --ff-only "$candidate_revision" >/dev/null 2>&1; then
    echo "omarchy-plugin-update: cannot fast-forward '$id'; you have local changes in $dir" >&2
    return 1
  fi

  if ! omarchy-plugin-validate "$dir"; then
    git -C "$dir" reset --hard ORIG_HEAD >/dev/null
    echo "omarchy-plugin-update: update of '$id' failed validation; rolled back" >&2
    return 1
  fi

  echo "Updated $id."
  UPDATED_ANY=1
}

id=""
verify=""
verify_skill=""
agent=""

while (( $# > 0 )); do
  case "$1" in
  --verify-with-agent)
    verify=true
    shift
    ;;
  --no-verify-with-agent)
    verify=false
    shift
    ;;
  --skill)
    verify_skill=${2:?--skill needs a path}
    [[ -n $verify ]] || verify=true
    shift 2
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin update [id] [--verify-with-agent|--no-verify-with-agent] [--skill <file>] [--yes]"
    exit 0
    ;;
  -*)
    fail "unknown update option: $1"
    ;;
  *)
    [[ -z $id ]] || fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

resolve_verification
if [[ $verify == true && -z $agent ]]; then
  agent=$(omarchy-default-agent)
  [[ -n $agent ]] ||
    fail "no default coding agent to verify with; choose one with: omarchy default agent <name>"
fi

[[ -d $PLUGINS_DIR ]] || fail "no plugins installed"

targets=()
if [[ -n $id ]]; then
  valid_plugin_id "$id" || fail "invalid plugin id '$id'"
  [[ -d $PLUGINS_DIR/$id ]] || fail "plugin '$id' is not installed"
  [[ -d $PLUGINS_DIR/$id/.git ]] ||
    fail "plugin '$id' is not a git checkout, so there is nothing to pull from"
  targets=("$id")
else
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir/.git ]] || continue
    targets+=("$(basename "$dir")")
  done
  if (( ${#targets[@]} == 0 )); then
    echo "No git-managed plugins installed."
    exit 0
  fi
fi

rc=0
for id in "${targets[@]}"; do
  update_one "$id" || rc=1
done

if (( UPDATED_ANY )); then
  omarchy-shell shell rescanPlugins >/dev/null
fi
exit $rc
