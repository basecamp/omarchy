#!/bin/bash

# omarchy:summary=Sync the generated Omarchy theme to Oh My Pi
# omarchy:args=[--activate]
# omarchy:hidden=true

set -euo pipefail

OMP_SOURCE_PATH="$HOME/.local/state/omarchy/current/theme/omp.json"
OMP_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}"
OMP_THEME_DIR="$OMP_AGENT_DIR/themes"
OMP_THEME_PATH="$OMP_THEME_DIR/omarchy-system.json"
OMP_ACTIVATE=0

usage() {
  echo "Usage: omarchy-theme-set-omp [--activate]"
}

for arg in "$@"; do
  case "$arg" in
    --activate)
      OMP_ACTIVATE=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -f $OMP_SOURCE_PATH ]]; then
  if (( OMP_ACTIVATE == 1 )); then
    echo "Oh My Pi theme source missing: $OMP_SOURCE_PATH" >&2
    echo "Run omarchy-theme-refresh after selecting an Omarchy theme." >&2
    exit 1
  fi

  exit 0
fi

if (( OMP_ACTIVATE == 0 )) && [[ ! -d $OMP_AGENT_DIR ]]; then
  exit 0
fi

# Oh My Pi keeps its settings in a YAML file that it owns, migrates, and
# quarantines on parse errors, so its own CLI is the only safe writer. Both
# theme slots are pointed at the generated theme because Oh My Pi picks the
# dark or the light slot from the terminal background, and the terminal is
# themed by Omarchy as well.
write_setting_theme() {
  if omarchy-cmd-missing omp; then
    echo "Oh My Pi is not installed; synced the theme without activating it" >&2
    return 0
  fi

  omp config set theme.dark omarchy-system >/dev/null
  omp config set theme.light omarchy-system >/dev/null
}

# Oh My Pi watches the active custom theme file and hot-reloads it on change,
# so running sessions retint without a restart.
mkdir -p "$OMP_THEME_DIR"
tmp=$(mktemp "$OMP_THEME_PATH.XXXXXX")
cp "$OMP_SOURCE_PATH" "$tmp"
mv "$tmp" "$OMP_THEME_PATH"

if (( OMP_ACTIVATE == 1 )); then
  write_setting_theme
fi
