#!/bin/bash

# omarchy:summary=Install the AFK Monitor bar plugin if it is missing
# omarchy:hidden=true

set -euo pipefail

plugin_id="lcavadas.afk-monitor"
plugin_url="https://git.mooglest.com/mooglest/omarchy-afk-monitor.git"
plugin_dir="$HOME/.config/omarchy/plugins/$plugin_id"

[[ -e $plugin_dir || -L $plugin_dir ]] && exit 0

# Non-interactive: this is invoked from the lazy AFK wrapper and from
# default-agent setup, where there is no terminal to confirm in.
omarchy-plugin-add "$plugin_url" --enable --yes
