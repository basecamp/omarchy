#!/bin/bash

# omarchy:summary=Synchronize enabled Hyprland plugins
# omarchy:group=plugin
# omarchy:hidden=true

set -euo pipefail

fail() {
  echo "omarchy-plugin-hyprland-sync: $*" >&2
  exit 1
}

state_home="$HOME/.local/state/omarchy/hypr"
loader="$state_home/plugins.lua"
state_file="$HOME/.config/omarchy/hypr-plugins.json"
mkdir -p "$state_home"

catalog=$(omarchy-plugin-catalog)
if [[ -f $state_file ]]; then
  enabled=$(<"$state_file")
else
  enabled='{"enabled":[]}'
fi
jq -e . >/dev/null <<<"$catalog" || fail "plugin catalog is not valid JSON"
jq -e '.enabled | type == "array" and all(.[]; type == "string")' <<<"$enabled" >/dev/null \
  || fail "Hyprland plugin state is not valid JSON: $state_file"

declare -A manifest_json source_dir entry_point priority dependencies
declare -A visiting visited
ordered=()

manifest_for() {
  local id="$1"
  jq -c --arg id "$id" 'map(select(.id == $id))[0] // empty' <<<"$catalog"
}

load_plugin() {
  local id="$1" manifest source entry deps
  [[ -n ${manifest_json[$id]+x} ]] && return 0
  manifest=$(manifest_for "$id")
  [[ -n $manifest ]] || fail "dependency '$id' is not installed"
  source=$(jq -r '.sourceDir' <<<"$manifest")
  entry=$(jq -r '.entryPoints.hyprland // empty' <<<"$manifest")
  [[ -n $entry ]] || fail "Hyprland plugin '$id' has no entryPoints.hyprland"
  omarchy-plugin-validate "$source" >/dev/null || fail "plugin '$id' failed validation"
  deps=$(jq -c '.dependencies // []' <<<"$manifest")
  jq -e 'type == "array" and all(.[]; type == "string")' <<<"$deps" >/dev/null \
    || fail "dependencies for '$id' must be an array of plugin IDs"
  manifest_json[$id]="$manifest"
  source_dir[$id]="$source"
  entry_point[$id]="$entry"
  priority[$id]=$(jq -r '.priority // 50' <<<"$manifest")
  dependencies[$id]="$deps"
}

visit() {
  local id="$1" dep
  load_plugin "$id"
  [[ ${visited[$id]:-0} == 1 ]] && return 0
  [[ ${visiting[$id]:-0} == 1 ]] && fail "dependency cycle includes '$id'"
  visiting[$id]=1
  while IFS= read -r dep; do
    [[ -n $dep ]] || continue
    [[ $dep =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "invalid dependency '$dep' in '$id'"
    visit "$dep"
  done < <(jq -r '.[]' <<<"${dependencies[$id]}")
  unset 'visiting[$id]'
  visited[$id]=1
  ordered+=("$id")
}

mapfile -t roots < <(
  jq -r '.enabled[]' <<<"$enabled" |
    while IFS= read -r id; do
      manifest=$(manifest_for "$id")
      [[ -n $manifest ]] || fail "enabled plugin '$id' is not installed"
      jq -e '(.kinds // []) | index("hyprland") != null' <<<"$manifest" >/dev/null \
        || fail "enabled plugin '$id' is not a Hyprland plugin"
      load_plugin "$id"
      printf '%s\t%s\n' "${priority[$id]}" "$id"
    done | sort -n -k1,1 -k2,2 | cut -f2
)

for id in "${roots[@]}"; do
  [[ -n $id ]] && visit "$id"
done

tmp="$loader.tmp.$$"
{
  echo '-- Generated by omarchy-plugin-hyprland-sync. Do not edit.'
  echo '-- Enable or disable plugins with: omarchy plugin enable|disable <id>'
  for id in "${ordered[@]}"; do
    path="${source_dir[$id]}/${entry_point[$id]}"
    quoted=$(jq -Rrn --arg path "$path" '$path | @json')
    printf 'do\n  local ok, err = pcall(dofile, %s)\n  if not ok then\n    print("omarchy plugin %s failed: " .. tostring(err))\n  end\nend\n' \
      "$quoted" "$id"
  done
} >"$tmp"
mv "$tmp" "$loader"

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && omarchy-cmd-present hyprctl; then
  hyprctl reload >/dev/null
  errors=$(hyprctl configerrors || true)
  if [[ -n $errors && $errors != "no errors" ]]; then
    printf '%s\n' "$errors" >&2
    fail "Hyprland reported configuration errors"
  fi
fi

echo "Synchronized ${#ordered[@]} Hyprland plugin(s)."
