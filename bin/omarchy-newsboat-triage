#!/bin/bash

# omarchy:summary=Apply a confirmed Newsboat briefing triage
# omarchy:args=<brief-id> <read-count> <leave-count> [kept-article-id...]
# omarchy:hidden=true

set -euo pipefail

if (($# < 3)); then
  echo "Usage: omarchy-newsboat-triage <brief-id> <read-count> <leave-count> [kept-article-id...]" >&2
  exit 1
fi

brief_id=$1
expected_read=$2
expected_leave=$3
shift 3
kept_ids=("$@")

if [[ ! $brief_id =~ ^[A-Za-z0-9_-]{8,64}$ ]] || [[ ! $expected_read =~ ^[0-9]+$ ]] || [[ ! $expected_leave =~ ^[0-9]+$ ]]; then
  echo "Invalid briefing confirmation" >&2
  exit 1
fi

if omarchy-pkg-missing newsboat; then
  echo "Install Feeds first with: omarchy install newsboat" >&2
  exit 1
fi

cache_file="${NEWSBOAT_CACHE_FILE:-$HOME/.local/share/newsboat/cache.db}"
urls_file="${NEWSBOAT_URLS_FILE:-$HOME/.config/newsboat/urls}"
state_dir="${NEWSBOAT_BRIEF_STATE_DIR:-/tmp/omarchy-newsboat-$UID/briefs}"
snapshot_file="$state_dir/brief.$brief_id"

if [[ ! -f $cache_file || ! -f $urls_file || ! -f $snapshot_file || -L $snapshot_file ]]; then
  echo "That feed briefing is no longer available. Run Brief Unread again." >&2
  exit 1
fi

umask 077
runtime_dir=/tmp
lock_file="$runtime_dir/omarchy-newsboat-$UID-triage.lock"
import_file=$(mktemp "$runtime_dir/omarchy-newsboat-read.XXXXXXXX")
trap 'rm -f "$import_file"' EXIT

exec 9>"$lock_file"
flock 9

kept_json=$(jq -cn --args '$ARGS.positional' "${kept_ids[@]}")
if ! result=$(python3 - "$snapshot_file" "$cache_file" "$urls_file" "$expected_read" "$expected_leave" "$kept_json" "$import_file" <<'PY'
import hashlib
import json
import re
import shlex
import sqlite3
import sys
import time
from urllib.parse import quote

snapshot_file, cache_file, urls_file, expected_read, expected_leave, kept_json, import_file = sys.argv[1:]

try:
    with open(snapshot_file, encoding="utf-8") as source:
        snapshot = json.load(source)
    kept = json.loads(kept_json)

    if snapshot.get("version") != 1 or int(time.time()) - snapshot["created_at"] > 86400:
        raise ValueError("That feed briefing has expired. Run Brief Unread again.")
    if len(kept) != len(set(kept)) or any(not re.fullmatch(r"A\d{3}", item) for item in kept):
        raise ValueError("The confirmation contains invalid or duplicate article IDs.")

    articles = snapshot.get("articles", [])
    by_id = {article.get("id"): article for article in articles}
    if len(by_id) != len(articles) or any(item not in by_id for item in kept):
        raise ValueError("The confirmation refers to an article outside this briefing.")

    kept_set = set(kept)
    to_mark = [article for article in articles if article.get("markable") and article["id"] not in kept_set]
    calculated_read = sum(article["count"] for article in to_mark)
    calculated_leave = snapshot["total"] - calculated_read
    if calculated_read != int(expected_read) or calculated_leave != int(expected_leave):
        raise ValueError(
            f"Confirmation counts do not match this briefing: expected {calculated_read} read and {calculated_leave} left unread."
        )

    active_feeds = []
    seen = set()
    with open(urls_file, encoding="utf-8") as subscriptions:
        for line in subscriptions:
            try:
                fields = shlex.split(line, comments=True, posix=True)
            except ValueError:
                continue
            if fields and re.fullmatch(r"https?://\S+", fields[0]) and fields[0] not in seen:
                seen.add(fields[0])
                active_feeds.append(fields[0])

    placeholders = ",".join("?" for _ in active_feeds)
    rows = []
    if active_feeds:
        database_uri = f"file:{quote(cache_file, safe='/')}?mode=ro"
        with sqlite3.connect(database_uri, uri=True) as database:
            database.row_factory = sqlite3.Row
            rows = list(
                database.execute(
                    f"SELECT id, guid, feedurl FROM rss_item WHERE unread = 1 AND deleted = 0 AND feedurl IN ({placeholders}) ORDER BY id",
                    active_feeds,
                )
            )

    signature = hashlib.sha256()
    for row in rows:
        signature.update(f'{row["id"]}\0{row["guid"]}\0{row["feedurl"]}\0'.encode())
    if signature.hexdigest() != snapshot.get("signature") or len(rows) != snapshot.get("total"):
        raise ValueError("Your unread edition changed after the briefing. Run Brief Unread again before applying it.")

    target_guids = {article["guid"] for article in to_mark}
    affected = sum(1 for row in rows if row["guid"] in target_guids)
    if affected != calculated_read:
        raise ValueError("The briefing no longer maps cleanly to the unread edition. Run Brief Unread again.")

    with open(import_file, "w", encoding="utf-8", newline="\n") as destination:
        for guid in sorted(target_guids):
            destination.write(guid + "\n")

    print(json.dumps({"read": calculated_read, "leave": calculated_leave}))
except (KeyError, OSError, sqlite3.Error, TypeError, ValueError) as error:
    print(error, file=sys.stderr)
    raise SystemExit(1)
PY
); then
  exit 1
fi

read_count=$(jq -r '.read' <<<"$result")
leave_count=$(jq -r '.leave' <<<"$result")

if (( read_count > 0 )); then
  if ! newsboat -q -c "$cache_file" -u "$urls_file" -I "$import_file" >/dev/null; then
    echo "Could not update the inbox. Close Feeds if it is still open, then confirm again." >&2
    exit 1
  fi
fi

rm -f "$snapshot_file" || true
omarchy-notification-send -g 󰚩 \
  "$read_count marked read · $leave_count left for you" \
  "Your confirmed feed briefing is ready." \
  --exec omarchy-newsboat-read || true

printf '%s marked read; %s left unread.\n' "$read_count" "$leave_count"
