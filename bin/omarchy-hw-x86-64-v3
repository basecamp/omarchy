#!/bin/bash

# omarchy:summary=Detect whether the CPU supports the x86-64-v3 baseline (AVX2, FMA, BMI1, BMI2, F16C, MOVBE).

[[ $(uname -m) == "x86_64" ]] || exit 0

cpuinfo=${OMARCHY_CPUINFO_PATH:-/proc/cpuinfo}
flags=" $(grep -m1 "^flags" "$cpuinfo" 2>/dev/null | cut -d: -f2) "

for flag in avx2 fma bmi1 bmi2 f16c movbe; do
  [[ $flags == *" $flag "* ]] || exit 1
done
