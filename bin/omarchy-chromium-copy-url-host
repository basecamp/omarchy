#!/bin/bash

# omarchy:summary=Native messaging host for Omarchy Chromium page actions
# omarchy:hidden=true

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
export OMARCHY_PATH="${OMARCHY_PATH:-$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)}"
export PATH="$OMARCHY_PATH/bin:/usr/local/bin:/usr/bin:$PATH"

parse_url() {
  jq -r '.url // empty' 2>/dev/null <<<"$1" || true
}

parse_action() {
  jq -r '.action // "copy-url"' 2>/dev/null <<<"$1" || true
}

copy_url() {
  local url="$1"

  [[ -n $url ]] || return 1
  printf '%s' "$url" | wl-copy --type text/plain
  omarchy-notification-send -g 󰅍 "URL copied to clipboard"
}

subscribe_url() {
  local url="$1"

  [[ $url =~ ^https?:// ]] || return 1
  omarchy-newsboat-subscribe "$url" >/dev/null
}

reply_copied() {
  if [[ $1 == "true" ]]; then
    printf '\x0f\x00\x00\x00{"copied":true}'
  else
    printf '\x10\x00\x00\x00{"copied":false}'
  fi
}

reply_subscribed() {
  if [[ $1 == "true" ]]; then
    printf '\x13\x00\x00\x00{"subscribed":true}'
  else
    printf '\x14\x00\x00\x00{"subscribed":false}'
  fi
}

main() {
  local length payload payload_size action url

  # Read exact byte counts. `head -c` may buffer and discard bytes beyond the
  # four-byte header when stdin is a pipe, which loses the following payload.
  length=$(dd bs=1 count=4 2>/dev/null | od -An -v -tu4 | tr -d ' ')
  [[ -n ${length:-} && $length =~ ^[0-9]+$ ]] || exit 0
  (( length > 0 && length <= 1048576 )) || exit 0

  payload=$(dd bs=1 count="$length" 2>/dev/null)
  payload_size=$(printf '%s' "$payload" | wc -c | tr -d ' ')
  (( payload_size == length )) || exit 0
  action=$(parse_action "$payload")
  url=$(parse_url "$payload")

  case $action in
  copy-url)
    if copy_url "$url"; then
      reply_copied true
    else
      reply_copied false
    fi
    ;;
  subscribe-feed)
    if subscribe_url "$url"; then
      reply_subscribed true
    else
      reply_subscribed false
    fi
    ;;
  *) reply_copied false ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
