#!/bin/bash

# omarchy:summary=Update system packages with pacman
# omarchy:requires-sudo=true

set -e

echo -e "\e[32m\nUpdate system packages\e[0m"

errors=$(mktemp)
trap 'rm -f "$errors"' EXIT

# Progress bars stay on stdout. Stderr is captured only to distinguish the one
# failure that needs a person's answer; it never authorizes filesystem changes.
# Fixed privileged binaries keep a dev checkout out of sudo's command lookup.
if sudo /usr/bin/env LC_ALL=C OMARCHY_UPDATE_PACMAN=1 /usr/bin/pacman -Syu --noconfirm 2>"$errors"; then
  update_status=0
else
  update_status=$?
fi
cat "$errors" >&2

if (( update_status == 0 )); then
  exit 0
fi

# --noconfirm declines package replacement questions. In an attended update,
# retry that one case against the databases the first attempt just refreshed so
# Pacman can put the decision back to the person running it. File conflicts and
# every other failure remain untouched and fail with Pacman's original status.
if grep -q 'unresolvable package conflicts detected' "$errors"; then
  if [[ ${OMARCHY_UPDATE_UNATTENDED:-} == 1 || ! -t 0 || ! -t 2 ]]; then
    echo -e "\e[33m\nThis upgrade needs an answer. Run omarchy update interactively to give it.\e[0m" >&2
    exit "$update_status"
  fi

  echo -e "\e[33m\nA package conflict stopped this upgrade. Running it again so you can answer:\e[0m"
  sudo /usr/bin/env OMARCHY_UPDATE_PACMAN=1 /usr/bin/pacman -Su
  exit $?
fi

exit "$update_status"
