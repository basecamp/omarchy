#!/bin/bash

# omarchy:summary=Clone a built-in Omarchy shell plugin into your own config
# omarchy:group=plugin
# omarchy:args=<source-id>

set -euo pipefail

PLUGINS_DIR="$HOME/.config/omarchy/plugins"

fail() {
  echo "omarchy-plugin-clone: $*" >&2
  exit 1
}

replace_fixed_string() {
  local from="$1"
  local to="$2"
  local target_dir="$3"
  local pattern="$from"
  local replacement="$to"
  local file

  pattern=${pattern//\\/\\\\}
  pattern=${pattern//./\\.}
  pattern=${pattern//\*/\\*}
  pattern=${pattern//[/\\[}
  pattern=${pattern//^/\\^}
  pattern=${pattern//$/\\$}
  pattern=${pattern//|/\\|}
  replacement=${replacement//\\/\\\\}
  replacement=${replacement//&/\\&}
  replacement=${replacement//|/\\|}

  while IFS= read -r -d '' file; do
    sed -i "s|$pattern|$replacement|g" "$file"
  done < <(rg --files-with-matches --null --fixed-strings "$from" "$target_dir")
}

copy_plugin() {
  local source_dir="$1"
  local manifest="$2"
  local target_dir="$3"

  if [[ ${manifest##*/} == "manifest.json" ]]; then
    cp -aL "$source_dir" "$target_dir"
    return
  fi

  mkdir -p "$target_dir"
  cp -aL "$manifest" "$target_dir/manifest.json"

  local source target
  while IFS=$'\t' read -r source target; do
    [[ -n $source && -n $target ]] || continue
    [[ $target != /* && $target != *".."* ]] || fail "invalid clone target path: $target"
    if [[ -d $source_dir/$source ]]; then
      mkdir -p "$target_dir/$target"
      cp -aL "$source_dir/$source/." "$target_dir/$target/"
    else
      mkdir -p "$(dirname "$target_dir/$target")"
      cp -aL "$source_dir/$source" "$target_dir/$target"
    fi
  done < <(jq -r '
    [
      (.entryPoints[] | {source: ., target: .}),
      (.omarchy.clonePaths[]? | {source: .source, target: .target})
    ] | unique_by(.target)[] | [.source, .target] | @tsv
  ' "$manifest")

  local from to
  while IFS=$'\t' read -r from to; do
    [[ -n $from ]] || continue
    replace_fixed_string "$from" "$to" "$target_dir"
  done < <(jq -r '.omarchy.cloneReplacements[]? | [.from, .to] | @tsv' "$manifest")
}

clone_plugin() {
  local target_dir="$1"
  local source_id="$2"
  local new_id="$3"
  local display_name="$4"
  local source_pattern="${source_id//./\\.}"
  local file

  while IFS= read -r -d '' file; do
    sed -i "s|$source_pattern|$new_id|g" "$file"
  done < <(rg --files-with-matches --null --fixed-strings "$source_id" "$target_dir")

  local manifest="$target_dir/manifest.json"
  local updated_manifest
  updated_manifest=$(jq \
    --arg id "$new_id" \
    --arg name "$display_name" \
    --arg sourceId "$source_id" '
      .id = $id |
      .name = $name |
      if (.barWidget | type) == "object" then
        .barWidget.displayName = $name
      else
        .
      end |
      .omarchy = (
        (if (.omarchy | type) == "object" then .omarchy else {} end) +
        { clonedFrom: $sourceId }
      ) |
      del(.omarchy.clonePaths, .omarchy.cloneReplacements)
    ' "$manifest")
  printf '%s\n' "$updated_manifest" >"$manifest"
}

switch_to_clone() {
  local source_id="$1"
  local new_id="$2"
  local is_bar="$3"
  local is_bar_widget="$4"

  if [[ $is_bar == "true" ]]; then
    omarchy-bar use "$new_id"
  elif [[ $is_bar_widget == "true" ]]; then
    local shell_config
    shell_config=$(omarchy-shell shell listShellConfig)
    if jq -e --arg id "$source_id" '
      [
        .bar.layout.left[]?,
        .bar.layout.center[]?,
        .bar.layout.right[]?
      ] | any(.[]; (if type == "object" then .id else . end) == $id)
    ' <<<"$shell_config" >/dev/null; then
      omarchy-bar-plugin replace "$source_id" "$new_id"
    else
      omarchy-bar-plugin add "$new_id"
    fi
  else
    omarchy-plugin-enable "$new_id"
    omarchy-plugin-disable "$source_id"
  fi
}

usage() {
  cat <<USAGE
Usage: omarchy plugin clone <source-id>

Copies a built-in plugin into ~/.config/omarchy/plugins/local.<id>/ so you can
edit it freely. The clone keeps all of the source plugin's files and kinds and
uses "My <name>" as its display name, then replaces the built-in with the clone.

USAGE
}

source_id=""
if (( $# > 0 )) && [[ $1 != --* ]]; then
  source_id="$1"
  shift
fi

while (( $# > 0 )); do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  *)
    fail "unknown clone option: $1"
    ;;
  esac
done

[[ -n $source_id ]] || fail "clone source is required"

source_info=$(omarchy-plugin-catalog | jq -r --arg id "$source_id" '
    .[] | select(.firstParty and .id == $id)
    | [
        .sourceDir,
        .manifestPath,
        (.name // .id),
        ((.kinds | index("bar")) != null),
        ((.kinds | index("bar-widget")) != null)
      ] | @tsv
  ' | head -1)
[[ -n $source_info ]] || fail "unknown built-in plugin: $source_id"
IFS=$'\t' read -r source_dir source_manifest source_name is_bar is_bar_widget <<<"$source_info"

new_id="local.${source_id#omarchy.}"
display_name="My $source_name"
target_dir="$PLUGINS_DIR/$new_id"
[[ ! -e $target_dir && ! -L $target_dir ]] || fail "$target_dir already exists"

mkdir -p "$PLUGINS_DIR"
copy_plugin "$source_dir" "$source_manifest" "$target_dir"
clone_plugin "$target_dir" "$source_id" "$new_id" "$display_name"

omarchy-shell -q shell rescanPlugins >/dev/null
switch_to_clone "$source_id" "$new_id" "$is_bar" "$is_bar_widget"
omarchy-notification-send -g 󰐱 \
  "Editing Cloned Plugin" \
  "Original plugin has been replace by clone."
echo "Cloned $source_id to $target_dir and switched to $new_id"
