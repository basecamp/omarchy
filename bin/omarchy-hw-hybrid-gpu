#!/bin/bash

# omarchy:summary=Detect whether the system has an active hybrid GPU configuration

multiple_gpus() {
  (($(lspci | grep -cE 'VGA|3D|Display') >= 2))
}

if omarchy-cmd-present cardwire; then
  # cardwire only offers integrated mode on hybrid laptops (iGPU + offload
  # dGPU); desktops get hybrid/manual alone. When the daemon can't answer,
  # treat it like a machine without cardwire: count GPUs instead of hiding
  # hardware that is really there.
  if modes=$(timeout --kill-after=1s 1s cardwire get 2>/dev/null); then
    grep -qw integrated <<<"$modes"
  else
    multiple_gpus
  fi
else
  multiple_gpus
fi
