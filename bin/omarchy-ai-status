#!/bin/bash

# omarchy:summary=Report whether the local AI model server is ready
# omarchy:args=[--json]

set -euo pipefail
source "$OMARCHY_PATH/default/omarchy/local-ai-lib.sh"

status=$(ai_status_json)
if [[ ${1:-} == "--json" ]]; then
  jq . <<<"$status"
else
  jq -r 'if .state == "not-setup" then "not set up" elif .state == "stopped" then "stopped — \(.recipe_id)" else "\(.state) — \(.model) — \(.endpoint)" end' <<<"$status"
fi

case $(jq -r '.state' <<<"$status") in
ready) exit 0 ;;
not-setup) exit 2 ;;
*) exit 1 ;;
esac
