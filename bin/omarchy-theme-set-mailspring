#!/bin/bash

# omarchy:summary=Sync the Omarchy theme to Mailspring
# omarchy:hidden=true

# Generates a Mailspring UI theme package (omarchy-dark or omarchy-light,
# matching the theme mode) from the current palette and points Mailspring's
# automatic dark/light selection at it. Mailspring follows the system color
# scheme, which omarchy-theme-set-gnome flips per theme mode, so dark<->light
# switches restyle a running Mailspring live. Mailspring only reads config.json
# at startup and rewrites it wholesale from memory, so config is only touched
# while the app is closed.
#
# A theme can ship a hand-tuned mailspring.less in its theme directory, which
# is used verbatim instead of the generated variables (mirrors the
# chromium.theme / vscode.json per-theme override convention).

omarchy-cmd-present mailspring || exit 0
omarchy-toggle-enabled skip-mailspring-theme-changes && exit 0

MAILSPRING_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/Mailspring"
CONFIG_FILE="$MAILSPRING_DIR/config.json"
THEME_DIR="$HOME/.local/state/omarchy/current/theme"

# Only theme an instance the user has actually run at least once.
[[ -f $CONFIG_FILE ]] || exit 0

declare -A C
while IFS=$'\t' read -r key value; do
  C[$key]=$value
done < <(omarchy-theme-color --all)

MODE=${C[mode]:-dark}
[[ $MODE == "light" ]] || MODE=dark
PKG_NAME="omarchy-$MODE"
PKG_DIR="$MAILSPRING_DIR/packages/$PKG_NAME"

mkdir -p "$PKG_DIR/styles"

cat >"$PKG_DIR/package.json" <<EOF
{
  "name": "$PKG_NAME",
  "displayName": "Omarchy (${MODE^})",
  "theme": "ui",
  "version": "1.0.0",
  "description": "Generated from the current Omarchy theme palette",
  "engines": { "mailspring": "*" },
  "private": true
}
EOF

write_dark_styles() {
  # Modeled on Mailspring's stock ui-dark theme, with the Omarchy palette
  # substituted for its hardcoded colors.
  cat >"$PKG_DIR/styles/ui-variables.less" <<EOF
@import 'base/ui-variables';

// Generated by omarchy-theme-set-mailspring. Do not edit: this file is
// rewritten on every theme change. To hand-tune, ship a mailspring.less in
// the Omarchy theme directory instead.

@gray-base: #ffffff;
@gray-darker: darken(@gray-base, 13.5%);
@gray-dark: darken(@gray-base, 20%);
@gray: darken(@gray-base, 33.5%);
@gray-light: darken(@gray-base, 46.7%);
@gray-lighter: darken(@gray-base, 92.5%);
@white: ${C[darker_background]:-#0a0a0a};

@accent-primary: var(--system-accent, ${C[accent]});

@background-primary: ${C[background]};
@background-off-primary: ${C[background]};
@background-secondary: ${C[dark_background]:-${C[background]}};
@background-tertiary: ${C[muted]:-#6d7987};

@border-color-primary: lighten(@background-primary, 10%);
@border-color-secondary: lighten(@background-secondary, 10%);
@border-color-tertiary: lighten(@background-tertiary, 10%);
@border-color-divider: @border-color-secondary;

@text-color: ${C[foreground]};
@text-color-subtle: fadeout(@text-color, 20%);
@text-color-very-subtle: fadeout(@text-color, 40%);
@text-color-inverse: ${C[selection_foreground]:-#ffffff};
@text-color-inverse-subtle: fadeout(@text-color-inverse, 20%);
@text-color-inverse-very-subtle: fadeout(@text-color-inverse, 50%);
@text-color-heading: ${C[bright_foreground]:-${C[foreground]}};
@component-active-bg: @text-color;

@text-color-link: @accent-primary;
@text-color-link-hover: @accent-primary-dark;
@text-color-link-active: @accent-primary-dark;

@btn-default-bg-color: lighten(@background-primary, 5%);
@btn-border-color: fadeout(@text-color, 65%);
@dropdown-default-bg-color: ${C[lighter_background]:-${C[background]}};

@input-bg: lighten(@background-primary, 6%);
@input-border: @border-color-divider;

@list-bg: lighten(@background-primary, 7%);
@list-border: lighten(@background-primary, 9%);
@list-selected-color: @text-color-inverse;
@list-focused-color: @text-color;

@toolbar-background-color: ${C[dark_background]:-${C[background]}};
@panel-background-color: ${C[dark_background]:-${C[background]}};

.thread-icon:not(.thread-icon-unread):not(.thread-icon-star) {
  filter: invert(100%);
}
img.content-dark {
  filter: invert(100%);
}
img.content-light {
  filter: invert(100%);
}

.mail-label {
  filter: contrast(110%) brightness(85%);
}

#message-list .message-item-wrap .message-item-white-wrap {
  box-shadow: 0 0 0.5px rgba(255, 255, 255, 0.28), 0 1px 1.5px rgba(255, 255, 255, 0.08);
}

.thread-list .list-item:not(.unread):not(.selected):not(.focused) {
  color: @text-color-subtle;
}

.thread-list .list-item.thread-list-reminder-item {
  background-color: ${C[selection]};

  &.unread {
    background-color: ${C[selection]};
    &:not(.focused):not(.selected) {
      background-color: ${C[selection]};
    }
  }
}

.send-reminders-header {
  color: @accent-primary;
  background: ${C[selection]};
  border-bottom: 1px solid lighten(${C[selection]}, 10%);
}

.sheet-toolbar {
  box-shadow: none;
  border-bottom: none;
}
.sheet-toolbar-container {
  background: @panel-background-color;
}
body.is-blurred .sheet-toolbar-container {
  background: ${C[darker_background]:-#000000};
}
EOF

  # Same trick the stock ui-dark theme uses to make light HTML email readable.
  cat >"$PKG_DIR/styles/email-frame.less" <<'EOF'
.ignore-in-parent-frame {
  body {
    filter: invert(100%) hue-rotate(180deg);
    color: #111;
  }
  img {
    filter: invert(100%) hue-rotate(180deg);
  }
}
EOF
}

write_light_styles() {
  # The base ui-variables are light-oriented; only the palette needs swapping.
  # Borders, hovers, and shadows derive from these via LESS functions.
  rm -f "$PKG_DIR/styles/email-frame.less"
  cat >"$PKG_DIR/styles/ui-variables.less" <<EOF
@import 'base/ui-variables';

// Generated by omarchy-theme-set-mailspring. Do not edit: this file is
// rewritten on every theme change. To hand-tune, ship a mailspring.less in
// the Omarchy theme directory instead.

@accent-primary: var(--system-accent, ${C[accent]});

@background-primary: ${C[background]};
@background-off-primary: ${C[background]};
@background-secondary: ${C[dark_background]:-${C[background]}};

@text-color: ${C[foreground]};
@text-color-heading: ${C[foreground]};

@text-color-link: @accent-primary;
@text-color-link-hover: @accent-primary-dark;
@text-color-link-active: @accent-primary-dark;

@dropdown-default-bg-color: ${C[background]};
@input-bg: ${C[background]};
@list-bg: ${C[background]};

@toolbar-background-color: ${C[dark_background]:-${C[background]}};
@panel-background-color: ${C[dark_background]:-${C[background]}};
EOF
}

if [[ -f $THEME_DIR/mailspring.less ]]; then
  rm -f "$PKG_DIR/styles/email-frame.less"
  cp "$THEME_DIR/mailspring.less" "$PKG_DIR/styles/ui-variables.less"
elif [[ $MODE == "light" ]]; then
  write_light_styles
else
  write_dark_styles
fi

# Mailspring upstream hides its client-side window controls on win32 only; on
# a tiling compositor they are just as redundant (windows are chromeless and
# closed via compositor keybindings), and they only appear in the frameless
# "hamburger" menubar mode. Written even when a theme ships its own
# mailspring.less, since this is platform idiom rather than palette.
cat >"$PKG_DIR/styles/omarchy-linux.less" <<'EOF'
.toolbar-window-controls {
  display: none;
}
EOF

# Point Mailspring's automatic mode at the generated package, and swap the
# native Electron menu bar (grey, unthemable) for the in-app hamburger menu
# unless the user has picked a menubar style themselves. Only touch config
# while the app is closed: a running instance rewrites config.json from
# memory, restyles on the system dark/light flip anyway, and reads config
# fresh on its next launch.
if pgrep -x mailspring >/dev/null || pgrep -f 'lib/mailspring/app\.asar' >/dev/null; then
  exit 0
fi

config_tmp=$(mktemp)
if jq --arg mode "$MODE" --arg pkg "$PKG_NAME" '
  ."*".core.theme = "ui-automatic" |
  ."*".core.appearance[$mode + "ThemeName"] = $pkg |
  ."*".core.workspace.menubarStyle //= "hamburger"
' "$CONFIG_FILE" >"$config_tmp"; then
  mv "$config_tmp" "$CONFIG_FILE"
else
  rm -f "$config_tmp"
fi
