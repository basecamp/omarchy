#!/bin/bash

# omarchy:summary=Run the CBonsai screensaver with theme colors
# omarchy:hidden=true

accent_to_cbonsai_colors() {
  local hex="${1#\#}"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))

  if (( r > 200 && g < 100 )); then echo "1,3,9,11"
  elif (( g > 200 && b < 100 )); then echo "2,3,10,11"
  elif (( b > 200 )); then echo "4,3,12,11"
  elif (( r > 150 && g > 150 )); then echo "3,3,11,11"
  elif (( g > 150 && b > 150 )); then echo "6,3,14,11"
  else echo "2,3,10,11"
  fi
}

COLORS=$(accent_to_cbonsai_colors "$1")
exec cbonsai -S -k "$COLORS"
