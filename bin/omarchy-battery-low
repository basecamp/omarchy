#!/bin/bash

# omarchy:summary=Send the low battery warning notification and run battery-low hooks.
# omarchy:args=<percentage>
# omarchy:hidden=true

set -euo pipefail

source "$OMARCHY_PATH/default/bash/i18n"

if (($# != 1)); then
  echo "Usage: omarchy-battery-low <percentage>" >&2
  exit 1
fi

level=$1

omarchy-notification-send -g 󱐋 -u critical "$(omarchy_t "Time to recharge!")" "$(omarchy_t "Battery is down to %1%" "$level")" -i battery-caution -t 30000
omarchy-hook battery-low "$level"
