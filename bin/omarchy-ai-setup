#!/bin/bash

# omarchy:summary=Serve a local AI model sized to this GPU and wire it into the coding agents
# omarchy:args=[recipe] [--dry-run]
# omarchy:examples=omarchy ai setup | omarchy ai setup --dry-run | omarchy ai setup fast
# omarchy:requires-sudo=true

set -euo pipefail

state_dir="$HOME/.local/state/omarchy/local-ai"
container="omarchy-local-ai"

# Catalog resolution: explicit override, then the synced cache, then the
# shipped defaults. `omarchy ai sync` is what writes the cache.
catalog="${OMARCHY_AI_CATALOG:-$state_dir/catalog.json}"
if [[ ! -f $catalog ]]; then
  catalog="$OMARCHY_PATH/default/omarchy/local-ai.json"
fi

dry_run=false
wanted=""
for arg in "$@"; do
  if [[ $arg == "--dry-run" ]]; then
    dry_run=true
  else
    wanted=$arg
  fi
done

# The hardware question: every NVIDIA GPU's VRAM, largest first. A recipe fits
# when at least `min_gpus` cards (default 1) each carry `min_vram_mb`. AMD and
# Intel serving images are not wired up yet, so no probe means no supported GPU.
# OMARCHY_AI_GPUS=2,3 confines both the probe and the container to a GPU
# subset — the escape hatch for boxes that share their GPUs with other work.
mapfile -t vram_list < <(
  if [[ -n ${OMARCHY_AI_VRAM_MB:-} ]]; then
    printf '%s\n' "$OMARCHY_AI_VRAM_MB"
  elif omarchy-cmd-present nvidia-smi; then
    nvidia-smi ${OMARCHY_AI_GPUS:+-i "$OMARCHY_AI_GPUS"} --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null
  fi | grep -E '^[0-9]+$' | sort -rn || true)
if ((${#vram_list[@]} == 0)); then
  echo "No NVIDIA GPU found. Local AI currently needs an NVIDIA GPU with at least 24 GB of VRAM." >&2
  exit 1
fi
vram_mb=${vram_list[0]}
vrams_json=$(printf '%s\n' "${vram_list[@]}" | jq -Rn '[inputs | tonumber]')

fit_filter='([$vrams[] | select(. >= $r.min_vram_mb)] | length) >= ($r.min_gpus // 1)'
if [[ -n $wanted ]]; then
  recipe=$(jq --arg name "$wanted" 'first(.recipes[] | select(.name == $name)) // empty' "$catalog")
  if [[ -z $recipe ]]; then
    echo "No recipe named \"$wanted\". Known recipes:" >&2
    jq -r '.recipes[].name | "  " + .' "$catalog" >&2
    exit 1
  fi
  if ! jq --argjson vrams "$vrams_json" -e ". as \$r | $fit_filter" <<<"$recipe" >/dev/null; then
    echo "\"$wanted\" needs $(jq -r '.min_gpus // 1' <<<"$recipe")× $(($(jq -r '.min_vram_mb' <<<"$recipe") / 1024)) GB GPUs; this box has ${#vram_list[@]}× $((vram_mb / 1024)) GB (largest)." >&2
    exit 1
  fi
else
  recipe=$(jq --argjson vrams "$vrams_json" \
    "[.recipes[] | . as \$r | select($fit_filter)] | sort_by([-.min_vram_mb, -(.min_gpus // 1), .name]) | .[0] // empty" "$catalog")
  if [[ -z $recipe ]]; then
    echo "This GPU has $((vram_mb / 1024)) GB of VRAM; the smallest local AI recipe needs 24 GB." >&2
    exit 1
  fi
fi

# A recipe scales itself to the hardware: the largest `scale` key the
# qualifying-GPU count reaches is merged over the base recipe, so one entry
# covers 1, 2, and 4 GPUs instead of shipping a variant per box.
fitting=$(jq --argjson vrams "$vrams_json" '. as $r | [$vrams[] | select(. >= $r.min_vram_mb)] | length' <<<"$recipe")
recipe=$(jq --argjson n "$fitting" \
  '((.scale // {}) | to_entries | map(select((.key | tonumber) <= $n)) | sort_by(.key | tonumber) | last | .value // {}) as $step
   | del(.scale) * $step' <<<"$recipe")

port=$(jq -r '.port' "$catalog")
name=$(jq -r '.name' <<<"$recipe")
label=$(jq -r '.label' <<<"$recipe")
image=$(jq -r '.image' <<<"$recipe")
model=$(jq -r '.model // ""' <<<"$recipe")
weights_gb=$(jq -r '.weights_gb // ""' <<<"$recipe")
served_name=$(jq -r '.served_name // ""' <<<"$recipe")
context=$(jq -r '.context_window // 8192' <<<"$recipe")
thinking_format=$(jq -r '.thinking_format // "openai"' <<<"$recipe")
reasoning=$(jq -r '.reasoning // false' <<<"$recipe")
vision=$(jq -r '.vision // false' <<<"$recipe")
container_port=$(jq -r '.container_port // 8000' <<<"$recipe")
mapfile -t engine_args < <(jq -r '.args[]?' <<<"$recipe")
mapfile -t run_args < <(jq -r '.run_args[]?' <<<"$recipe")
mapfile -t env_pairs < <(jq -r '(.env // {}) | to_entries[] | "\(.key)=\(.value)"' <<<"$recipe")
mapfile -t volume_pairs < <(jq -r '(.volumes // {}) | to_entries[] | "\(.key):\(.value)"' <<<"$recipe")

docker_args=(run --detach --name "$container" --restart unless-stopped
  --gpus "${OMARCHY_AI_GPUS:+device=$OMARCHY_AI_GPUS}")
docker_args[${#docker_args[@]}-1]=${docker_args[-1]:-all}
docker_args+=(--publish "127.0.0.1:$port:$container_port")
docker_args+=("${run_args[@]}")
for pair in "${env_pairs[@]}"; do
  docker_args+=(--env "$pair")
done
for pair in "${volume_pairs[@]}"; do
  docker_args+=(--volume "${pair/#\~/$HOME}")
done
docker_args+=("$image")
docker_args+=("${engine_args[@]}")

if $dry_run; then
  echo "docker ${docker_args[*]}"
  exit 0
fi

echo "This GPU has $((vram_mb / 1024)) GB of VRAM, serving: $label"

# The runtime, bootstrapped in order: docker itself, a running daemon, then
# the NVIDIA hook that `--gpus` needs. Each is a one-time step.
if omarchy-cmd-missing docker; then
  echo "Installing Docker..."
  omarchy-pkg-add docker
  sudo systemctl enable --now docker.service
fi
if ! docker info &>/dev/null; then
  sudo systemctl enable --now docker.service
  if ! docker info &>/dev/null; then
    sudo usermod -aG docker "$USER"
    echo "Added you to the docker group. Log out and back in, then rerun: omarchy ai setup" >&2
    exit 1
  fi
fi
if ! omarchy-pkg-present nvidia-container-toolkit; then
  echo "Installing the NVIDIA container toolkit..."
  omarchy-pkg-add nvidia-container-toolkit
  sudo systemctl restart docker
fi

if [[ -n $(docker ps --all --quiet --filter "name=^$container$") ]]; then
  docker rm --force "$container" >/dev/null
fi

echo "Starting the model server (pulls the engine image on first run)..."
docker "${docker_args[@]}" >/dev/null

echo "Waiting for the model to load (~${weights_gb:-"several"} GB download on first run)..."
echo "Follow along in another terminal with: omarchy ai logs"
for ((elapsed = 0; ; elapsed += 5)); do
  if curl --fail --silent "http://127.0.0.1:$port/v1/models" &>/dev/null; then
    break
  fi
  if [[ $(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null) != "true" ]]; then
    # The restart policy briefly reports not-running mid-restart; only a state
    # that persists across a grace recheck is a real exit.
    sleep 6
    if [[ $(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null) != "true" ]]; then
      echo "The model server exited before becoming ready. Check: omarchy ai logs" >&2
      exit 1
    fi
  fi
  # A crash-looping server flickers back to Running between checks; the
  # restart count catches what the liveness check misses.
  if (( $(docker inspect --format '{{.RestartCount}}' "$container" 2>/dev/null || echo 0) > 2 )); then
    echo "The model server keeps crashing on startup. Check: omarchy ai logs" >&2
    docker rm --force "$container" >/dev/null
    exit 1
  fi
  if ((elapsed >= 7200)); then
    echo "The model server is still not ready after two hours. Check: omarchy ai logs" >&2
    exit 1
  fi
  sleep 5
done

reply=$(curl --fail --silent --max-time 300 "http://127.0.0.1:$port/v1/chat/completions" \
  --header "Content-Type: application/json" \
  --data "$(jq -n --arg model "$served_name" '{model: $model, messages: [{role: "user", content: "Reply with the single word: ready"}]}')")
if ! jq -e '.choices[0].message.content | length > 0' <<<"$reply" >/dev/null; then
  echo "The model server did not answer a chat completion: $reply" >&2
  exit 1
fi

endpoint="http://127.0.0.1:$port/v1"

# pi and omp share the ~/.<agent>/agent/{models,settings}.json layout. The
# local provider is merged in surgically; the default provider is only claimed
# when the agent has none, so an existing choice survives re-setup.
wire_agent() {
  local dir="$HOME/.$1/agent"
  mkdir -p "$dir"
  local provider
  provider=$(jq -n --arg url "$endpoint" --arg id "$served_name" --arg label "$label" \
    --arg thinking "$thinking_format" --argjson ctx "$context" \
    --argjson reasoning "$reasoning" --argjson vision "$vision" '{
      baseUrl: $url,
      apiKey: "local",
      api: "openai-completions",
      models: [{
        id: $id,
        name: "\($label) (local)",
        reasoning: $reasoning,
        input: (if $vision then ["text", "image"] else ["text"] end),
        contextWindow: $ctx,
        maxTokens: $ctx,
        cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0},
        compat: {
          supportsDeveloperRole: false,
          supportsReasoningEffort: false,
          thinkingFormat: $thinking,
          maxTokensField: "max_tokens",
          supportsStore: false,
          supportsStrictMode: false,
          supportsUsageInStreaming: false
        }
      }]
    }')
  jq --argjson provider "$provider" '.providers.local = $provider' \
    <<<"$(cat "$dir/models.json" 2>/dev/null || echo '{}')" >"$dir/models.json"
  # Claim the default when the agent has none; keep our own default current
  # across model switches; never touch a foreign provider choice.
  jq --arg model "$served_name" \
    'if .defaultProvider == null or .defaultProvider == "local"
     then .defaultProvider = "local" | .defaultModel = $model else . end' \
    <<<"$(cat "$dir/settings.json" 2>/dev/null || echo '{}')" >"$dir/settings.json"
}

if [[ -n $served_name ]]; then
  wire_agent pi
  wire_agent omp
fi

mkdir -p "$state_dir"
jq -n --arg name "$name" --arg label "$label" --arg model "$model" --arg image "$image" \
  --arg served "$served_name" --argjson port "$port" --argjson context "$context" \
  '{name: $name, label: $label, model: $model, served_name: $served, image: $image, port: $port, context_window: $context}' \
  >"$state_dir/recipe.json"

omarchy-bar put omarchy.local-ai --after omarchy.system-update &>/dev/null || true
omarchy-shell -q omarchy.local-ai refresh || true
omarchy-notification-send -g 󰚩 "Local AI ready" "$label is serving on port $port"

cat <<SUMMARY

Local AI is ready.

  Model     $label
  Endpoint  $endpoint (OpenAI-compatible)
  Agents    pi and omp gained a "local" provider

The robot icon in the top bar opens the Local AI panel; right-click it to
load and unload, or use "omarchy ai start" and "omarchy ai stop".
SUMMARY

if [[ -z $(omarchy-default-agent) ]]; then
  echo
  echo "No default agent is set yet. Point Omarchy at pi with: omarchy default agent pi"
fi
