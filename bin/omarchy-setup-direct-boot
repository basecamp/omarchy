#!/bin/bash

# omarchy:summary=Add or remove an EFI boot entry for the Omarchy UKI, allowing the system to boot directly
# omarchy:requires-sudo=true

if [[ ! -d /sys/firmware/efi ]]; then
  echo "Error: System is not booted in UEFI mode" >&2
  exit 1
fi

if ! efibootmgr &>/dev/null; then
  echo "Error: efibootmgr is not available or not functional" >&2
  exit 1
fi

bios_vendor=$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)

case "${bios_vendor,,}" in
  *"american megatrends"*)
    echo "Error: American Megatrends firmware may not safely support custom EFI entries" >&2
    exit 1
    ;;
  *apple*)
    echo "Error: Apple firmware uses its own boot manager" >&2
    exit 1
    ;;
esac

format_kernel_name() {
  local file="$1"
  local name="${file%.efi}"
  name="${name#omarchy_}"
  name="${name#omarchy-}"
  name=$(echo "$name" | sed -E 's/^[0-9a-f]{32}[_-]//')

  if [[ $name =~ (.*)[_-]fallback$ ]]; then
    echo "${BASH_REMATCH[1]} (fallback)"
  else
    echo "$name"
  fi
}

existing_entry=$(efibootmgr | grep -E "^Boot[0-9A-Fa-f]+\*? Omarchy([[:space:]]|$)" | head -1)
boot_num=""

if [[ -n $existing_entry ]]; then
  boot_num=$(echo "$existing_entry" | sed -n 's/^Boot\([0-9A-Fa-f]\+\).*/\1/p')

  action=$(gum choose "Change kernel" "Disable direct boot" --header "Direct boot is currently enabled (Boot$boot_num)") || exit 0

  if [[ $action == "Disable direct boot" ]]; then
    echo "Removing EFI boot entry $boot_num"
    sudo efibootmgr --bootnum "$boot_num" --delete-bootnum >/dev/null
    exit 0
  fi
fi

mapfile -t uki_files < <(sudo find /boot/EFI/Linux/ -maxdepth 1 -name "omarchy*.efi" -printf "%f\n" 2>/dev/null | sort)
if (( ${#uki_files[@]} == 0 )); then
  mapfile -t uki_files < <(sudo find /boot/EFI/Linux/ -maxdepth 1 -name "*.efi" -printf "%f\n" 2>/dev/null | sort)
fi

if (( ${#uki_files[@]} == 0 )); then
  echo "Error: No Omarchy UKI found in /boot/EFI/Linux/" >&2
  exit 1
fi

if (( ${#uki_files[@]} == 1 )); then
  selected_uki="${uki_files[0]}"
  kernel_display=$(format_kernel_name "$selected_uki")
else
  options=()
  default_choice=""
  for file in "${uki_files[@]}"; do
    kname=$(format_kernel_name "$file")
    opt="$kname ($file)"
    options+=("$opt")
    if [[ -z $default_choice && $kname == "linux" ]]; then
      default_choice="$opt"
    fi
  done

  if [[ -z $default_choice ]]; then
    default_choice="${options[0]}"
  fi

  choice=$(printf "%s\n" "${options[@]}" | gum choose --header "Select Linux kernel for direct boot:" --selected "$default_choice") || exit 0
  selected_uki=$(echo "$choice" | sed -n 's/.*(\([^()]*\))$/\1/p')
  if [[ -z $selected_uki ]]; then
    selected_uki="$choice"
  fi
  kernel_display=$(format_kernel_name "$selected_uki")
fi

boot_source=$(findmnt -n -o SOURCE /boot)
disk=$(echo "$boot_source" | sed 's/p\?[0-9]*$//')
part=$(echo "$boot_source" | grep -o 'p\?[0-9]*$' | sed 's/^p//')

if gum confirm "Setup direct boot with $kernel_display (so snapshot booting must be done via bios)?"; then
  if [[ -n $boot_num ]]; then
    echo "Removing existing EFI boot entry $boot_num"
    sudo efibootmgr --bootnum "$boot_num" --delete-bootnum >/dev/null
  fi

  echo "Creating EFI boot entry for $selected_uki"

  sudo efibootmgr --create \
    --disk "$disk" \
    --part "$part" \
    --label "Omarchy" \
    --loader "\\EFI\\Linux\\$selected_uki"
fi
