#!/bin/bash

# omarchy:summary=Run the neo-matrix screensaver with theme colors
# omarchy:hidden=true

accent_to_neo_color() {
  local hex="${1#\#}"
  local r=$((16#${hex:0:2}))
  local g=$((16#${hex:2:2}))
  local b=$((16#${hex:4:2}))

  if (( r > 200 && g < 100 && b < 100 )); then echo "red"
  elif (( g > 200 && r < 100 && b < 100 )); then echo "green"
  elif (( b > 200 && r < 100 && g < 100 )); then echo "blue"
  elif (( r > 150 && g > 150 && b < 100 )); then echo "yellow"
  elif (( r > 150 && b > 150 && g < 100 )); then echo "purple"
  elif (( g > 150 && b > 150 && r < 100 )); then echo "cyan"
  elif (( r > 180 && g > 100 && b < 80 )); then echo "orange"
  else echo "green"
  fi
}

COLOR=$(accent_to_neo_color "$1")
exec neo -c "$COLOR" --charset=katakana -D --screensaver
