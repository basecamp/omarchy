#!/bin/bash

# omarchy:summary=Show, set, or adjust Hyprland monitor scaling
# omarchy:args=[--monitor name] [up|down|SCALE]
# omarchy:examples=omarchy hyprland monitor scaling | omarchy hyprland monitor scaling 1.6 | omarchy hyprland monitor scaling --monitor DP-1 2 | omarchy hyprland monitor scaling up

SCALES=(1 1.25 1.6 2 3 4)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
SCALE_LOG="$STATE_DIR/monitor-scaling.log"

# Empty means "whichever display has focus", which is what every caller wanted
# before the panel grew a display selector.
monitor=""

usage() {
  echo "Usage: omarchy-hyprland-monitor-scaling [--monitor name] [up|down|SCALE]"
}

while [[ ${1:-} == "--monitor" ]]; do
  if (($# < 2)); then
    usage >&2
    exit 1
  fi
  monitor="$2"
  shift 2
done

# An unresolvable name would leave the monitor selector empty, and an empty
# `output` is Hyprland's catch-all — it would rescale every display instead of
# none. Refuse up front rather than letting that through.
if [[ -n $monitor ]] &&
  ! hyprctl monitors -j | jq -e --arg name "$monitor" 'any(.[]; .name == $name)' >/dev/null; then
  echo "No such active display: $monitor" >&2
  exit 1
fi

# The monitor the rest of this script acts on, as a jq selector over the
# monitor list.
target_monitor_json() {
  if [[ -n $monitor ]]; then
    hyprctl monitors -j | jq -e -c --arg name "$monitor" '.[] | select(.name == $name)'
  else
    hyprctl monitors -j | jq -e -c '.[] | select(.focused == true)'
  fi
}

target_monitor_scale() {
  target_monitor_json | jq -er '.scale'
}

cmdline_for_pid() {
  local pid="$1"

  [[ -r /proc/$pid/cmdline ]] || return 0
  tr '\0\t\n' '   ' <"/proc/$pid/cmdline" | sed -E 's/[[:space:]]+/ /g; s/[[:space:]]+$//'
}

audit_scale_change() {
  local requested="$1"
  local active_monitor="$2"
  local current_scale="$3"
  local new_scale="$4"
  local parent_pid="$PPID"
  local grandparent_pid
  local parent_cmd
  local grandparent_cmd

  mkdir -p "$STATE_DIR" || return 0

  grandparent_pid=$(ps -o ppid= -p "$parent_pid" 2>/dev/null | tr -d ' ')
  parent_cmd=$(cmdline_for_pid "$parent_pid")
  grandparent_cmd=$(cmdline_for_pid "$grandparent_pid")

  printf 'at=%s\trequested=%s\tcurrent=%s\tnew=%s\tmonitor=%s\tpid=%s\tppid=%s\tparent=%s\tgppid=%s\tgrandparent=%s\n' \
    "$(date --iso-8601=seconds)" \
    "$requested" \
    "$current_scale" \
    "$new_scale" \
    "$active_monitor" \
    "$$" \
    "$parent_pid" \
    "$parent_cmd" \
    "$grandparent_pid" \
    "$grandparent_cmd" >>"$SCALE_LOG"
}

# Hyprland only accepts scales where the mode divides into whole logical
# pixels (in 1/120 steps), so clean scales are divisors of gcd(w*120, h*120).
# Round the requested scale up to the nearest clean value.
clean_scale() {
  awk -v scale="$1" -v width="$2" -v height="$3" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    BEGIN {
      g = gcd(width * 120, height * 120)
      k = int(scale * 120 + 0.5)
      if (k > g) k = g
      while (g % k != 0) k++
      printf "%g\n", k / 120
    }'
}

normalize_scale() {
  awk 'NR == 1 { printf "%g\n", $0 }'
}

monitor_lua() {
  echo "$HOME/.config/hypr/monitors.lua"
}

# The line holding the rule that governs this display, or nothing when the user
# has not written one. Comments are cut before matching, because the shipped
# config carries commented examples that otherwise read as rules. The catch-all
# is skipped: it describes every display, so it is nobody's own rule. A `desc:`
# identifier matches by prefix, the way Hyprland matches it, so the abbreviated
# descriptions people actually write still resolve.
display_rule_line() {
  local name="$1" description="$2" lua

  lua="$(monitor_lua)"
  [[ -f $lua ]] || return 0

  awk -v name="$name" -v description="$description" '
    { line = $0; sub(/--.*/, "", line) }
    line !~ /hl\.monitor/ { next }
    match(line, /output[[:space:]]*=[[:space:]]*"[^"]*"/) {
      id = substr(line, RSTART, RLENGTH)
      sub(/^output[[:space:]]*=[[:space:]]*"/, "", id)
      sub(/"$/, "", id)
      if (id == "") next
      if (id == name) { print NR; exit }
      if (index(id, "desc:") == 1 && description != "" && index(description, substr(id, 6)) == 1) { print NR; exit }
    }
  ' "$lua"
}

# Rewrite one rule's scale and nothing else, so the mode, the position and the
# identifier the user chose all survive. A rule naming no scale gains one; a
# rule whose scale is a variable reference gets the literal, since the value the
# user just picked is not the one the variable stands for.
set_rule_scale() {
  local line="$1" scale="$2" lua

  lua="$(monitor_lua)"

  awk -v target="$line" -v scale="$scale" '
    NR != target { print; next }
    {
      if (match($0, /scale[[:space:]]*=[[:space:]]*("[^"]*"|[^,;)}[:space:]]+)/)) {
        printf "%s%s%s\n", substr($0, 1, RSTART - 1), "scale = " scale, substr($0, RSTART + RLENGTH)
      } else if (match($0, /}[[:space:]]*\)/)) {
        prefix = substr($0, 1, RSTART - 1)
        sub(/[[:space:]]+$/, "", prefix)
        printf "%s, scale = %s %s\n", prefix, scale, substr($0, RSTART)
      } else {
        print
      }
    }
  ' "$lua" >"$lua.tmp" && mv "$lua.tmp" "$lua"
}

# GDK_SCALE is one value for the whole session, so only a change to the display
# the user is actually on gets to redefine it.
set_gdk_scale() {
  local gdk_scale="$1" lua

  lua="$(monitor_lua)"

  if grep -q '^local omarchy_gdk_scale = ' "$lua"; then
    sed -i -E "s|^local omarchy_gdk_scale = .*|local omarchy_gdk_scale = ${gdk_scale}|" "$lua"
  else
    sed -i -E 's|^hl\.env\("GDK_SCALE", ".*"\)|hl.env("GDK_SCALE", "'"$gdk_scale"'")|' "$lua"
  fi
}

set_scale() {
  local requested_scale="$1"
  local requested="${2:-$requested_scale}"
  local monitor_info="$(target_monitor_json)"
  local active_monitor="$(echo "$monitor_info" | jq -r '.name')"
  local target_focused="$(echo "$monitor_info" | jq -r '.focused')"
  local target_description="$(echo "$monitor_info" | jq -r '.description // ""')"
  local current_scale="$(echo "$monitor_info" | jq -r '.scale')"
  local width="$(echo "$monitor_info" | jq -r '.width')"
  local height="$(echo "$monitor_info" | jq -r '.height')"
  local refresh_rate="$(echo "$monitor_info" | jq -r '.refreshRate')"
  local new_scale="$(clean_scale "$requested_scale" "$width" "$height")"
  # GTK only honors integer GDK_SCALE values, so persist the nearest whole
  # factor even when the monitor scale itself is fractional.
  local new_gdk_scale="$(awk -v scale="$new_scale" 'BEGIN { printf "%d", int(scale + 0.5) }')"
  local monitor_lua="$HOME/.config/hypr/monitors.lua"

  # `position = "auto"` lets Hyprland place the displays, as it always has here.
  # A display's logical size changes with its scale, so deciding where the others
  # should move to afterwards means re-deriving a layout from geometry the
  # compositor already holds. Someone who wants a fixed arrangement writes it in
  # monitors.lua, and the rule this persists to leaves their position alone.
  hyprctl eval "hl.monitor({ output = \"$active_monitor\", mode = \"${width}x${height}@${refresh_rate}\", position = \"auto\", scale = $new_scale })" >/dev/null
  audit_scale_change "$requested" "$active_monitor" "$current_scale" "$new_scale"

  # Persist to monitors.lua, so the scale survives a reboot. Writing the config
  # reloads Hyprland, which re-applies every rule — so a write that does not
  # describe what was just applied does not merely fail to persist, it undoes
  # the change a second after it was made.
  [[ -f $monitor_lua ]] || return 0

  local rule_line
  rule_line="$(display_rule_line "$active_monitor" "$target_description")"

  if [[ -n $rule_line ]]; then
    # A rule of the display's own overrides the catch-all, so the catch-all is
    # the wrong thing to write: Hyprland would keep applying the rule and the
    # new scale would never take effect.
    set_rule_scale "$rule_line" "$new_scale"
  elif [[ $target_focused == "true" ]]; then
    # Nothing describes this display on its own and the user is on it, so the
    # generic default is theirs to move — which is what Omarchy has always done.
    if grep -q '^local omarchy_monitor_scale = ' "$monitor_lua"; then
      sed -i -E "s|^local omarchy_monitor_scale = .*|local omarchy_monitor_scale = ${new_scale}|" "$monitor_lua"
    elif grep -Eq '^hl\.monitor\(\{ output = "", mode = "preferred", position = "auto", scale = ("auto"|[0-9.]+) \}\)' "$monitor_lua"; then
      sed -i -E "s|^(hl\.monitor\(\{ output = \"\", mode = \"preferred\", position = \"auto\", scale = )([^ ]+)( \}\))|\\1${new_scale}\\3|" "$monitor_lua"
    else
      return 0
    fi
  else
    # A display the user is not on, following a catch-all that speaks for every
    # display. Moving that would resize the rest, so give this one a rule of its
    # own instead. `preferred` and `auto` are what the catch-all was already
    # giving it, so the scale is the only thing that changes.
    # A file whose last line has no newline would otherwise take the rule onto
    # the end of that line, and a config that does not parse takes the whole
    # session's monitor configuration with it.
    [[ -s $monitor_lua && -n $(tail -c1 "$monitor_lua") ]] && printf '\n' >>"$monitor_lua"

    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = %s })\n' \
      "$active_monitor" "$new_scale" >>"$monitor_lua"
    return 0
  fi

  [[ $target_focused == "true" ]] && set_gdk_scale "$new_gdk_scale"

  return 0
}

scale_from_current() {
  local direction="${1:-}"
  local width="${2:-}"
  local height="${3:-}"

  awk -v direction="$direction" -v list="${SCALES[*]}" -v width="$width" -v height="$height" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    function clean(scale,    g, k) {
      g = gcd(width * 120, height * 120)
      k = int(scale * 120 + 0.5)
      if (k > g) k = g
      while (g % k != 0) k++
      return k / 120
    }
    NR == 1 { scale = $0; found = 1 }
    END {
      if (!found) exit 1

      preset_count = split(list, presets, " ")
      for (i = 1; i <= preset_count; i++) {
        effective = clean(presets[i])
        key = sprintf("%.8f", effective)
        distance = presets[i] - effective
        if (distance < 0) distance = -distance

        # Multiple presets can collapse to the same clean scale. Keep only the
        # closest label so stepping always moves to a distinct effective value.
        if (!(key in effective_index)) {
          effective_index[key] = ++n
          effective_scales[n] = effective
          scales[n] = presets[i]
          distances[n] = distance
        } else {
          idx = effective_index[key]
          if (distance < distances[idx]) {
            scales[idx] = presets[i]
            distances[idx] = distance
          }
        }
      }

      # Snap to the nearest effective scale first. Hyprland reports floating
      # point values, so exact comparisons can otherwise get stuck.
      best = 1; best_diff = 1e9
      for (i = 1; i <= n; i++) {
        diff = scale - effective_scales[i]; if (diff < 0) diff = -diff
        if (diff < best_diff) { best_diff = diff; best = i }
      }

      if (direction == "next") {
        print scales[(best < n ? best + 1 : n)]
      } else if (direction == "previous") {
        print scales[(best > 1 ? best - 1 : 1)]
      } else {
        print scales[best]
      }
    }'
}

case "${1:-}" in
"")
  target_monitor_scale | normalize_scale
  ;;
-h | --help)
  usage
  ;;
up)
  monitor_info=$(target_monitor_json)
  set_scale "$(echo "$monitor_info" | jq -r '.scale' | scale_from_current next \
    "$(echo "$monitor_info" | jq -r '.width')" "$(echo "$monitor_info" | jq -r '.height')")" "up"
  ;;
down)
  monitor_info=$(target_monitor_json)
  set_scale "$(echo "$monitor_info" | jq -r '.scale' | scale_from_current previous \
    "$(echo "$monitor_info" | jq -r '.width')" "$(echo "$monitor_info" | jq -r '.height')")" "down"
  ;;
1 | 1.25 | 1.6 | 2 | 3 | 4)
  set_scale "$1" "$1"
  ;;
*)
  if [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] &&
    awk -v scale="$1" 'BEGIN { exit !(scale >= 1 && scale <= 4) }'; then
    set_scale "$1" "$1"
  else
    usage >&2
    exit 1
  fi
  ;;
esac
