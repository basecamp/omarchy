#!/bin/bash

# omarchy:summary=Show a Hermes one-shot result and accept typed follow-ups
# omarchy:args=<prompt>
# omarchy:hidden=true

set -u

if (($# != 1)); then
  echo "Usage: omarchy-agent-hermes-prompt <prompt>" >&2
  exit 1
fi

status=0
session_id=""

# One-line heads-up before the first call: a full diagnosis takes minutes and
# Hermes one-shot mode prints nothing until it finishes, so an unexplained
# blank window reads as a hang. This line is what makes the wait legible.
echo "Diagnosing with Hermes — this may take a few minutes."

# The first call uses single-query mode with the same auto-bypass approval
# semantics as `hermes -z`. Output is teed so Hermes' live progress (agent
# startup, reasoning, tool activity) streams to the window instead of being
# buffered until the end, and the session id is captured for follow-ups.
run_turn() {
  local question=$1
  shift
  local tmp
  tmp=$(mktemp)
  hermes chat -q "$question" --yolo "$@" 2>&1 | tee "$tmp"
  status=${PIPESTATUS[0]}
  if [[ -z $session_id ]]; then
    session_id=$(sed -n -E 's/^(session_id|Session):[[:space:]]*([A-Za-z0-9_-]+).*/\2/p' "$tmp" | tail -1)
  fi
  rm -f "$tmp"
}

run_turn "$1"

while true; do
  printf 'Ask a follow-up, or press Enter to close: '
  read -r followup || { printf '\n'; break; }
  [[ -n $followup ]] || break

  if [[ -n $session_id ]]; then
    run_turn "$followup" --resume "$session_id"
  else
    run_turn "$followup"
  fi
done

if ((status != 0)); then
  echo "Hermes exited with status $status. Press Enter to close." >&2
  read -r || true
fi

exit "$status"
