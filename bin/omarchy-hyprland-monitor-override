#!/bin/bash

# omarchy:summary=Read and write the persisted per-display Hyprland overrides
# omarchy:args=<get|set|clear|is-disabled|clear-disabled|key|render> <display> [property] [value]
# omarchy:examples=omarchy hyprland monitor override set DP-1 disabled true | omarchy hyprland monitor override clear DP-1 disabled

# Displays switched off at runtime, recorded outside the user's config in the
# toggles directory Omarchy has always kept such state in. Geometry is not here:
# position, scale and rotation are written to the user's own monitors.lua, which
# is where they write them too. Two files describing one display means whichever
# Hyprland loads last silently wins, and a config edit stops taking effect with
# nothing to say why.
#
# Displays are keyed by EDID description where they report one, so a setting
# follows the display rather than the port it happens to be plugged into. A
# display with no description falls back to its connector name.
#
# Rules are written self-contained rather than relying on Hyprland merging them
# into the user's: Hyprland merges per identifier, so a desc-keyed rule does not
# inherit position from a name-keyed one and the display would be re-placed.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
STATE="$STATE_DIR/display-overrides.json"
RULES="$STATE_DIR/toggles/hypr/display-overrides.lua"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-display-overrides.lock"

usage() {
  echo "Usage: omarchy-hyprland-monitor-override <get|set|clear|is-disabled|clear-disabled|key|render> <display> [property] [value]" >&2
}

# Properties this command knows how to persist, and how each renders in Lua.
# Anything else is refused rather than written blind.
property_is_known() {
  case $1 in
    disabled) return 0 ;;
    *) return 1 ;;
  esac
}

monitors_json() {
  hyprctl monitors all -j 2>/dev/null || echo '[]'
}

# The stable identity for a display: its EDID description when it has one,
# otherwise the connector name. This is used verbatim as the rule's `output`.
override_key() {
  local name="$1" description
  description="$(monitors_json | jq -r --arg name "$name" '[.[] | select(.name == $name)][0].description // ""')"

  if [[ -n $description ]]; then
    printf 'desc:%s\n' "$description"
  else
    printf '%s\n' "$name"
  fi
}

read_state() {
  [[ -s $STATE ]] && jq -e . "$STATE" 2>/dev/null || echo '{}'
}

# Entries record the connector they were written for, so a lookup still
# resolves when hyprctl cannot answer. The boot-time rescue runs before the
# graphical session and has no compositor to ask.
existing_key_for() {
  local name="$1"

  [[ -n $name ]] || return 0
  read_state | jq -r --arg name "$name" 'to_entries[] | select(.value.name == $name) | .key' | head -1
}

# Prefer the key an entry already uses, so a display never ends up recorded
# twice under both its description and its connector name.
resolve_key() {
  local name="$1" key

  key="$(existing_key_for "$name")"
  if [[ -n $key ]]; then
    printf '%s\n' "$key"
    return 0
  fi

  override_key "$name"
}

# Where a display's disable used to be recorded, before every setting moved
# into one file. Recovery has to clear all of them, so an un-migrated,
# half-migrated, and fully migrated machine all come back the same way — a
# laptop panel left dark with no external display is only recoverable if the
# path that rescues it cannot miss.
legacy_disable_files() {
  local name="$1"

  [[ -n $name ]] || return 0

  printf '%s\n' "$STATE_DIR/toggles/hypr/monitor-$name-disable.lua"
  if [[ $name =~ ^(eDP|LVDS|DSI)- ]]; then
    printf '%s\n' "$STATE_DIR/toggles/hypr/internal-monitor-disable.lua"
  fi
}

display_is_disabled() {
  local name="$1" file

  [[ -n $name ]] || return 1

  while read -r file; do
    [[ -f $file ]] && return 0
  done < <(legacy_disable_files "$name")

  [[ $(read_state | jq -r --arg key "$(resolve_key "$name")" '.[$key].disabled // false') == "true" ]]
}

clear_display_disabled() {
  local name="$1" file

  [[ -n $name ]] || return 0

  while read -r file; do
    rm -f "$file"
  done < <(legacy_disable_files "$name")

  clear_property "$(resolve_key "$name")" disabled
  render
}

# Regenerate the Hyprland rules from the state file. A disabled display needs
# nothing but the flag; anything else carries mode and position alongside scale
# so the rule stands on its own.
render() {
  mkdir -p "$(dirname "$RULES")"

  {
    echo "-- Generated by omarchy-hyprland-monitor-override. Do not edit."
    echo "-- Per-display settings live in $STATE"
    read_state | jq -r '
      to_entries[]
      | select(.value.disabled == true)
      | "hl.monitor({ output = \"\(.key)\", disabled = true })"
    '
  } >"$RULES.tmp"

  mv "$RULES.tmp" "$RULES"
}

write_property() {
  local key="$1" property="$2" value="$3" name="$4"
  local state

  state="$(read_state)"

  if [[ -n $name ]]; then
    state="$(printf '%s' "$state" | jq --arg key "$key" --arg name "$name" '.[$key] = ((.[$key] // {}) + { name: $name })')"
  fi

  case $property in
    disabled)
      state="$(printf '%s' "$state" | jq --arg key "$key" --arg property "$property" --argjson value "$value" \
        '.[$key] = ((.[$key] // {}) + { ($property): $value })')"
      ;;
    *)
      state="$(printf '%s' "$state" | jq --arg key "$key" --arg property "$property" --arg value "$value" \
        '.[$key] = ((.[$key] // {}) + { ($property): $value })')"
      ;;
  esac

  mkdir -p "$STATE_DIR"
  printf '%s\n' "$state" >"$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

clear_property() {
  local key="$1" property="$2"
  local state

  state="$(read_state)"

  if [[ -n $property ]]; then
    state="$(printf '%s' "$state" | jq --arg key "$key" --arg property "$property" 'if has($key) then .[$key] |= del(.[$property]) else . end')"
  else
    state="$(printf '%s' "$state" | jq --arg key "$key" 'del(.[$key])')"
  fi

  # Drop displays with nothing left to say. `name` is bookkeeping for lookups,
  # so an entry carrying only that is empty.
  state="$(printf '%s' "$state" | jq 'with_entries(select(.value | del(.name) | length > 0))')"

  mkdir -p "$STATE_DIR"
  printf '%s\n' "$state" >"$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

action="${1:-}"
display="${2:-}"
property="${3:-}"
value="${4:-}"

case $action in
  render)
    exec 9>"$LOCK"
    flock 9
    render
    ;;
  key)
    [[ -n $display ]] || {
      usage
      exit 1
    }
    override_key "$display"
    ;;
  is-disabled)
    [[ -n $display ]] || {
      usage
      exit 1
    }
    display_is_disabled "$display"
    ;;
  clear-disabled)
    [[ -n $display ]] || {
      usage
      exit 1
    }
    exec 9>"$LOCK"
    flock 9
    clear_display_disabled "$display"
    ;;
  get)
    [[ -n $display && -n $property ]] || {
      usage
      exit 1
    }
    read_state | jq -r --arg key "$(resolve_key "$display")" --arg property "$property" \
      '.[$key][$property] // "" | tostring' | grep -v '^$' || true
    ;;
  set)
    [[ -n $display && -n $property && -n $value ]] || {
      usage
      exit 1
    }
    property_is_known "$property" || {
      echo "Unknown display property: $property" >&2
      exit 1
    }
    exec 9>"$LOCK"
    flock 9
    write_property "$(resolve_key "$display")" "$property" "$value" "$display"
    render
    ;;
  clear)
    [[ -n $display ]] || {
      usage
      exit 1
    }
    if [[ -n $property ]]; then
      property_is_known "$property" || {
        echo "Unknown display property: $property" >&2
        exit 1
      }
    fi
    exec 9>"$LOCK"
    flock 9
    clear_property "$(resolve_key "$display")" "$property"
    render
    ;;
  *)
    usage
    exit 1
    ;;
esac
