#!/usr/bin/python3
# omarchy:summary=Print OpenCode usage and limits as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect OpenCode v2 session usage and OpenCode Go limits."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sqlite3
import subprocess
import tempfile
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from typing import Any


AGENT_ID = "opencode"
AGENT_NAME = "OpenCode"
USAGE_ENDPOINT = "https://opencode.ai/zen/go/v1/usage"
CACHE_SECONDS = 20
LIMIT_CACHE_SECONDS = 15


def number(value: Any) -> int:
  try:
    return round(float(value or 0))
  except (TypeError, ValueError):
    return 0


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "reasoningTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def add_usage(bucket: dict[str, int], tokens: dict[str, Any]) -> None:
  cache = tokens.get("cache") or {}
  if not isinstance(cache, dict):
    cache = {}
  bucket["inputTokens"] += number(tokens.get("input"))
  bucket["outputTokens"] += number(tokens.get("output"))
  bucket["reasoningTokens"] += number(tokens.get("reasoning"))
  bucket["cacheReadInputTokens"] += number(cache.get("read"))
  bucket["cacheCreationInputTokens"] += number(cache.get("write"))


def total_usage(bucket: dict[str, int]) -> int:
  return sum(bucket.values())


def local_day(value: Any) -> str | None:
  if isinstance(value, (int, float)):
    try:
      timestamp = float(value) / 1000 if float(value) > 10_000_000_000 else float(value)
      return dt.datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d")
    except (TypeError, ValueError, OverflowError, OSError):
      return None
  try:
    parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    if parsed.tzinfo is not None:
      parsed = parsed.astimezone()
    return parsed.strftime("%Y-%m-%d")
  except (TypeError, ValueError, OverflowError):
    return None


import base64


def service_info() -> dict[str, Any] | None:
  service_file = (
    Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser()
    / "opencode"
    / "service.json"
  )
  try:
    data = json.loads(service_file.read_text(encoding="utf-8"))
    if isinstance(data, dict) and data.get("url"):
      return data
  except (OSError, ValueError):
    pass
  return None


def run_api(path: str) -> dict[str, Any]:
  svc = service_info()
  if not svc:
    return {}
  url = str(svc.get("url") or "").rstrip("/") + path
  pwd = str(svc.get("password") or "")
  auth_header = "Basic " + base64.b64encode(f"opencode:{pwd}".encode("utf-8")).decode("utf-8")
  request = urllib.request.Request(
    url,
    headers={
      "Authorization": auth_header,
      "Accept": "application/json",
    },
  )
  try:
    with urllib.request.urlopen(request, timeout=5) as response:
      payload = json.loads(response.read().decode("utf-8"))
      if isinstance(payload, dict):
        return payload
  except (urllib.error.URLError, OSError, ValueError):
    pass
  return {}


def list_api_sessions(since_ms: int = 0) -> list[dict[str, Any]]:
  sessions: list[dict[str, Any]] = []
  cursor = ""
  while True:
    path = "/api/session" + (("?cursor=" + cursor) if cursor else "")
    payload = run_api(path)
    data = payload.get("data") or []
    if not data:
      break
    sessions.extend(item for item in data if isinstance(item, dict))
    cursor = str(((payload.get("cursor") or {}).get("next") or ""))
    if not cursor:
      break
    if since_ms > 0:
      try:
        newest_on_page = max(
          max(number((item.get("time") or {}).get("created")), number((item.get("time") or {}).get("updated")))
          for item in data if isinstance(item, dict)
        )
        if newest_on_page < since_ms:
          break
      except Exception:
        pass
  return sessions


def api_session_usage(session: dict[str, Any], since_ms: int) -> dict[str, Any] | None:
  model = session.get("model") or {}
  if model.get("providerID") != "opencode-go":
    return None
  created = number((session.get("time") or {}).get("created"))
  updated = number((session.get("time") or {}).get("updated"))
  if max(created, updated) < since_ms:
    return None
  model_key = "opencode-go/" + str(model.get("id") or "")
  tokens = session.get("tokens") or {}
  bucket = {
    "inputTokens": number(tokens.get("input")),
    "outputTokens": number(tokens.get("output")),
    "reasoningTokens": number(tokens.get("reasoning")),
    "cacheReadInputTokens": number((tokens.get("cache") or {}).get("read")),
    "cacheCreationInputTokens": number((tokens.get("cache") or {}).get("write")),
  }
  day = local_day(created)
  return {
    "id": session.get("id"),
    "title": session.get("title") or "Untitled session",
    "createdAt": created,
    "updatedAt": updated,
    "directory": (session.get("location") or {}).get("directory", ""),
    "agent": session.get("agent", ""),
    "models": {model_key: bucket},
    "tokens": bucket.copy(),
    "cost": float(session.get("cost") or 0),
    "messageCount": 1,
    "daily": {day: total_usage(bucket)},
    "dailyPrompts": {day: 1},
    "dailyModels": {day: {model_key: bucket.copy()}},
  }


def database_path() -> Path:
  return Path(os.environ.get("XDG_DATA_HOME", "~/.local/share")).expanduser() / "opencode" / "opencode.db"


def session_usage(session: dict[str, Any], messages: list[dict[str, Any]]) -> dict[str, Any] | None:
  # Handles both v1 (message table) and v2 (session_message) shapes:
  # v1: role/providerID/modelID at top level; v2: type already filtered, model nested
  session_id = str(session.get("id") or "")
  result = {
    "id": session_id,
    "title": session.get("title") or "Untitled session",
    "createdAt": session.get("time", {}).get("created") or session.get("createdAt"),
    "updatedAt": session.get("time", {}).get("updated") or session.get("updatedAt"),
    "directory": (session.get("location") or {}).get("directory", "") or session.get("directory", ""),
    "agent": session.get("agent", ""),
    "models": {},
    "tokens": empty_bucket(),
    "cost": 0,
    "messageCount": 0,
    "daily": {},
    "dailyPrompts": {},
    "dailyModels": {},
  }
  for message in messages:
    # v1 has role, v2 is pre-filtered by type='assistant' in SQL
    if message.get("role") is not None and message.get("role") != "assistant":
      continue
    provider = str(message.get("providerID") or (message.get("model") or {}).get("providerID") or "")
    model_id = str(message.get("modelID") or (message.get("model") or {}).get("id") or "")
    if provider != "opencode-go":
      continue
    model_key = "opencode-go/" + model_id
    tokens = message.get("tokens")
    if not isinstance(tokens, dict) or not tokens:
      continue
    message_time = message.get("time") or {}
    if not isinstance(message_time, dict):
      continue
    message_day = local_day(message_time.get("created"))
    if message_day is None:
      continue
    result["messageCount"] += 1
    cache = tokens.get("cache") or {}
    if not isinstance(cache, dict):
      cache = {}
    result["dailyPrompts"][message_day] = result["dailyPrompts"].get(message_day, 0) + 1
    result["daily"][message_day] = result["daily"].get(message_day, 0) + total_usage({
      "inputTokens": number(tokens.get("input")),
      "outputTokens": number(tokens.get("output")),
      "reasoningTokens": number(tokens.get("reasoning")),
      "cacheReadInputTokens": number(cache.get("read")),
      "cacheCreationInputTokens": number(cache.get("write")),
    })
    bucket = result["models"].setdefault(model_key, empty_bucket())
    add_usage(bucket, tokens)
    daily_bucket = result["dailyModels"].setdefault(message_day, {}).setdefault(model_key, empty_bucket())
    add_usage(daily_bucket, tokens)
    add_usage(result["tokens"], tokens)
    try:
      result["cost"] += float(message.get("cost") or 0)
    except (TypeError, ValueError):
      pass

  # Session-level token fields are lifetime totals, so window scans require messages.
  if not result["models"]:
    return None
  return result


def scan_sessions(since_ms: int) -> dict[str, Any]:
  db = database_path()
  if not db.is_file():
    raise RuntimeError(f"OpenCode database not found: {db}")
  sessions: dict[str, dict[str, Any]] = {}
  messages_by_session: dict[str, list[dict[str, Any]]] = {}
  connection = sqlite3.connect(f"file:{db.resolve()}?mode=ro", uri=True, timeout=2)
  try:
    connection.execute("PRAGMA query_only = ON")
    # Retain older sessions only when they have messages in the requested window.
    for row in connection.execute(
      """
      SELECT id,title,time_created,time_updated,directory,agent,model,cost,
             tokens_input,tokens_output,tokens_reasoning,tokens_cache_read,tokens_cache_write
      FROM session
      WHERE time_created >= ?
         OR EXISTS (
           SELECT 1
           FROM message
           WHERE message.session_id = session.id
             AND message.time_created >= ?
         )
      """,
      (since_ms, since_ms),
    ):
      session_id, title, created, updated, directory, agent, model, cost, input_tokens, output_tokens, reasoning, cache_read, cache_write = row
      sessions[session_id] = {
        "id": session_id,
        "title": title or "Untitled session",
        "createdAt": created,
        "updatedAt": updated,
        "directory": directory or "",
        "agent": agent or "",
        "model": model or "",
        "cost": cost or 0,
        "tokens": {
          "input": input_tokens,
          "output": output_tokens,
          "reasoning": reasoning,
          "cache": {"read": cache_read, "write": cache_write},
        },
      }
    for session_id, raw in connection.execute(
      "SELECT session_id,data FROM message WHERE time_created >= ?", (since_ms,)
    ):
      try:
        message = json.loads(raw)
      except (TypeError, ValueError):
        continue
      if isinstance(message, dict):
        messages_by_session.setdefault(session_id, []).append(message)
    # v2 stores sessions/messages in session_v2 / session_message (same DB)
    try:
      tables = {r[0] for r in connection.execute("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('session_v2','session_message')").fetchall()}
      if "session_v2" in tables:
        for row in connection.execute(
          """
          SELECT id,title,time_created,time_updated,directory,agent,model,cost,
                 tokens_input,tokens_output,tokens_reasoning,tokens_cache_read,tokens_cache_write
          FROM session_v2
          WHERE time_created >= ?
             OR EXISTS (
               SELECT 1 FROM session_message
               WHERE session_message.session_id = session_v2.id
                 AND session_message.time_created >= ?
                 AND session_message.type = 'assistant'
             )
          """,
          (since_ms, since_ms),
        ):
          session_id, title, created, updated, directory, agent, model, cost, input_tokens, output_tokens, reasoning, cache_read, cache_write = row
          # Don't overwrite a v1 session with same id (unlikely but keep first)
          if session_id in sessions:
            continue
          sessions[session_id] = {
            "id": session_id,
            "title": title or "Untitled session",
            "createdAt": created,
            "updatedAt": updated,
            "directory": directory or "",
            "agent": agent or "",
            "model": model or "",
            "cost": cost or 0,
            "tokens": {
              "input": input_tokens,
              "output": output_tokens,
              "reasoning": reasoning,
              "cache": {"read": cache_read, "write": cache_write},
            },
          }
      if "session_message" in tables:
        for session_id, raw in connection.execute(
          "SELECT session_id, data FROM session_message WHERE time_created >= ? AND type = 'assistant'", (since_ms,)
        ):
          try:
            message = json.loads(raw)
          except (TypeError, ValueError):
            continue
          if isinstance(message, dict):
            messages_by_session.setdefault(session_id, []).append(message)
    except sqlite3.Error:
      pass
  finally:
    connection.close()

  records: list[dict[str, Any]] = []
  for session_id, session in sessions.items():
    try:
      record = session_usage(session, messages_by_session.get(session_id, []))
      if record is not None:
        records.append(record)
    except Exception:
      continue

  # The running v2 service can have recent sessions in its API before the
  # SQLite writer has checkpointed them. SQLite has granular message history,
  # so live aggregates only supplement sessions that SQLite does not have.
  try:
    api_records = {record["id"]: record for session in list_api_sessions(since_ms)
      if (record := api_session_usage(session, since_ms)) is not None}
    sqlite_ids = {record["id"] for record in records}
    records.extend(record for session_id, record in api_records.items() if session_id not in sqlite_ids)
  except Exception:
    pass

  records.sort(key=lambda item: number(item.get("createdAt")), reverse=True)
  today = dt.datetime.now().strftime("%Y-%m-%d")
  recent_dates = [
    (dt.datetime.now() - dt.timedelta(days=offset)).strftime("%Y-%m-%d")
    for offset in range(6, -1, -1)
  ]
  recent = {date: 0 for date in recent_dates}
  model_usage: dict[str, dict[str, int]] = {}
  today_model_usage: dict[str, dict[str, int]] = {}
  today_sessions = 0
  today_prompts = 0
  today_total = 0
  total_prompts = 0
  active_dates: set[str] = set()
  for record in records:
    total_prompts += record["messageCount"]
    for day, daily_total in record["daily"].items():
      active_dates.add(day)
      if day in recent:
        recent[day] += daily_total
    for day, models in record["dailyModels"].items():
      if day not in recent:
        continue
      for model, bucket in models.items():
        target = model_usage.setdefault(model, empty_bucket())
        for key, value in bucket.items():
          target[key] += value
        if day == today:
          today_target = today_model_usage.setdefault(model, empty_bucket())
          for key, value in bucket.items():
            today_target[key] += value
    if today in record["daily"]:
      today_sessions += 1
      today_prompts += record["dailyPrompts"].get(today, 0)
      today_total += record["daily"][today]

  return {
    "sessions": records,
    "todayPrompts": today_prompts,
    "todaySessions": today_sessions,
    "todayTotalTokens": today_total,
    "todayTokensByModel": {
      model: total_usage(bucket) for model, bucket in today_model_usage.items()
    },
    "recentDays": [{"date": date, "messageCount": recent[date]} for date in recent_dates],
    "modelUsage": model_usage,
    "totalPrompts": total_prompts,
    "totalSessions": len(records),
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "totalCost": sum(float(record["cost"]) for record in records),
    "collectionSince": since_ms,
  }


def collection_since(limits: dict[str, Any], now: dt.datetime | None = None) -> int:
  """Return the oldest active Go limit window start in epoch milliseconds."""
  now = now or dt.datetime.now(dt.timezone.utc)
  starts: list[dt.datetime] = []
  rolling_hours = float(os.environ.get("OPENCODE_ROLLING_WINDOW_HOURS", "5"))
  spans = {"Rolling": dt.timedelta(hours=rolling_hours), "Weekly": dt.timedelta(days=7), "Monthly": dt.timedelta(days=31)}
  for entry in limits.get("limits", []):
    label = str(entry.get("label") or "")
    reset = str(entry.get("resetsAt") or "")
    if label not in spans or not reset:
      continue
    try:
      reset_at = dt.datetime.fromisoformat(reset.replace("Z", "+00:00"))
      if reset_at.tzinfo is None:
        reset_at = reset_at.replace(tzinfo=dt.timezone.utc)
      starts.append(reset_at - spans[label])
    except ValueError:
      continue
  if not starts:
    return round((now - dt.timedelta(days=31)).timestamp() * 1000)
  return round(min(starts).timestamp() * 1000)


def auth_key() -> str:
  key_path = Path(os.environ.get("OPENCODE_AUTH_FILE", "~/.local/share/opencode/auth.json")).expanduser()
  try:
    data = json.loads(key_path.read_text(encoding="utf-8"))
    return str((data.get("opencode-go") or {}).get("key") or "")
  except (OSError, ValueError):
    return ""


def probe_limits() -> dict[str, Any]:
  key = os.environ.get("OPENCODE_API_KEY") or auth_key()
  if not key:
    return {"ok": False, "authenticated": False, "status": "Waiting for OpenCode Go auth", "limits": []}
  request = urllib.request.Request(
    USAGE_ENDPOINT,
    headers={
      "Authorization": "Bearer " + key,
      "Accept": "application/json",
      "User-Agent": "curl/8.0",
    },
  )
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8"))
  except urllib.error.HTTPError as error:
    return {
      "ok": False,
      "authenticated": error.code not in (401, 403),
      "status": "OpenCode Go authentication failed" if error.code in (401, 403) else "OpenCode Go limits unavailable",
      "error": str(error),
      "limits": [],
    }
  except (OSError, ValueError) as error:
    return {"ok": False, "authenticated": True, "status": "OpenCode Go limits unavailable", "error": str(error), "limits": []}

  usage = payload.get("usage") if isinstance(payload, dict) else {}
  limits = []
  for key, label in (("rolling", "Rolling"), ("weekly", "Weekly"), ("monthly", "Monthly")):
    bucket = usage.get(key) if isinstance(usage, dict) else None
    if not isinstance(bucket, dict) or bucket.get("percent") is None:
      continue
    percent = float(bucket["percent"])
    if percent >= 1:
      percent /= 100
    limits.append({
      "label": label,
      "title": label,
      "percent": max(0.0, min(1.0, percent)),
      "resetsAt": str(bucket.get("resetsAt") or ""),
    })
  return {"ok": bool(limits), "authenticated": True, "status": "", "limits": limits}


def empty_stats(since_ms: int) -> dict[str, Any]:
  today = dt.datetime.now().strftime("%Y-%m-%d")
  dates = [
    (dt.datetime.now() - dt.timedelta(days=offset)).strftime("%Y-%m-%d")
    for offset in range(6, -1, -1)
  ]
  return {
    "sessions": [],
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": date, "messageCount": 0} for date in dates],
    "modelUsage": {},
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "totalCost": 0,
    "collectionSince": since_ms,
  }


def cache_path(name: str) -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser() / "opencode-usage-collector"
  root.mkdir(parents=True, exist_ok=True)
  return root / name


def read_cache(path: Path, max_age: float) -> dict[str, Any] | None:
  try:
    if time.time() - path.stat().st_mtime > max_age:
      return None
    return json.loads(path.read_text(encoding="utf-8"))
  except (OSError, ValueError):
    return None


def write_cache(path: Path, value: dict[str, Any]) -> None:
  fd, name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(value, handle, separators=(",", ":"), sort_keys=True)
    Path(name).replace(path)
  except BaseException:
    Path(name).unlink(missing_ok=True)
    raise


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--full", action="store_true", help="Include per-session records in the output")
  args = parser.parse_args()

  limits = None if args.force else read_cache(cache_path("limits.json"), LIMIT_CACHE_SECONDS)
  if limits is None:
    limits = probe_limits()
    write_cache(cache_path("limits.json"), limits)
  since_ms = collection_since(limits)
  if not limits.get("authenticated", False):
    stats = empty_stats(since_ms)
  else:
    stats = None if args.force else read_cache(cache_path("sessions.json"), 900 if args.limits_only else CACHE_SECONDS)
    if stats is not None and stats.get("collectionSince") != since_ms:
      stats = None
    if stats is None:
      stats = scan_sessions(since_ms)
      write_cache(cache_path("sessions.json"), stats)
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": stats["totalSessions"] > 0 or bool(limits["limits"]),
    "hasLocalStats": bool(limits.get("authenticated", False)),
    "usageStatusText": limits["status"],
    "authHelpText": "Set OPENCODE_API_KEY or sign in to OpenCode Go." if not limits["ok"] else "",
    "limits": limits["limits"],
  }
  record.update(stats)
  if not args.full:
    record.pop("sessions", None)
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
