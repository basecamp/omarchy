  esac
}

show_update_config_menu() {
  case $(menu "Reset config" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n󱣴  Plymouth\n  Swayosd\n󰌧  Walker\n󰍜  Waybar") in
  *Hyprland*) present_terminal omarchy-refresh-hyprland ;;
  *Hypridle*) present_terminal omarchy-refresh-hypridle ;;
  *Hyprlock*) present_terminal omarchy-refresh-hyprlock ;;
  *Hyprsunset*) present_terminal omarchy-refresh-hyprsunset ;;
  *Plymouth*) present_terminal omarchy-refresh-plymouth ;;
  *Swayosd*) present_terminal omarchy-refresh-swayosd ;;
  *Walker*) present_terminal omarchy-refresh-walker ;;
  *Waybar*) present_terminal omarchy-refresh-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth") in
  *Audio*) present_terminal omarchy-restart-pipewire ;;
  *Wi-Fi*) present_terminal omarchy-restart-wifi ;;
  *Bluetooth*) present_terminal omarchy-restart-bluetooth ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_terminal omarchy-drive-set-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  omarchy-launch-about
}

show_system_menu() {
  local options="  Lock Terminal\n󱄄  Dead Signal"
  [ -f ~/.local/state/omarchy/toggles/suspend-on ] && options="$options\n󰒲  Suspend"
  omarchy-hibernation-available && options="$options\n󰤁  Hibernate"
  options="$options\n󰜉  Reboot\n󰐥  Kill Power"

  case $(menu "Power" "$options") in
  *Lock*) omarchy-lock-screen ;;
  *"Dead Signal"*) omarchy-launch-screensaver force ;;
  *Suspend*) systemctl suspend ;;
  *Hibernate*) systemctl hibernate ;;
  *Reboot*) omarchy-cmd-reboot ;;
  *Kill*) omarchy-cmd-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_arsenal_category_menu() {
  local group="$1"
  local display_name="$2"

  # Get installed tools from this group
  local tools
  tools=$(pacman -Qg "$group" 2>/dev/null | awk '{print $2}' | sort)

  if [[ -z "$tools" ]]; then
    case $(menu "$display_name" "  Install $display_name tools") in
    *Install*) present_terminal "sudo pacman -S --needed --noconfirm --overwrite '*' $group" ;;
    *) show_arsenal_menu ;;
    esac
    return
  fi

  local choice
  choice=$(echo "$tools" | rofi -dmenu -p "$display_name //" -i 2>/dev/null)

  if [[ -n "$choice" ]]; then
    terminal "$choice"
  else
    show_arsenal_menu
  fi
}

show_arsenal_menu() {
  local options="  Recon\n  Scanner\n  Exploitation\n  Web App\n  Cracker\n  Wireless\n  Sniffer\n  Proxy\n  Forensic\n  Social\n  Fuzzer\n──────────\n  Install ALL Tools (~2800)"

  case $(menu "Arsenal" "$options") in
  *Recon*) show_arsenal_category_menu blackarch-recon "Recon" ;;
  *Scanner*) show_arsenal_category_menu blackarch-scanner "Scanner" ;;
  *Exploitation*) show_arsenal_category_menu blackarch-exploitation "Exploitation" ;;
  *"Web App"*) show_arsenal_category_menu blackarch-webapp "Web App" ;;
  *Cracker*) show_arsenal_category_menu blackarch-cracker "Cracker" ;;
  *Wireless*) show_arsenal_category_menu blackarch-wireless "Wireless" ;;
  *Sniffer*) show_arsenal_category_menu blackarch-sniffer "Sniffer" ;;
  *Proxy*) show_arsenal_category_menu blackarch-proxy "Proxy" ;;
  *Forensic*) show_arsenal_category_menu blackarch-forensic "Forensic" ;;
  *Social*) show_arsenal_category_menu blackarch-social "Social" ;;
  *Fuzzer*) show_arsenal_category_menu blackarch-fuzzer "Fuzzer" ;;
  *"Install ALL"*) present_terminal omarchy-install-blackarch ;;
  *) show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "DedSec" "󰀻  Launch\n󰧑  Intel\n󱓞  Exploit\n  Arsenal\n  Skin\n  Config\n󰉉  Deploy\n󰭌  Purge\n  Patch\n  Ident\n  Shutdown")"
}

go_to_menu() {
  case "${1,,}" in
  *launch*) rofi -show drun -show-icons -theme dedsec-drun ;;
  *intel*) show_learn_menu ;;
  *exploit*) show_trigger_menu ;;
  *arsenal*) show_arsenal_menu ;;
  *share*) show_share_menu ;;
  *capture*) show_capture_menu ;;
  *skin*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *config*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *deploy*) show_install_menu ;;
  *purge*) show_remove_menu ;;
  *patch*) show_update_menu ;;
  *ident*) show_about ;;
  *system*|*shutdown*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/omarchy/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
