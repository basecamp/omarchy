#!/bin/bash

# omarchy:summary=Toggle passwordless sudo for the current user.
# omarchy:args=[MINUTES]
# omarchy:requires-sudo=true

set -euo pipefail

# $USER can be spoofed in the environment; the real login name cannot.
REAL_USER=$(id -un)
NOPASSWD_FILE="/etc/sudoers.d/99-omarchy-nopasswd-${REAL_USER}"
TIMER_NAME="omarchy-nopasswd-expire-${REAL_USER}"
CLEANUP_UNIT="omarchy-nopasswd-boot-cleanup.service"
CLEANUP_PATH="/etc/systemd/system/${CLEANUP_UNIT}"
MAX_MINUTES=120

MINUTES=${1:-15}
if [[ ${1:-} && ! $1 =~ ^[0-9]+$ ]]; then
  echo "Usage: omarchy-sudo-passwordless [MINUTES]" >&2
  exit 1
fi

if (( MINUTES < 1 || MINUTES > MAX_MINUTES )); then
  echo "Minutes must be between 1 and ${MAX_MINUTES}." >&2
  exit 1
fi

ensure_boot_cleanup() {
  # The expire timer is transient: a reboot drops it while leaving the sudoers
  # drop-in behind, so passwordless root survives until someone toggles this
  # command again. A oneshot on every boot deletes every Omarchy nopasswd
  # drop-in before multi-user starts answering logins.
  sudo tee "$CLEANUP_PATH" >/dev/null <<'UNIT'
[Unit]
Description=Remove Omarchy temporary passwordless sudo grants after reboot
DefaultDependencies=no
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'rm -f /etc/sudoers.d/99-omarchy-nopasswd-*'

[Install]
WantedBy=multi-user.target
UNIT
  sudo systemctl daemon-reload
  sudo systemctl enable "$CLEANUP_UNIT" >/dev/null
}

schedule_expire() {
  local minutes=$1
  # Fail closed: if the timer never arms, tear the grant back down immediately
  # rather than leaving permanent passwordless root.
  if ! sudo systemd-run --on-active="${minutes}m" --timer-property=AccuracySec=1s --unit="$TIMER_NAME" \
    rm "$NOPASSWD_FILE"; then
    sudo rm -f "$NOPASSWD_FILE"
    echo "Failed to schedule the expire timer; passwordless sudo was not left enabled." >&2
    return 1
  fi
}

echo "Toggle passwordless sudo..."

# Safety: if the file exists but the timer doesn't (e.g. after reboot, before the
# boot cleanup unit has run), clean up.
if sudo test -f "$NOPASSWD_FILE" && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then
  sudo rm -f "$NOPASSWD_FILE"
fi

# Check for the file directly — sudo -n can stay cached or be granted by other rules
if sudo test -f "$NOPASSWD_FILE"; then
  if [[ ${1:-} ]]; then
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
    schedule_expire "$MINUTES"
    echo "Passwordless sudo timer updated. It will now automatically disable in ${MINUTES} minutes."
  else
    sudo rm -f "$NOPASSWD_FILE"
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
    echo "Passwordless sudo has been DISABLED. Sudo will require a password again."
  fi
else
  echo ""
  echo "⚠️ WARNING: This will allow ANY process running as your user to"
  echo "execute ANY command as root WITHOUT a password for ${MINUTES} minutes."
  echo ""
  echo "This is useful for AI agents that need to run sudo commands,"
  echo "but it significantly weakens the security of your system."
  echo "Anyone or anything with access to your user account gets full root."
  echo ""
  echo "Passwordless sudo will automatically disable after ${MINUTES} minutes,"
  echo "and a reboot clears it even if the timer never fired."
  echo "Run this command again to disable it early."
  echo ""

  if gum confirm "Enable passwordless sudo for ${MINUTES} minutes? This is a significant security risk!"; then
    ensure_boot_cleanup
    # Stage the grant only after the boot cleanup unit is in place.
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$REAL_USER" | sudo tee "$NOPASSWD_FILE" >/dev/null
    sudo chmod 440 "$NOPASSWD_FILE"
    if ! schedule_expire "$MINUTES"; then
      exit 1
    fi

    echo ""
    echo "Passwordless sudo has been ENABLED. It will automatically disable in ${MINUTES} minutes."
  else
    echo "Aborted. No changes made."
  fi
fi
