#!/bin/bash

# omarchy:summary=Remove hibernation setup including swap and boot resume settings
# omarchy:requires-sudo=true

MKINITCPIO_CONF="/etc/mkinitcpio.conf.d/omarchy_resume.conf"
RESUME_DROP_IN="/etc/limine-entry-tool.d/resume.conf"
RTC_ALARM_DROP_IN="/etc/limine-entry-tool.d/rtc-alarm.conf"

hook_present=false
if [[ -f $MKINITCPIO_CONF ]] && grep -q "^HOOKS+=(resume)$" "$MKINITCPIO_CONF"; then
  hook_present=true
fi

dropins_present=false
if [[ -f $RESUME_DROP_IN || -f $RTC_ALARM_DROP_IN ]]; then
  dropins_present=true
fi

if ! $hook_present && ! $dropins_present; then
  echo "Hibernation is not set up"
  exit 0
fi

if ! gum confirm "Remove hibernation setup?"; then
  exit 0
fi

SWAP_SUBVOLUME="/swap"
SWAP_FILE="$SWAP_SUBVOLUME/swapfile"

# Disable swap if active
if swapon --show | grep -q "$SWAP_FILE"; then
  echo "Disabling swap on $SWAP_FILE"
  sudo swapoff "$SWAP_FILE"
fi

# Remove swapfile
if [[ -f $SWAP_FILE ]]; then
  echo "Removing swapfile"
  sudo rm "$SWAP_FILE"
fi

# Remove swap subvolume
if sudo btrfs subvolume show "$SWAP_SUBVOLUME" &>/dev/null; then
  echo "Removing Btrfs subvolume $SWAP_SUBVOLUME"
  sudo btrfs subvolume delete "$SWAP_SUBVOLUME"
fi

# Remove fstab entry
if grep -Fq "$SWAP_FILE" /etc/fstab; then
  echo "Removing swapfile from /etc/fstab"
  sudo cp -a /etc/fstab "/etc/fstab.$(date +%Y%m%d%H%M%S).back"
  sudo sed -i "\|$SWAP_FILE|d" /etc/fstab
  sudo sed -i '/^# Btrfs swapfile for system hibernation$/d' /etc/fstab
fi

# Remove mkinitcpio resume hook
if [[ -f $MKINITCPIO_CONF ]]; then
  echo "Removing resume hook"
  sudo rm -f "$MKINITCPIO_CONF"
fi

# Setup writes these Limine cmdline drop-ins; factory-reset already deletes
# resume.conf when the swapfile is gone because a leftover offset is baked
# into the next UKI. Remove must do the same, and must do it before
# limine-mkinitcpio. rtc-alarm.conf is only written by this wizard.
# Leave /usr/lib/systemd/system-sleep/keyboard-backlight (used for suspend).
echo "Removing resume kernel parameters"
sudo rm -f "$RESUME_DROP_IN" "$RTC_ALARM_DROP_IN"

echo "Regenerating initramfs..."
sudo limine-mkinitcpio

echo "Hibernation removed"
