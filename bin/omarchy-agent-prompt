#!/bin/bash

# omarchy:summary=Launch the default coding agent with a prompt
# omarchy:args=[--inline] [--conversation] <prompt...>
# omarchy:examples=omarchy agent prompt "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

options=()
while [[ ${1:-} == "--inline" || ${1:-} == "--conversation" ]]; do
  options+=("$1")
  shift
done

if (($# == 0)); then
  echo "Usage: omarchy agent prompt [--inline] [--conversation] <prompt...>" >&2
  exit 1
fi

exec omarchy-agent "${options[@]}" --prompt "$*"
