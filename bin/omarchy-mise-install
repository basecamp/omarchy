#!/bin/bash

# omarchy:summary=Install a small mise-backed wrapper for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

mkdir -p "$HOME/.local/bin"

# These tools install and upgrade on first run, so mise's release cooldown would
# hold a new version back for days after it ships. Exported rather than set on
# the install line alone, so resolving the version to execute agrees with the
# one just installed.
#
# `mise use -g` rewrites the whole global config with no lock, so two wrappers
# starting at once drop each other's tools or leave invalid TOML behind.
#
# Fixed lock path, not XDG_RUNTIME_DIR: that is unset under cron, and a lock
# resolving two ways is not a lock.
#
# Staged and moved, so an interrupted run cannot leave the command missing and a
# symlinked alias is replaced rather than written through.
wrapper="$HOME/.local/bin/$command"
staged=$(mktemp "$HOME/.local/bin/.$command.XXXXXX") || exit 1
trap 'rm -f "$staged"' EXIT

cat >"$staged" <<EOF
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
lock="\${XDG_STATE_HOME:-\$HOME/.local/state}/omarchy/mise-use.lock"
mkdir -p "\${lock%/*}"
flock "\$lock" mise use -g --quiet "$package" || exit 1
exec mise x "$package" -- "$bin" "\$@"
EOF
staged_status=$?

# No set -e here, so a truncated write would otherwise be chmod'd and installed.
if (( staged_status != 0 )); then
  echo "omarchy-mise-install: could not write the wrapper for $command" >&2
  exit 1
fi

chmod +x "$staged" && mv -f "$staged" "$wrapper" || exit 1
trap - EXIT
