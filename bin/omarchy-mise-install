#!/bin/bash

# omarchy:summary=Install a mise-backed symlink for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

mkdir -p "$HOME/.local/bin"

# Shell wrappers cannot preserve argv[0] when a tool is invoked under another
# name (Claude Code's built-in grep calls its binary as ugrep). Symlink the
# real binary instead so the kernel passes through the intended invocation name.
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "$package" || exit 1

install_root=$(mise where "$package") || exit 1
target="$install_root/$bin"
if [[ ! -x $target ]]; then
  exit 1
fi

rm -f "$HOME/.local/bin/$command"
ln -sf "$target" "$HOME/.local/bin/$command"
