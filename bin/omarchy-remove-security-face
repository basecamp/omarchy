#!/bin/bash

# omarchy:summary=Remove Howdy face recognition authentication from lock screen
# omarchy:requires-sudo=true

set -e

remove_lock_howdy_pam() {
  if [[ -f /etc/pam.d/omarchy-lock-howdy ]]; then
    echo "Removing lock screen face authentication..."
    sudo rm -f /etc/pam.d/omarchy-lock-howdy
  fi
}

echo -e "\e[32mRemoving face recognition from authentication.\n\e[0m"

remove_lock_howdy_pam

echo "Removing Howdy packages..."
omarchy-pkg-drop howdy

echo -e "\e[32mFace authentication has been completely removed.\e[0m"
