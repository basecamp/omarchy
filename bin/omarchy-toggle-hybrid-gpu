#!/bin/bash

# omarchy:summary=Toggle dedicated vs integrated GPU mode via cardwire (for hybrid gpu laptops, like Asus G14).
# omarchy:requires-sudo=true

if omarchy-cmd-missing cardwire; then
  omarchy-pkg-add cardwire

  sudo systemctl enable --now cardwired
fi

# The old toggle ran supergfxd. When the deprecated daemon is still present,
# retire it so it can't fight cardwire over the dGPU.
if omarchy-pkg-present supergfxctl; then
  sudo systemctl disable --now supergfxd.service 2>/dev/null || true
  sudo rm -f /etc/supergfxd.conf
  sudo rm -rf /usr/lib/systemd/system-sleep/force-igpu
  sudo rm -rf /etc/systemd/system/supergfxd.service.d
fi

gpu_mode=""
for attempt in {1..3}; do
  if gpu_mode=$(timeout --kill-after=1s 3s cardwire get 2>/dev/null | sed -n 's/^Current Mode: //p') && [[ -n $gpu_mode ]]; then
    break
  fi

  gpu_mode=""
  (( attempt < 3 )) && sleep 1
done

if [[ -z $gpu_mode ]]; then
  echo "cardwired is not responding. Try again, or check: systemctl status cardwired" >&2
  exit 1
fi

case "$gpu_mode" in
"Integrated" | "Smart")
  if gum confirm "Enable the dedicated GPU?"; then
    cardwire set hybrid
  fi
  ;;
"Hybrid")
  if gum confirm "Use only the integrated GPU?"; then
    cardwire set integrated
  fi
  ;;
*)
  echo "Hybrid GPU not found or in unknown mode."
  exit 1
  ;;
esac
