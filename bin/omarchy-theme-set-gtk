#!/bin/bash

# omarchy:summary=Apply the current theme colors to GTK apps and Files
# omarchy:hidden=true

# GTK equivalent of omarchy-theme-set-browser: write the generated palette
# where GTK actually reads it, then refresh a running Files window.
# gsettings needs a user DBus session. During ISO installs this command can be
# reached from arch-chroot while applying the initial Omarchy theme; defer until
# the user has a real session instead of emitting dconf warnings.

THEME_DIR=$HOME/.local/state/omarchy/current/theme
SOURCE=$THEME_DIR/gtk.css
COLORS_FILE=$THEME_DIR/colors.toml

nearest_gnome_accent() {
  local hex="${1#\#}"

  awk -v hex="$hex" '
    function hexval(c) {
      return index("0123456789abcdef", tolower(c)) - 1
    }
    function hexpair(s, i) {
      return hexval(substr(s, i, 1)) * 16 + hexval(substr(s, i + 1, 1))
    }
    BEGIN {
      if (length(hex) < 6) {
        print "blue"
        exit
      }

      r = hexpair(hex, 1) / 255
      g = hexpair(hex, 3) / 255
      b = hexpair(hex, 5) / 255
      mx = r
      if (g > mx) mx = g
      if (b > mx) mx = b
      mn = r
      if (g < mn) mn = g
      if (b < mn) mn = b
      d = mx - mn
      l = (mx + mn) / 2

      if (d == 0) {
        print "slate"
        exit
      }

      denom = 1 - (2 * l - 1)
      if (denom < 0) denom = -denom
      s = (denom == 0) ? 0 : d / denom
      if (s < 0.18) {
        print "slate"
        exit
      }

      if (mx == r) h = (g - b) / d
      else if (mx == g) h = (b - r) / d + 2
      else h = (r - g) / d + 4
      h = h * 60
      if (h < 0) h += 360

      if (h < 20 || h >= 340) print "red"
      else if (h < 45) print "orange"
      else if (h < 70) print "yellow"
      else if (h < 155) print "green"
      else if (h < 185) print "teal"
      else if (h < 250) print "blue"
      else if (h < 290) print "purple"
      else print "pink"
    }
  '
}

install_gtk_css() {
  local dest_dir dest

  [[ -f $SOURCE ]] || return 1

  for dest_dir in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
    mkdir -p "$dest_dir"
    dest="$dest_dir/gtk.css"
    if [[ -f $dest ]] && ! grep -q "Generated by Omarchy" "$dest" 2>/dev/null; then
      cp -n "$dest" "$dest.pre-omarchy" 2>/dev/null || true
    fi
    cp "$SOURCE" "$dest"
  done
}

set_gnome_accent() {
  local accent_hex accent_name

  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] || return 0
  [[ -f $COLORS_FILE ]] || return 0

  accent_hex=$(omarchy-theme-color --file "$COLORS_FILE" accent 2>/dev/null) || return 0
  [[ $accent_hex == \#* ]] || return 0

  accent_name=$(nearest_gnome_accent "$accent_hex") || return 0
  gsettings set org.gnome.desktop.interface accent-color "$accent_name" >/dev/null 2>&1 || true
}

files_window_open() {
  # Nautilus often stays resident with no windows. Only treat Files as open
  # when Hyprland actually has a mapped Nautilus window.
  hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.gnome.Nautilus" and .mapped == true)' >/dev/null 2>&1
}

refresh_running_files() {
  local i

  files_window_open || return 0

  # GTK has no Chromium-style --refresh-platform-policy. Nautilus reads
  # gtk.css at start, so quit and reopen an already-visible window.
  nautilus --quit >/dev/null 2>&1 || true

  for i in $(seq 1 25); do
    pgrep -x nautilus >/dev/null || break
    sleep 0.05
  done

  if pgrep -x nautilus >/dev/null; then
    pkill -x nautilus >/dev/null 2>&1 || true
    sleep 0.2
  fi

  sleep 0.2
  omarchy-launch-nautilus >/dev/null 2>&1 &
}

install_gtk_css || exit 0
set_gnome_accent
refresh_running_files
