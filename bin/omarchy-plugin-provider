#!/bin/bash

# omarchy:summary=Inspect or administer trusted plugin capability providers
# omarchy:group=plugin
# omarchy:args=inspect | install <registration> [--dry-run] | upgrade <registration> --reviewed [--dry-run] | remove <service-id> [--dry-run]
# omarchy:examples=omarchy plugin provider inspect | omarchy plugin provider install ./my-harness.provider --dry-run
# omarchy:requires-sudo=true

set -euo pipefail

if [[ ${1:-} == -h || ${1:-} == --help || $# == 0 ]]; then
  cat <<'USAGE'
Usage:
  omarchy plugin provider inspect
  omarchy plugin provider install <registration> [--dry-run]
  omarchy plugin provider upgrade <registration> --reviewed [--dry-run]
  omarchy plugin provider remove <service-id> [--dry-run]

Provider registrations and capability definitions are administrator-owned.
Every command reconstructs exact plugin dependents from the persisted grant and
revision stores. Plugins cannot register providers, create permissions, or
supply dependency claims. Upgrade requires explicit re-review and is blocked
while any active, candidate, or rollback revision pins the old adapter.
USAGE
  exit 0
fi

if [[ -t 0 && -t 1 ]]; then
  exec sudo -- omarchy-plugin-provider-admin "$@"
else
  exec pkexec omarchy-plugin-provider-admin "$@"
fi
