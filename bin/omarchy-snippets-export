#!/bin/bash

# omarchy:summary=Export snippets to a local JSON file
# omarchy:args=<path>
# omarchy:examples=omarchy snippets export ~/Documents/snippets.json

set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/omarchy-snippets-lib"

path=${1:-}
[[ -n $path ]] || snippets_fail "Could not export snippets."

store=$(snippets_load)

jq --arg version "$SNIPPETS_VERSION" \
  '{version: ($version | tonumber), snippets: [.snippets[] | {name, content}]}' \
  <<<"$store" >"$path"
