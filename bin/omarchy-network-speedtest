#!/bin/bash

# omarchy:summary=Measure live internet speed for one direction
# omarchy:group=network
# omarchy:args=[down|up]

set -e

direction="${1:-}"
probe=1.1.1.1
parallel=8
url_count=3
worker_lifetime=${OMARCHY_SPEEDTEST_WORKER_LIFETIME:-30}
request_timeout=${OMARCHY_SPEEDTEST_REQUEST_TIMEOUT:-5}

case "$direction" in
  down | up)
    ;;
  *)
    echo "Usage: omarchy-network-speedtest [down|up]" >&2
    exit 2
    ;;
esac

validate_bounded_positive_integer() {
  local setting_name="$1"
  local setting_value="$2"
  local maximum="$3"

  if [[ $setting_value =~ ^[1-9][0-9]?$ ]] && (( 10#$setting_value <= maximum )); then
    return 0
  fi

  echo "$setting_name must be an integer between 1 and $maximum" >&2
  return 1
}

validate_bounded_positive_integer "OMARCHY_SPEEDTEST_WORKER_LIFETIME" "$worker_lifetime" 30 || exit 2
validate_bounded_positive_integer "OMARCHY_SPEEDTEST_REQUEST_TIMEOUT" "$request_timeout" 5 || exit 2

format_mbps() {
  awk -v value="$1" 'BEGIN {
    if (value <= 0) print "0.0"
    else if (value < 10) printf "%.1f\n", value
    else printf "%.0f\n", value
  }'
}

iface=$(ip route get "$probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')

if [[ -z $iface || ! -r /sys/class/net/$iface/statistics/rx_bytes || ! -r /sys/class/net/$iface/statistics/tx_bytes ]]; then
  echo "No active network interface" >&2
  exit 1
fi

if ! omarchy-cmd-present curl; then
  echo "curl is required" >&2
  exit 1
fi

fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
fast_api_url="https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count"

fast_urls=$(curl -fsS "$fast_api_url" 2>/dev/null | jq -r '.targets[]?.url // empty')

if [[ -z $fast_urls ]]; then
  echo "Failed to fetch speed test endpoints" >&2
  exit 1
fi

traffic_pids=()

cleanup() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
  done
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    wait "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT

# Round-robin across the returned URLs so we spread load across Netflix OCA nodes.
# Cleanup only runs when the EXIT trap does, so a SIGKILL, a compositor crash,
# or session teardown reparents these workers and leaves them saturating the
# link. Each worker therefore watches the main shell and expires on its own.
traffic_worker() {
  local urls=("$@")
  local url_count=${#urls[@]}
  local idx=$RANDOM
  local deadline=$((SECONDS + worker_lifetime))
  local url status

  while (( SECONDS < deadline )) && kill -0 $$ 2>/dev/null; do
    url=${urls[$((idx % url_count))]}
    status=0
    if [[ $direction == "down" ]]; then
      curl -fsS --max-time "$request_timeout" -o /dev/null "$url" 2>/dev/null || status=$?
    else
      dd if=/dev/zero bs=1M count=64 2>/dev/null | curl -fsS --max-time "$request_timeout" -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || status=$?
    fi

    # 28 is the --max-time cutoff, which is the normal end of a request on any
    # link slow enough that a transfer outlasts the timeout. Treating it as a
    # failure would retire every worker on the first request and end the test
    # seconds in, so only a genuine curl error stops the loop.
    (( status == 0 || status == 28 )) || return
    idx=$((idx + 1))
  done
}

for (( i = 0; i < parallel; i++ )); do
  traffic_worker $fast_urls &
  traffic_pids+=("$!")
done

rx_before=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
tx_before=$(cat "/sys/class/net/$iface/statistics/tx_bytes")

any_alive() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    if kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

while any_alive; do
  sleep 1
  rx_after=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
  tx_after=$(cat "/sys/class/net/$iface/statistics/tx_bytes")

  if [[ $direction == "down" ]]; then
    rate=$(awk -v before="$rx_before" -v after="$rx_after" 'BEGIN {
      if (after < before) print 0
      else print (after - before) * 8 / 1000000
    }')
  else
    rate=$(awk -v before="$tx_before" -v after="$tx_after" 'BEGIN {
      if (after < before) print 0
      else print (after - before) * 8 / 1000000
    }')
  fi

  format_mbps "$rate"
  rx_before=$rx_after
  tx_before=$tx_after
done

wait 2>/dev/null || true
