#!/bin/bash

# omarchy:summary=Remove NetBird and its bar plugin.
# omarchy:requires-sudo=true

sudo netbird down 2>/dev/null || true

# Stop the daemon while its unit still exists. `netbird service uninstall` takes
# the unit file away without stopping the process, which leaves a daemon running
# against a deleted binary — still holding the socket, and still answering
# omarchy-installed-service-netbird, so the widget comes back on the next
# `omarchy bar defaults`.
sudo systemctl disable --now netbird.service 2>/dev/null || true

# NetBird wrote /etc/systemd/system/netbird.service itself, so the unit is not
# package-owned and dropping the package would leave it behind.
sudo netbird service uninstall 2>/dev/null || true
omarchy-plugin-disable omarchy.netbird
omarchy-webapp-remove "NetBird" 2>/dev/null || true
# Building netbird from source leaves a netbird-debug package behind, since Arch
# ships makepkg with `debug` in OPTIONS. pkg-drop ignores what is not installed,
# so naming it here is free on a machine that never had it.
omarchy-pkg-drop netbird netbird-debug

echo ""
echo "NetBird has been removed."
