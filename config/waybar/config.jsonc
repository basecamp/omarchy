{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 28,

  "modules-left": [
    "custom/dedsec",
    "custom/tag-open",
    "hyprland/workspaces",
    "custom/tag-close",
    "custom/divider",
    "hyprland/window"
  ],

  "modules-center": [
    "custom/screenrecording-indicator",
    "custom/voxtype",
    "custom/update"
  ],

  "modules-right": [
    "network",
    "custom/divider2",
    "pulseaudio",
    "cpu",
    "memory",
    "custom/divider3",
    "battery",
    "custom/divider4",
    "clock",
    "group/tray-expander"
  ],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "hyprland/window": {
    "format": "// {class}",
    "max-length": 40,
    "rewrite": {
      "": "// IDLE"
    }
  },

  "custom/dedsec": {
    "format": "DSec",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "DedSec // SYSTEM CONTROL\n\nSuper + Alt + Space"
  },

  "custom/tag-open": {
    "format": "[",
    "tooltip": false
  },

  "custom/tag-close": {
    "format": "]",
    "tooltip": false
  },

  "custom/divider": {
    "format": "│",
    "tooltip": false
  },

  "custom/divider2": {
    "format": "│",
    "tooltip": false
  },

  "custom/divider3": {
    "format": "│",
    "tooltip": false
  },

  "custom/divider4": {
    "format": "│",
    "tooltip": false
  },

  "custom/update": {
    "format": "PATCH",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "// SYSTEM PATCH AVAILABLE",
    "signal": 7,
    "interval": 21600
  },

  "cpu": {
    "interval": 3,
    "format": "CPU:{usage}%",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "tooltip-format": "PROC: {usage}% // {avg_frequency}GHz"
  },

  "memory": {
    "interval": 5,
    "format": "MEM:{percentage}%",
    "tooltip-format": "RAM: {used:0.1f}G/{total:0.1f}G\nSWAP: {swapUsed:0.1f}G/{swapTotal:0.1f}G"
  },

  "clock": {
    "interval": 1,
    "format": "{:L%H:%M:%S}",
    "format-alt": "{:L%Y.%m.%d // %A}",
    "tooltip": false,
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "NET:{essid}",
    "format-ethernet": "NET:ETH",
    "format-disconnected": "NET:DOWN",
    "tooltip-format-wifi": "SIGNAL: {essid} // {signalStrength}%\n{frequency}GHz // {ifname}\nDOWN: {bandwidthDownBytes} // UP: {bandwidthUpBytes}",
    "tooltip-format-ethernet": "ETH // {ifname}\nDOWN: {bandwidthDownBytes} // UP: {bandwidthUpBytes}",
    "tooltip-format-disconnected": "// NO LINK",
    "interval": 3,
    "max-length": 18,
    "on-click": "omarchy-launch-wifi"
  },

  "battery": {
    "format": "PWR:{capacity}%",
    "format-charging": "CHG:{capacity}%",
    "format-plugged": "AC:CONNECTED",
    "format-full": "PWR:FULL",
    "tooltip-format": "{timeTo}\n{power:.1f}W",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "bluetooth": {
    "format": "",
    "format-off": "",
    "format-disabled": "",
    "format-connected": "BT:{num_connections}",
    "format-no-controller": "",
    "tooltip-format": "BT: {num_connections} LINKED",
    "on-click": "omarchy-launch-bluetooth"
  },

  "pulseaudio": {
    "format": "VOL:{volume}%",
    "on-click": "omarchy-launch-audio",
    "on-click-right": "omarchy-cmd-audio-pick",
    "on-click-middle": "pamixer -t",
    "tooltip-format": "VOL: {volume}% // {desc}",
    "scroll-step": 5,
    "format-muted": "VOL:MUTE",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    }
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },

  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },

  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "REC",
      "transcribing": "..."
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model"
  },

  "tray": {
    "icon-size": 12,
    "spacing": 14
  }
}
