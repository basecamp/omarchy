{
  "schemaVersion": 1,
  "id": "omarchy.news",
  "name": "Omarchy News",
  "version": "1.0.0",
  "author": "Omarchy",
  "license": "MIT",
  "description": "Read Omarchy announcements and optional curated publisher feeds without leaving the desktop.",
  "kinds": [
    "panel",
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Panel.qml",
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "News",
    "description": "Follow Omarchy announcements and optional curated publisher feeds.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMin": 15,
      "itemLimit": 10,
      "publisherFeeds": "Omarchy only"
    },
    "schema": [
      {
        "key": "refreshIntervalMin",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "itemLimit",
        "type": "integer",
        "label": "Headlines shown",
        "min": 5,
        "max": 20,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "publisherFeeds",
        "type": "enum",
        "label": "News sources",
        "options": [
          "Omarchy only",
          "Omarchy + BBC News"
        ],
        "defaultValue": "Omarchy only",
        "description": "Add the curated BBC News RSS feed alongside official Omarchy announcements."
      }
    ]
  }
}
