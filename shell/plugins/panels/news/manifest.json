{
  "schemaVersion": 1,
  "id": "omarchy.news",
  "name": "Omarchy News",
  "version": "1.0.0",
  "author": "Omarchy",
  "license": "MIT",
  "description": "Read Omarchy announcements, selected publisher feeds and custom RSS without leaving the desktop.",
  "kinds": [
    "panel",
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Panel.qml",
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "News",
    "description": "Follow Omarchy announcements and the RSS sources you choose.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMin": 15,
      "itemLimit": 10
    },
    "schema": [
      {
        "key": "refreshIntervalMin",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "itemLimit",
        "type": "integer",
        "label": "Headlines shown",
        "min": 5,
        "max": 20,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "enabledFeeds",
        "type": "multiselect",
        "label": "Additional feeds",
        "noSelectionText": "Omarchy only",
        "placeholderText": "Search feeds...",
        "emptyText": "No feeds",
        "options": [
          { "value": "hacker-news", "label": "Hacker News", "description": "Developer and startup news" },
          { "value": "ars-technica", "label": "Ars Technica", "description": "Deep technology, science and security" },
          { "value": "techcrunch", "label": "TechCrunch", "description": "Startups, business and AI" },
          { "value": "the-verge", "label": "The Verge", "description": "Mainstream technology and platforms" },
          { "value": "wired", "label": "WIRED", "description": "Technology, science, security and culture" },
          { "value": "phoronix", "label": "Phoronix", "description": "Linux kernel, hardware and performance" },
          { "value": "its-foss", "label": "It's FOSS", "description": "Accessible Linux and open-source coverage" },
          { "value": "openai-news", "label": "OpenAI News", "description": "Official OpenAI product and research news" },
          { "value": "hugging-face", "label": "Hugging Face", "description": "Open models, tooling and AI research" },
          { "value": "mit-ai", "label": "MIT News: AI", "description": "Academic AI research and developments" }
        ],
        "defaultValue": [],
        "description": "Choose any combination. Omarchy remains pinned."
      },
      {
        "key": "customFeeds",
        "type": "string",
        "label": "Custom RSS feeds",
        "defaultValue": "",
        "description": "Semicolon-separated HTTPS feeds. Use Name|URL to set a label; URL-only entries use the host name."
      }
    ]
  }
}
