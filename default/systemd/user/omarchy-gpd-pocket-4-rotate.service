[Unit]
Description=Automatic screen rotation (GPD Pocket 4 accelerometer via iio-sensor-proxy)
# Only the internal panel of a GPD Pocket 4 needs this; other hardware stays
# inert even though the unit ships (and is enabled) everywhere.
ConditionPathIsDirectory=/sys/bus/iio/devices
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Skip cleanly instead of restart-looping on machines without the hardware.
ExecCondition=/usr/bin/omarchy-hw-gpd-pocket-4
ExecStart=/usr/bin/omarchy-hw-gpd-pocket-4-rotate
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
