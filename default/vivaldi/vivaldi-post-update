#!/bin/bash

set -eu

VIVALDI_UI=/opt/vivaldi/resources/vivaldi

[[ -d $VIVALDI_UI ]] || exit 0
[[ -f $VIVALDI_UI/window.html ]] || exit 0

cd "$VIVALDI_UI"

JS="style/omarchy.js"

sudo mkdir -p style
sudo cp "$OMARCHY_PATH/default/vivaldi/omarchy-theme-loader.js" "$JS"
sudo sed -i \
  -e "/script.*omarchy/d" -e "s|</body>|  <script src=\"$JS\"></script>\n&|" \
  -e "/omarchy-theme/d"   -e "s|</head>|  <style id=\"omarchy-theme\"></style>\n&|" window.html

# Replace the pre-JSON CSV channel left by older installs.
sudo rm -f style/omarchy.csv
sudo touch style/omarchy.json
# Shared system-wide for now; world-writable so any user's refresh can update
# it. A true per-user channel is out of scope while Omarchy targets a single
# user.
sudo chmod 666 style/omarchy.json

omarchy-theme-set-browser
