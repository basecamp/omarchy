{
  "manifest_version": 3,
  "name": "Omarchy Browser Actions",
  "version": "1.6",
  "description": "Copy the current URL or subscribe to its feed from Omarchy",
  "action": { "default_title": "Copy URL" },
  "key": "",
  "permissions": ["activeTab", "nativeMessaging"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "commands": {
    "copy-url": {
      "suggested_key": {"default": "Alt+Shift+L"},
      "description": "Copy URL"
    },
    "subscribe-feed": {
      "suggested_key": {"default": "Alt+Shift+R"},
      "description": "Subscribe to this page's feed"
    }
  },
  "background": {"service_worker": "background-5.js"}
}
