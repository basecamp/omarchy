{
  "manifest_version": 3,
  "name": "YouTube Tile Mode",
  "version": "1.0",
  "key": "",
  "description": "Fill the tile with the video instead of taking over the monitor, this extension is installed by Omarchy",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "tile.css",
        "grid.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
