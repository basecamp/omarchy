    "terminal.ansiWhite": "#94F0E0",
    "terminal.ansiBrightBlack": "#1E3044",
    "terminal.ansiBrightRed": "#FF6B99",
    "terminal.ansiBrightGreen": "#69FF97",
    "terminal.ansiBrightYellow": "#E0FF66",
    "terminal.ansiBrightBlue": "#67EEFF",
    "terminal.ansiBrightMagenta": "#C084FC",
    "terminal.ansiBrightCyan": "#7DFCF3",
    "terminal.ansiBrightWhite": "#C8FFF4",
    "terminal.background": "#050A0E",
    "terminal.foreground": "#B0F4E6",
