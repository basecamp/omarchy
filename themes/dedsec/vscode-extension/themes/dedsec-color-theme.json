    "statusBar.debuggingForeground": "#050A0E",
    "statusBar.noFolderBackground": "#0A1018",
    "statusBarItem.remoteBackground": "#A855F7",
    "statusBarItem.remoteForeground": "#050A0E",

    "tab.activeBackground": "#050A0E",
    "tab.activeForeground": "#00FF41",
    "tab.inactiveBackground": "#0A1018",
