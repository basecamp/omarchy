    "gitDecoration.ignoredResourceForeground": "#1E3044",

    "editorError.foreground": "#FF2D6F",
    "editorWarning.foreground": "#BFFF00",
    "editorInfo.foreground": "#00E5FF",

    "minimap.selectionHighlight": "#00FF4144",
