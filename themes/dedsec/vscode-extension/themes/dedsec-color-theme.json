    "notification.background": "#0A1018",
    "notification.foreground": "#B0F4E6",
    "notificationLink.foreground": "#00E5FF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#1E3044",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#00FF41"
      }
    },
    {
      "name": "Numbers, Constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#BFFF00"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "name": "Control flow",
      "scope": ["keyword.control", "keyword.operator.logical"],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator"],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "Functions, Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#00E5FF"
      }
    },
    {
      "name": "Classes, Types",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#E0FF66"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#B0F4E6"
      }
    },
    {
      "name": "Variable - Special (this, self)",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": {
        "foreground": "#94F0E0"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#BFFF00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Properties",
      "scope": ["support.type.property-name.css"],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "CSS Values",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#00FF41"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#00FF41",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#E0FF66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#00E5FF"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#FF6B99",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Invalid / Illegal",
      "scope": ["invalid.illegal"],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "name": "JSON property names",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#00E5FF"
      }
    },
    {
      "name": "YAML keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": {
        "foreground": "#00E5FF"
      }
    },
    {
      "name": "Shell variables",
      "scope": ["variable.other.normal.shell", "variable.other.special.shell"],
      "settings": {
        "foreground": "#FF2D6F"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.definition.string", "punctuation.definition.variable", "punctuation.section"],
      "settings": {
        "foreground": "#94F0E0"
      }
    }
  ]
}
